<?xml version="1.0" encoding="utf-8"?>
<com.ui.baselib.widget.layout.UiLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    app:uiBackgroundColor="@color/color_surface_card"
    app:uiStrokeColor="@color/color_stroke"
    app:uiStrokeSides="bottom"
    app:uiStrokeWidth="@dimen/_1sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_36sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/_9sdp"
        android:paddingEnd="@dimen/_8sdp">

        <com.ui.baselib.widget.view.UiImageView
            android:id="@+id/btnBack"
            android:layout_marginVertical="@dimen/_6sdp"
            style="@style/IconButtonStyle"
            android:contentDescription="@string/scanner_back"
            android:src="@drawable/ic_app_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_6sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/nt_500"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_13sdp"
                tools:text="All files" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/nt_400"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_9sdp"
                android:visibility="gone"
                tools:text="6 images · drag to reorder" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnSort"
            android:layout_width="@dimen/_27sdp"
            android:layout_height="@dimen/_27sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/sort"
            android:padding="@dimen/_5sdp"
            android:src="@drawable/ic_app_sort"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/btnSearch"
            android:layout_width="@dimen/_27sdp"
            android:layout_height="@dimen/_27sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/search_files"
            android:padding="@dimen/_5sdp"
            android:src="@drawable/ic_app_search"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/btnExtra"
            android:layout_width="@dimen/_27sdp"
            android:layout_height="@dimen/_27sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:padding="@dimen/_5sdp"
            android:visibility="gone" />

        <com.ui.baselib.widget.view.UiTextView
            android:id="@+id/btnAction"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_23sdp"
            android:layout_marginStart="@dimen/_3sdp"
            android:layout_marginEnd="@dimen/_3sdp"
            android:fontFamily="@font/nt_600"
            android:gravity="center"
            android:paddingHorizontal="@dimen/_10sdp"
            android:textSize="@dimen/_10sdp"
            android:visibility="gone"
            app:uiBackgroundColor="@color/primary"
            app:uiCornerRadius="@dimen/_12sdp"
            app:uiTextColor="@color/on_primary"
            tools:text="Apply" />
    </LinearLayout>

</com.ui.baselib.widget.layout.UiLinearLayout>
