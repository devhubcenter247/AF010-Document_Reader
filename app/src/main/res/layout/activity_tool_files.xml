<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app"
    android:orientation="vertical"
    tools:context=".ui.main.tools.FilesToolActivity">

    <include
        android:id="@+id/topBar"
        layout="@layout/layout_tool_topbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_12sdp"
            android:paddingBottom="@dimen/_10sdp">

            <include
                android:id="@+id/header"
                layout="@layout/layout_tool_header" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcvFiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_9sdp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="3"
                tools:listitem="@layout/item_tool_file_row" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddFiles"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_37sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:fontFamily="@font/nunito_800"
                android:gravity="center"
                android:text="@string/add_files"
                android:textSize="@dimen/_11sdp"
                android:background="@drawable/stroke_r11sdp_st2dp_checkbox_stroke_dash"
                android:textColor="@color/text_on_selected"
                app:icon="@drawable/ic_app_plus"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/_6sdp"
                app:iconSize="@dimen/_13sdp"
                app:iconTint="@color/text_on_selected"
                app:backgroundTint="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:textAllCaps="false"
                android:letterSpacing="0"
                android:stateListAnimator="@null"
                android:paddingHorizontal="0dp"
                android:paddingVertical="0dp"
                android:elevation="0dp" />

            <TextView
                android:id="@+id/tvNameLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_13sdp"
                android:fontFamily="@font/nunito_700"
                android:text="@string/new_file_name"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_10sdp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_37sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/_11sdp"
                android:paddingEnd="@dimen/_11sdp"
                android:background="@drawable/bg_surface_card_r11sdp"
                android:foreground="@drawable/stroke_r11sdp_st1sdp_stroke"
                android:clipToOutline="true">

                <EditText
                    android:id="@+id/edtName"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="@font/nunito_600"
                    android:hint="@string/new_file_name"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="@dimen/_12sdp" />

                <TextView
                    android:id="@+id/tvExtension"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_6sdp"
                    android:fontFamily="@font/nunito_600"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/_12sdp"
                    tools:text=".pdf" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/action"
        layout="@layout/layout_tool_action" />

</LinearLayout>
