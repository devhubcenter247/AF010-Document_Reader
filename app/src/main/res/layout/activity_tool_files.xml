<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app"
    android:orientation="vertical"
    tools:context=".ui.main.tools.FilesToolActivity">

    <include
        android:id="@+id/topBar"
        layout="@layout/layout_tool_topbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_12sdp"
            android:paddingBottom="@dimen/_10sdp">

            <include
                android:id="@+id/header"
                layout="@layout/layout_tool_header" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcvFiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_9sdp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="3"
                tools:listitem="@layout/item_tool_file_row" />

            <com.ui.baselib.widget.view.UiTextView
                android:id="@+id/btnAddFiles"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_37sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:drawablePadding="@dimen/_6sdp"
                android:fontFamily="@font/nt_600"
                android:gravity="center"
                android:text="@string/add_files"
                android:textSize="@dimen/_11sdp"
                app:drawableStartCompat="@drawable/ic_app_plus"
                app:drawableTint="@color/text_on_selected"
                app:uiCornerRadius="@dimen/_11sdp"
                app:uiDrawableAlign="text"
                app:uiDrawableSize="@dimen/_13sdp"
                app:uiStrokeColor="@color/color_checkbox_stroke"
                app:uiStrokeDashGap="@dimen/_3sdp"
                app:uiStrokeDashed="true"
                app:uiStrokeWidth="2dp"
                app:uiTextColor="@color/text_on_selected" />

            <TextView
                android:id="@+id/tvNameLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_13sdp"
                android:fontFamily="@font/nt_500"
                android:text="@string/new_file_name"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_10sdp" />

            <com.ui.baselib.widget.layout.UiLinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_37sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/_11sdp"
                android:paddingEnd="@dimen/_11sdp"
                app:uiBackgroundColor="@color/color_surface_card"
                app:uiCornerRadius="@dimen/_11sdp"
                app:uiStrokeColor="@color/color_stroke"
                app:uiStrokeWidth="@dimen/_1sdp">

                <EditText
                    android:id="@+id/edtName"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="@font/nt_400"
                    android:hint="@string/new_file_name"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="@dimen/_12sdp" />

                <TextView
                    android:id="@+id/tvExtension"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_6sdp"
                    android:fontFamily="@font/nt_400"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/_12sdp"
                    tools:text=".pdf" />
            </com.ui.baselib.widget.layout.UiLinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/action"
        layout="@layout/layout_tool_action" />

</LinearLayout>
