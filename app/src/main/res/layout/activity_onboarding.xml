<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app"
    android:orientation="vertical"
    tools:context=".ui.onboarding.OnboardingActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_43sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/_18sdp"
        android:paddingEnd="@dimen/_12sdp">

        <LinearLayout
            android:id="@+id/layoutBars"
            android:layout_width="0dp"
            android:layout_height="@dimen/_6sdp"
            android:layout_weight="1"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/btnSkip"
            style="@style/GhostButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_34sdp"
            android:paddingHorizontal="@dimen/_12sdp"
            android:text="@string/fo_skip"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_11sdp" />
    </LinearLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false" />

    <TextView
        android:id="@+id/tvKicker"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_23sdp"
        android:layout_marginHorizontal="@dimen/_22sdp"
        android:background="@drawable/bg_chip_selected"
        android:fontFamily="@font/nunito_700"
        android:gravity="center"
        android:paddingHorizontal="@dimen/_9sdp"
        android:textColor="@color/text_on_selected"
        android:textSize="@dimen/_10sdp"
        tools:text="Open anything" />

    <TextView
        android:id="@+id/tvTitle"
        style="@style/DisplayTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_22sdp"
        android:layout_marginTop="@dimen/_8sdp"
        tools:text="Every document, one cosy home" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_22sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:fontFamily="@font/nunito_500"
        android:lineSpacingMultiplier="1.2"
        android:minLines="3"
        android:textColor="@color/text_tertiary"
        android:textSize="@dimen/_12sdp"
        tools:text="PDF, Word, Excel, PowerPoint, text and photos all open right here." />

    <TextView
        android:id="@+id/btnNext"
        style="@style/PrimaryPillButton"
        android:layout_width="match_parent"
        android:layout_marginHorizontal="@dimen/_18sdp"
        android:layout_marginTop="@dimen/_9sdp"
        android:layout_marginBottom="@dimen/_26sdp"
        android:text="@string/next" />
</LinearLayout>
