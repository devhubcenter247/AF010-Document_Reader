<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app"
    tools:context=".ui.onboarding.OnboardingActivity">

    <!-- ViewPager2 for image slides -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <!-- Top bar Skip button -->


    <!-- Bottom card containing Indicator, Title, Subtitle, and Button -->
    <LinearLayout
        android:id="@+id/layoutBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/_10sdp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.ui.baselib.widget.view.IndicatorView
            android:id="@+id/indicatorView"
            android:layout_width="wrap_content"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_height="@dimen/_7sdp"
            android:layout_marginBottom="@dimen/_10sdp"
            app:uiIndicatorColor="@color/color_stroke"
            app:uiIndicatorCount="4"
            app:uiIndicatorRadius="@dimen/_3sdp"
            app:uiIndicatorSelectedColor="@color/primary"
            app:uiIndicatorSelectedWidthRatio="2.5"
            app:uiIndicatorSpacing="@dimen/_4sdp" />

        <TextView
            android:id="@+id/tvTitle"
            style="@style/TextHeadLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_marginBottom="@dimen/_7sdp"
            android:fontFamily="@font/nt_500"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/_13sdp"
            tools:text="All documents in one app" />

        <TextView
            android:id="@+id/tvSubtitle"
            style="@style/TextSubContent"
            android:layout_width="match_parent"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_13sdp"
            android:fontFamily="@font/nt_400"
            android:lines="2"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_9sdp"
            tools:text="Open PDF, Word, Excel and PowerPoint files fast, even offline." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            style="@style/ButtonAppStyle"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_marginBottom="@dimen/_10sdp"
            android:layout_width="match_parent"
            android:paddingHorizontal="@dimen/_13sdp"
            android:text="@string/next"
            android:background="@drawable/bg_grad_gradient_start_gradient_end_270_r10sdp"
            android:elevation="@dimen/_5sdp"
            android:outlineSpotShadowColor="@color/primary_30"
            android:outlineAmbientShadowColor="@color/primary_20"
            android:textColor="@color/white"
            app:icon="@drawable/ic_app_arrowr"
            app:iconGravity="textEnd"
            app:iconPadding="@dimen/_7sdp"
            app:iconSize="@dimen/_17sdp"
            app:iconTint="@color/white"
            app:backgroundTint="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:textAllCaps="false"
            android:letterSpacing="0"
            android:stateListAnimator="@null"
            android:paddingVertical="0dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
