<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="@dimen/_74sdp"
    android:layout_weight="1"
    android:background="@drawable/bg_quick_tile"
    android:elevation="@dimen/_3sdp"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center"
    android:orientation="vertical"
    android:outlineAmbientShadowColor="@color/color_shadow"
    android:outlineSpotShadowColor="@color/color_shadow">

    <ImageView
        android:id="@+id/ivIcon"
        android:layout_width="@dimen/_32sdp"
        android:layout_height="@dimen/_32sdp"
        android:importantForAccessibility="no"
        android:padding="@dimen/_8sdp"
        tools:background="@drawable/bg_tool_glyph"
        tools:src="@drawable/ic_fo_scan" />

    <TextView
        android:id="@+id/tvLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6sdp"
        android:fontFamily="@font/nunito_700"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/_11sdp"
        tools:text="Scan" />
</LinearLayout>
