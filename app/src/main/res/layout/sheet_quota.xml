<?xml version="1.0" encoding="utf-8"?>
<com.ui.baselib.widget.layout.UiLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/BottomSheetAppStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/_10sdp"
    tools:context=".ui.main.premium.QuotaBottomSheet">

    <com.ui.baselib.widget.layout.UiView
        android:layout_width="@dimen/_31sdp"
        android:layout_height="@dimen/_4sdp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/_8sdp"
        app:uiBackgroundColor="@color/color_checkbox_stroke"
        app:uiCornerRadius="@dimen/_3sdp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_15sdp"
        android:paddingTop="@dimen/_13sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivTool"
                android:layout_width="@dimen/_35sdp"
                android:layout_height="@dimen/_35sdp"
                android:contentDescription="@null"
                tools:src="@drawable/ic_app_tool_compress_pdf" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_11sdp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nt_600"
                    android:lineSpacingMultiplier="1.05"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/_12sdp"
                    tools:text="You’ve used your free Compress uses today" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:fontFamily="@font/nt_400"
                    android:text="@string/quota_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/_9sdp" />
            </LinearLayout>
        </LinearLayout>

        <com.ui.baselib.widget.layout.UiLinearLayout
            android:id="@+id/btnTrial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_13sdp"
            android:orientation="vertical"
            android:padding="@dimen/_13sdp"
            app:uiBackgroundGradientEnabled="true"
            app:uiBackgroundGradientEnd="@color/gradient_end"
            app:uiBackgroundGradientOrientation="tl_br"
            app:uiBackgroundGradientStart="@color/gradient_start"
            app:uiCornerRadius="@dimen/_14sdp">

            <com.ui.baselib.widget.view.UiTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/_6sdp"
                android:fontFamily="@font/nt_600"
                android:text="@string/quota_try_premium"
                android:textSize="@dimen/_11sdp"
                app:drawableStartCompat="@drawable/ic_app_crown"
                app:drawableTint="@color/on_primary"
                app:uiDrawableSize="@dimen/_14sdp"
                app:uiTextColor="@color/on_primary" />

            <TextView
                android:id="@+id/tvTrialTerms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                android:fontFamily="@font/nt_400"
                android:lineSpacingMultiplier="1.15"
                android:textColor="@color/color_on_brand_secondary"
                android:textSize="@dimen/_9sdp"
                tools:text="$0.00 today, then $29.99 / year after 3 days." />
        </com.ui.baselib.widget.layout.UiLinearLayout>

        <com.ui.baselib.widget.view.UiTextView
            android:id="@+id/btnWatchAd"
            style="@style/ButtonOutlineStyle"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/_9sdp"
            android:drawablePadding="@dimen/_6sdp"
            android:text="@string/quota_watch_ad"
            app:drawableStartCompat="@drawable/ic_app_play"
            app:uiDrawableAlign="text"
            app:uiDrawableSize="@dimen/_15sdp" />
    </LinearLayout>

</com.ui.baselib.widget.layout.UiLinearLayout>
