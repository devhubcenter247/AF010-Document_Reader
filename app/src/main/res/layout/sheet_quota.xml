<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/BottomSheetAppStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/_10sdp"
    tools:context=".ui.main.premium.QuotaBottomSheet"
    android:background="@drawable/bg_sheet"
    android:clipToOutline="true">

    <View
        android:layout_width="@dimen/_31sdp"
        android:layout_height="@dimen/_4sdp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/_8sdp"
        android:background="@drawable/bg_checkbox_stroke_r3sdp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_15sdp"
        android:paddingTop="@dimen/_13sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivTool"
                android:layout_width="@dimen/_35sdp"
                android:layout_height="@dimen/_35sdp"
                android:contentDescription="@null"
                tools:src="@drawable/ic_app_tool_compress_pdf" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_11sdp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito_800"
                    android:lineSpacingMultiplier="1.05"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/_12sdp"
                    tools:text="You’ve used your free Compress uses today" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:fontFamily="@font/nunito_600"
                    android:text="@string/quota_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/_9sdp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnTrial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_13sdp"
            android:orientation="vertical"
            android:padding="@dimen/_13sdp"
            android:background="@drawable/bg_grad_gradient_start_gradient_end_315_r14sdp"
            android:clipToOutline="true">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/_6sdp"
                android:fontFamily="@font/nunito_800"
                android:text="@string/quota_try_premium"
                android:textSize="@dimen/_11sdp"
                app:drawableTint="@color/on_primary"
                android:textColor="@color/on_primary"
                app:drawableStartCompat="@drawable/ic_app_crown_14sdp" />

            <TextView
                android:id="@+id/tvTrialTerms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                android:fontFamily="@font/nunito_600"
                android:lineSpacingMultiplier="1.15"
                android:textColor="@color/color_on_brand_secondary"
                android:textSize="@dimen/_9sdp"
                tools:text="$0.00 today, then $29.99 / year after 3 days." />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWatchAd"
            style="@style/ButtonOutlineStyle"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/_9sdp"
            android:text="@string/quota_watch_ad"
            android:background="@drawable/bg_surface_card_r10sdp_st1sdp_stroke"
            android:textColor="@color/text_primary"
            app:icon="@drawable/ic_app_play"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/_6sdp"
            app:iconSize="@dimen/_15sdp"
            app:backgroundTint="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:textAllCaps="false"
            android:letterSpacing="0"
            android:stateListAnimator="@null"
            android:paddingHorizontal="0dp"
            android:paddingVertical="0dp"
            android:elevation="0dp" />
    </LinearLayout>

</LinearLayout>
