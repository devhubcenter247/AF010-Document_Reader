<?xml version="1.0" encoding="utf-8"?>
<!-- The free uses of a Pro tool are spent: how many, what Pro adds, and the trial. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/_15sdp"
    android:paddingBottom="@dimen/_20sdp"
    tools:context=".ui.main.premium.QuotaBottomSheet">

    <View
        android:layout_width="@dimen/_34sdp"
        android:layout_height="@dimen/_4sdp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/_8sdp"
        android:background="@drawable/bg_badge"
        android:backgroundTint="@color/color_handle" />

    <FrameLayout
        android:layout_width="@dimen/_65sdp"
        android:layout_height="@dimen/_65sdp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/_12sdp">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progressUsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:progress="100"
            app:indicatorColor="@color/color_pro"
            app:indicatorSize="@dimen/_65sdp"
            app:trackColor="@color/color_surface_variant"
            app:trackCornerRadius="@dimen/_4sdp"
            app:trackThickness="@dimen/_6sdp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvUsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_700"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_15sdp"
                tools:text="3/3" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_700"
                android:text="@string/fo_used"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_9sdp" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8sdp"
        android:fontFamily="@font/nunito_700"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/_16sdp"
        tools:text="You’ve used your free OCR" />

    <TextView
        android:id="@+id/tvMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_5sdp"
        android:fontFamily="@font/nunito_500"
        android:gravity="center"
        android:lineSpacingMultiplier="1.15"
        android:paddingHorizontal="@dimen/_8sdp"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/_11sdp"
        tools:text="Go Pro to use OCR as much as you like, without ads." />

    <LinearLayout
        style="@style/FloatingCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_12sdp"
        android:background="@drawable/bg_rounded_panel"
        android:backgroundTint="@color/color_surface_card"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_12sdp"
        android:paddingVertical="@dimen/_3sdp">

            <LinearLayout style="@style/CheckRow">

                <ImageView
                    style="@style/CheckRowIcon"
                    android:backgroundTint="@color/color_file_excel_bg"
                    android:src="@drawable/ic_fo_check"
                    app:tint="@color/color_file_excel" />

                <TextView
                    style="@style/CheckRowText"
                    android:text="@string/fo_pro_unlimited"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <LinearLayout style="@style/CheckRow">

                <ImageView
                    style="@style/CheckRowIcon"
                    android:backgroundTint="@color/color_file_excel_bg"
                    android:src="@drawable/ic_fo_check"
                    app:tint="@color/color_file_excel" />

                <TextView
                    style="@style/CheckRowText"
                    android:text="@string/fo_pro_translate_all"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <LinearLayout style="@style/CheckRow">

                <ImageView
                    style="@style/CheckRowIcon"
                    android:backgroundTint="@color/color_file_excel_bg"
                    android:src="@drawable/ic_fo_check"
                    app:tint="@color/color_file_excel" />

                <TextView
                    style="@style/CheckRowText"
                    android:text="@string/fo_pro_no_ads_ever"
                    android:textColor="@color/text_primary" />
            </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/btnTrial"
        style="@style/PrimaryPillButton"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/_12sdp"
        tools:text="Try Pro free for 3 days" />

    <TextView
        android:id="@+id/btnNotNow"
        style="@style/GhostButton"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/_2sdp"
        android:text="@string/fo_not_now" />
</LinearLayout>
