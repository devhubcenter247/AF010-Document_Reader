<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app"
    android:orientation="vertical"
    tools:context=".ui.main.tools.split.SplitActivity">

    <include
        android:id="@+id/topBar"
        layout="@layout/layout_screen_bar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_15sdp"
            android:paddingBottom="@dimen/_10sdp">

            <include
                android:id="@+id/steps"
                layout="@layout/layout_step_progress" />

            <include
                android:id="@+id/file"
                layout="@layout/layout_tool_file"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_11sdp" />

            <include
                android:id="@+id/optionEachPage"
                layout="@layout/layout_option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_11sdp" />

            <include
                android:id="@+id/optionRanges"
                layout="@layout/layout_option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp" />

            <include
                android:id="@+id/optionPick"
                layout="@layout/layout_option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp" />

            <LinearLayout
                android:id="@+id/layoutPages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_11sdp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPagesLabel"
                    style="@style/FieldLabel"
                    android:labelFor="@id/edtPages"
                    tools:text="@string/split_ranges_label" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_42sdp"
                    android:addStatesFromChildren="true"
                    android:background="@drawable/bg_field"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/_12sdp">

                    <EditText
                        android:id="@+id/edtPages"
                        style="@style/FieldInput"
                        android:layout_width="match_parent"
                        android:digits="0123456789,- "
                        android:hint="@string/split_ranges_hint"
                        android:imeOptions="actionDone"
                        android:inputType="number|text" />
                </LinearLayout>
            </LinearLayout>

            <!-- What comes out -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_11sdp"
                android:background="@drawable/bg_rounded_panel"
                android:backgroundTint="@color/color_surface_variant"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/_12sdp"
                android:paddingVertical="@dimen/_11sdp">

                <TextView
                    android:id="@+id/tvPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito_700"
                    android:textColor="@color/text_tertiary"
                    android:textSize="@dimen/_10sdp"
                    tools:text="You’ll get 3 files" />

                <LinearLayout
                    android:id="@+id/layoutParts"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_42sdp"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:orientation="horizontal" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/action"
        layout="@layout/layout_tool_action" />
</LinearLayout>
