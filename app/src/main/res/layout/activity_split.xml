<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app"
    android:orientation="vertical"
    tools:context=".ui.main.tools.split.SplitActivity">

    <include
        android:id="@+id/topBar"
        layout="@layout/layout_tool_topbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_12sdp"
            android:paddingBottom="@dimen/_10sdp">

            <include
                android:id="@+id/header"
                layout="@layout/layout_tool_header" />

            <include
                android:id="@+id/file"
                layout="@layout/layout_tool_file"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_13sdp" />

            <include
                android:id="@+id/optionRanges"
                layout="@layout/layout_option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_13sdp" />

            <LinearLayout
                android:id="@+id/layoutRanges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rcvRanges"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_split_range" />

                <TextView
                    android:id="@+id/btnAddRange"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_27sdp"
                    android:drawablePadding="@dimen/_5sdp"
                    android:fontFamily="@font/nunito_800"
                    android:gravity="center_vertical"
                    android:text="@string/add_range"
                    android:textSize="@dimen/_10sdp"
                    app:drawableTint="@color/text_on_selected"
                    android:textColor="@color/text_on_selected"
                    app:drawableStartCompat="@drawable/ic_app_plus_12sdp" />
            </LinearLayout>

            <include
                android:id="@+id/optionEachPage"
                layout="@layout/layout_option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp" />

            <include
                android:id="@+id/optionPick"
                layout="@layout/layout_option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcvPages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:visibility="gone"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="4"
                tools:listitem="@layout/item_page_thumb" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/action"
        layout="@layout/layout_tool_action" />

</LinearLayout>
