<?xml version="1.0" encoding="utf-8"?>
<!-- The file a tool works on: type tile, name, a line about it, and "Change" when it can be swapped. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/FloatingCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/_55sdp"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/_11sdp"
    android:paddingVertical="@dimen/_9sdp">

    <TextView
        android:id="@+id/tvType"
        android:layout_width="@dimen/_34sdp"
        android:layout_height="@dimen/_34sdp"
        android:background="@drawable/bg_file_tile"
        android:fontFamily="@font/nunito_700"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:textColor="@color/on_primary"
        android:textSize="@dimen/_9sdp"
        tools:backgroundTint="@color/color_file_pdf"
        tools:text="PDF" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_9sdp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:fontFamily="@font/nunito_700"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/_12sdp"
            tools:text="Insurance policy.pdf" />

        <TextView
            android:id="@+id/tvMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_1sdp"
            android:fontFamily="@font/nunito_500"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_10sdp"
            tools:text="22 pages · 4.0 MB" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnChange"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_31sdp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:fontFamily="@font/nunito_700"
        android:gravity="center"
        android:paddingHorizontal="@dimen/_5sdp"
        android:text="@string/fo_change"
        android:textColor="@color/primary"
        android:textSize="@dimen/_11sdp"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
