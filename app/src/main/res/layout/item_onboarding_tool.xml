<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:background="@drawable/bg_tool_tile"
    android:elevation="@dimen/_3sdp"
    android:gravity="center"
    android:orientation="vertical"
    android:outlineAmbientShadowColor="@color/color_shadow"
    android:outlineSpotShadowColor="@color/color_shadow">

    <ImageView
        android:id="@+id/ivIcon"
        android:layout_width="@dimen/_34sdp"
        android:layout_height="@dimen/_34sdp"
        android:background="@drawable/bg_icon_tile"
        android:importantForAccessibility="no"
        android:padding="@dimen/_8sdp"
        app:tint="@color/on_primary"
        tools:src="@drawable/ic_fo_merge" />

    <TextView
        android:id="@+id/tvLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6sdp"
        android:fontFamily="@font/nunito_700"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/_10sdp"
        tools:text="Merge" />
</LinearLayout>
