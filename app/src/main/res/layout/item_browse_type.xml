<?xml version="1.0" encoding="utf-8"?>
<com.ui.baselib.widget.layout.UiLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/CardAppStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_3sdp"
    app:uiCornerRadius="@dimen/_12sdp"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/_8sdp"
    android:paddingVertical="@dimen/_8sdp">

    <ImageView
        android:id="@+id/ivType"
        android:layout_width="@dimen/_20sdp"
        android:layout_height="@dimen/_23sdp"
        android:contentDescription="@null"
        tools:src="@drawable/ic_file_pdf" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_5sdp"
        android:ellipsize="end"
        android:fontFamily="@font/nt_500"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/_9sdp"
        tools:text="PDF" />

    <TextView
        android:id="@+id/tvCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/nt_400"
        android:maxLines="1"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/_9sdp"
        tools:text="128 files" />

</com.ui.baselib.widget.layout.UiLinearLayout>
