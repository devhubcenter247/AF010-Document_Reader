<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/_8sdp"
    android:background="@drawable/bg_document_row"
    android:elevation="@dimen/_3sdp"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/_55sdp"
    android:orientation="horizontal"
    android:outlineAmbientShadowColor="@color/color_shadow"
    android:outlineSpotShadowColor="@color/color_shadow"
    android:paddingStart="@dimen/_11sdp"
    android:paddingEnd="@dimen/_3sdp">

    <ImageView
        android:id="@+id/ivCheck"
        android:layout_width="@dimen/_20sdp"
        android:layout_height="@dimen/_20sdp"
        android:layout_marginEnd="@dimen/_9sdp"
        android:background="@drawable/bg_check_square"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        android:padding="@dimen/_4sdp"
        android:src="@drawable/ic_fo_check"
        android:visibility="gone"
        app:tint="@color/on_primary" />

    <TextView
        android:id="@+id/tvType"
        android:layout_width="@dimen/_34sdp"
        android:layout_height="@dimen/_34sdp"
        android:background="@drawable/bg_file_tile"
        android:fontFamily="@font/nunito_700"
        android:gravity="center"
        android:letterSpacing="0.02"
        android:maxLines="1"
        android:textColor="@color/on_primary"
        android:textSize="@dimen/_9sdp"
        tools:backgroundTint="@color/color_file_pdf"
        tools:text="PDF" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_9sdp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingVertical="@dimen/_6sdp">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:fontFamily="@font/nunito_700"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/_12sdp"
            tools:text="Lease_Agreement_2026.pdf" />

        <TextView
            android:id="@+id/tvMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_1sdp"
            android:fontFamily="@font/nunito_500"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_10sdp"
            tools:text="2.4 MB · 2h ago" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivFavorite"
        android:layout_width="@dimen/_14sdp"
        android:layout_height="@dimen/_14sdp"
        android:contentDescription="@string/favorites"
        android:src="@drawable/ic_fo_star_filled"
        android:visibility="gone"
        app:tint="@color/color_pro" />

    <TextView
        android:id="@+id/btnOpen"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_29sdp"
        android:layout_marginEnd="@dimen/_6sdp"
        android:background="@drawable/bg_open_pill"
        android:fontFamily="@font/nunito_700"
        android:gravity="center"
        android:paddingHorizontal="@dimen/_12sdp"
        android:text="@string/open"
        android:textColor="@color/text_on_selected"
        android:textSize="@dimen/_11sdp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/btnMore"
        android:layout_width="@dimen/_34sdp"
        android:layout_height="@dimen/_34sdp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/more_options"
        android:padding="@dimen/_9sdp"
        android:src="@drawable/ic_fo_more"
        app:tint="@color/text_secondary" />
</LinearLayout>
