<?xml version="1.0" encoding="utf-8"?>
<!-- The "more" menu of a document being viewed. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/_15sdp"
    android:paddingBottom="@dimen/_20sdp"
    tools:context=".ui.main.reader.office.sheet.OfficeOptionsBottomSheet">

    <include
        android:id="@+id/header"
        layout="@layout/layout_sheet_header" />

    <LinearLayout
        style="@style/FloatingCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_benefits_card"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_6sdp"
        android:paddingVertical="@dimen/_3sdp">

        <LinearLayout
            android:id="@+id/rowSlideshow"
            style="@style/SheetRow"
            android:minHeight="@dimen/_44sdp">

            <ImageView
                style="@style/SheetRowIcon"
                android:src="@drawable/ic_fo_play" />

            <TextView
                style="@style/SheetRowTitle"
                android:layout_marginStart="@dimen/_9sdp"
                android:text="@string/slideshow" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowGoTo"
            style="@style/SheetRow"
            android:minHeight="@dimen/_44sdp">

            <ImageView
                style="@style/SheetRowIcon"
                android:src="@drawable/ic_fo_list" />

            <TextView
            android:id="@+id/tvGoTo"
                style="@style/SheetRowTitle"
                android:layout_marginStart="@dimen/_9sdp"
                android:text="@string/go_to_page" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowToPdf"
            style="@style/SheetRow"
            android:minHeight="@dimen/_44sdp">

            <ImageView
                style="@style/SheetRowIcon"
                android:src="@drawable/ic_fo_office" />

            <TextView
                style="@style/SheetRowTitle"
                android:layout_marginStart="@dimen/_9sdp"
                android:text="@string/convert_to_pdf" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowFavorite"
            style="@style/SheetRow"
            android:minHeight="@dimen/_40sdp">

            <ImageView
            android:id="@+id/ivFavorite"
                style="@style/SheetRowIcon"
                android:src="@drawable/ic_fo_star" />

            <TextView
                style="@style/SheetRowTitle"
                android:layout_marginStart="@dimen/_9sdp"
                android:text="@string/file_action_favorite" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowInfo"
            style="@style/SheetRow"
            android:minHeight="@dimen/_40sdp">

            <ImageView
                style="@style/SheetRowIcon"
                android:src="@drawable/ic_fo_info" />

            <TextView
                style="@style/SheetRowTitle"
                android:layout_marginStart="@dimen/_9sdp"
                android:text="@string/file_info" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowOpenWith"
            style="@style/SheetRow"
            android:minHeight="@dimen/_40sdp">

            <ImageView
                style="@style/SheetRowIcon"
                android:src="@drawable/ic_fo_share" />

            <TextView
                style="@style/SheetRowTitle"
                android:layout_marginStart="@dimen/_9sdp"
                android:text="@string/open_with_other_app" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowDelete"
            style="@style/SheetRow"
            android:minHeight="@dimen/_40sdp">

            <ImageView
                style="@style/SheetRowIcon"
            android:backgroundTint="@color/color_file_pdf_bg"
            app:tint="@color/color_file_pdf"
                android:src="@drawable/ic_fo_trash" />

            <TextView
                style="@style/SheetRowTitle"
                android:layout_marginStart="@dimen/_9sdp"
            android:textColor="@color/color_file_pdf"
                android:text="@string/file_action_delete" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
