<?xml version="1.0" encoding="utf-8"?>
<!-- A Toolbox card: the tool's picture, its name and what it does, and a Pro tag for Premium tools. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:padding="@dimen/_5sdp">

    <LinearLayout
        android:id="@+id/card"
        style="@style/FloatingCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_tool_card"
        android:clipToOutline="true"
        android:elevation="@dimen/_4sdp"
        android:outlineAmbientShadowColor="@color/color_tool_card_shadow"
        android:outlineSpotShadowColor="@color/color_tool_card_shadow"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="@dimen/_58sdp"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/_7sdp"
        android:paddingStart="@dimen/_9sdp"
        android:paddingEnd="@dimen/_8sdp">

        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="@dimen/_36sdp"
            android:layout_height="@dimen/_36sdp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            tools:src="@drawable/ic_tool_scan" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoSizeMaxTextSize="@dimen/_11sdp"
                android:autoSizeMinTextSize="@dimen/_9sdp"
                android:autoSizeTextType="uniform"
                android:fontFamily="@font/nunito_700"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_11sdp"
                tools:text="Scan" />

            <TextView
                android:id="@+id/tvDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_1sdp"
                android:ellipsize="end"
                android:fontFamily="@font/nunito_500"
                android:maxLines="2"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_9sdp"
                tools:text="Paper to PDF" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvPremium"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_14sdp"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/_8sdp"
        android:layout_marginEnd="@dimen/_8sdp"
        android:background="@drawable/bg_badge"
        android:backgroundTint="@color/color_pro_bg"
        android:elevation="@dimen/_4sdp"
        android:fontFamily="@font/nunito_800"
        android:gravity="center"
        android:includeFontPadding="false"
        android:outlineProvider="none"
        android:paddingHorizontal="@dimen/_5sdp"
        android:text="@string/fo_pro"
        android:textAllCaps="true"
        android:textColor="@color/color_warning"
        android:textSize="@dimen/_9sdp"
        android:visibility="gone"
        tools:visibility="visible" />
</FrameLayout>
