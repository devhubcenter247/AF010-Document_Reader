<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:padding="@dimen/_4sdp">

    <LinearLayout
        android:id="@+id/card"
        style="@style/FloatingCard"
        android:layout_width="match_parent"
        android:elevation="@dimen/_2sdp"
        android:layout_height="wrap_content"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="@dimen/_58sdp"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/_8sdp"
        android:paddingStart="@dimen/_9sdp"
        android:paddingEnd="@dimen/_8sdp">

        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="@dimen/_32sdp"
            android:layout_height="40dp"
            android:importantForAccessibility="no"
            android:padding="@dimen/_8sdp"
            tools:background="@drawable/bg_tool_glyph"
            tools:src="@drawable/ic_fo_scan" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:fontFamily="@font/nunito_700"
                android:lineSpacingMultiplier="0.95"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_11sdp"
                tools:text="Scan" />

            <TextView
                android:id="@+id/tvDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:layout_marginTop="@dimen/_1sdp"
                android:fontFamily="@font/nunito_500"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_10sdp"
                tools:text="Paper to PDF" />

            <TextView
                android:id="@+id/tvSoon"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_15sdp"
                android:layout_marginTop="@dimen/_2sdp"
                android:background="@drawable/bg_soon_chip"
                android:fontFamily="@font/nunito_700"
                android:gravity="center"
                android:paddingHorizontal="@dimen/_6sdp"
                android:text="@string/fo_coming_soon"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/_9sdp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/ivPremium"
        android:layout_width="@dimen/_17sdp"
        android:layout_height="@dimen/_17sdp"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginEnd="@dimen/_10sdp"
        android:background="@drawable/bg_circle_pro"
        android:contentDescription="@string/fo_pro_name"
        android:elevation="@dimen/_4sdp"
        android:outlineProvider="none"
        android:padding="@dimen/_3sdp"
        android:src="@drawable/ic_fo_crown"
        android:visibility="gone"
        app:tint="@color/color_premium_gold" />
</FrameLayout>
