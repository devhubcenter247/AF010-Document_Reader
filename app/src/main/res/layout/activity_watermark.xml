<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app"
    android:orientation="vertical"
    tools:context=".ui.main.tools.watermark.WatermarkActivity">

    <include
        android:id="@+id/topBar"
        layout="@layout/layout_screen_bar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_15sdp"
            android:paddingBottom="@dimen/_10sdp">

            <!-- The first page with the stamp on it -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_231sdp"
                android:layout_marginTop="@dimen/_3sdp"
                android:background="@drawable/bg_rounded_panel"
                android:backgroundTint="@color/color_surface_variant">

                <FrameLayout
                    android:id="@+id/layoutPage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_page_sheet"
                    android:clipToOutline="true"
                    android:elevation="@dimen/_8sdp"
                    android:outlineAmbientShadowColor="@color/color_shadow"
                    android:outlineSpotShadowColor="@color/color_shadow">

                    <ImageView
                        android:id="@+id/ivPage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:importantForAccessibility="no"
                        android:maxWidth="@dimen/_240sdp"
                        android:maxHeight="@dimen/_205sdp"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:id="@+id/tvWatermark"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/nunito_800"
                        android:letterSpacing="0.08"
                        android:maxLines="1"
                        tools:text="CONFIDENTIAL" />
                </FrameLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_42sdp"
                android:layout_marginTop="@dimen/_12sdp"
                android:addStatesFromChildren="true"
                android:background="@drawable/bg_field"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/_12sdp">

                <EditText
                    android:id="@+id/edtText"
                    style="@style/FieldInput"
                    android:layout_width="match_parent"
                    android:fontFamily="@font/nunito_800"
                    android:hint="@string/watermark_text"
                    android:imeOptions="actionDone"
                    android:inputType="textCapCharacters"
                    android:letterSpacing="0.06" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_11sdp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/RowLabel"
                    android:layout_width="wrap_content"
                    android:layout_marginEnd="@dimen/_9sdp"
                    android:text="@string/fo_colour" />

                <LinearLayout
                    android:id="@+id/layoutColors"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

                <include
                    android:id="@+id/segmentAngle"
                    layout="@layout/layout_segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_11sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/RowLabel"
                    android:text="@string/fo_opacity" />

                <LinearLayout
                    android:id="@+id/layoutOpacity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segment_track"
                    android:orientation="horizontal"
                    android:padding="@dimen/_3sdp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/action"
        layout="@layout/layout_tool_action" />
</LinearLayout>
