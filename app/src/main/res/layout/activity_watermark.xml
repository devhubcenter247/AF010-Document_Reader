<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app"
    android:orientation="vertical"
    tools:context=".ui.main.tools.watermark.WatermarkActivity">

    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/color_surface_track"
        android:padding="@dimen/_13sdp">

        <FrameLayout
            android:id="@+id/layoutPage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center">

            <ImageView
                android:id="@+id/ivPage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:background="@android:color/white"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tvWatermark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                tools:text="DRAFT" />
        </FrameLayout>
    </FrameLayout>

    <com.ui.baselib.widget.layout.UiLinearLayout
        style="@style/BottomSheetAppStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_15sdp"
        android:paddingTop="@dimen/_13sdp"
        android:paddingBottom="@dimen/_13sdp"
        app:uiCornerTopLeft="@dimen/_18sdp"
        app:uiCornerTopRight="@dimen/_18sdp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nt_500"
            android:text="@string/watermark_text"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_10sdp" />

        <com.ui.baselib.widget.layout.UiLinearLayout
            style="@style/CardAppStyle"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_37sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:paddingHorizontal="@dimen/_11sdp"
            app:uiCornerRadius="@dimen/_11sdp">

            <EditText
                android:id="@+id/edtText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:fontFamily="@font/nt_400"
                android:hint="@string/watermark_text"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="textCapCharacters"
                android:maxLength="40"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="@dimen/_12sdp" />
        </com.ui.baselib.widget.layout.UiLinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_11sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/nt_500"
                android:text="@string/pdf_edit_color"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_10sdp" />

            <LinearLayout
                android:id="@+id/layoutColors"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_11sdp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/nt_500"
                android:text="@string/opacity"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_10sdp" />

            <TextView
                android:id="@+id/tvOpacity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nt_400"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_10sdp"
                tools:text="22%" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seekOpacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_3sdp"
            android:max="100"
            android:paddingHorizontal="@dimen/_8sdp"
            android:progressBackgroundTint="@color/color_checkbox_stroke"
            android:progressTint="@color/primary"
            android:thumbTint="@color/primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_11sdp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/nt_500"
                android:text="@string/rotation"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_10sdp" />

            <TextView
                android:id="@+id/tvRotation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nt_400"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_10sdp"
                tools:text="22%" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seekRotation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_3sdp"
            android:max="180"
            android:paddingHorizontal="@dimen/_8sdp"
            android:progressBackgroundTint="@color/color_checkbox_stroke"
            android:progressTint="@color/primary"
            android:thumbTint="@color/primary" />

    </com.ui.baselib.widget.layout.UiLinearLayout>

</LinearLayout>
