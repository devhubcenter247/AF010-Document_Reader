<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/BottomSheetAppStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    tools:context=".ui.main.reader.office.sheet.TablePickerBottomSheet"
    android:background="@drawable/bg_sheet"
    android:clipToOutline="true">

    <include
        android:id="@+id/header"
        layout="@layout/layout_sheet_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.af010.creator.docreader.ui.main.reader.office.sheet.TableGridView
            android:id="@+id/gridPreview"
            android:paddingHorizontal="@dimen/_15sdp"
            android:layout_width="@dimen/_123sdp"
            android:layout_height="@dimen/_92sdp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/_3sdp" />

        <TextView
            android:id="@+id/tvSize"
            android:paddingHorizontal="@dimen/_15sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:fontFamily="@font/nunito_700"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/_13sdp"
            tools:text="3 × 3" />

        <TextView
            android:layout_marginHorizontal="@dimen/_15sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_3sdp"
            android:fontFamily="@font/nunito_600"
            android:gravity="center"
            android:text="@string/columns_by_rows"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_10sdp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_11sdp"
            android:layout_marginHorizontal="@dimen/_15sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito_600"
                    android:text="@string/columns"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/_10sdp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_35sdp"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_r9sdp"
                    android:foreground="@drawable/stroke_r9sdp_st1sdp_stroke"
                    android:clipToOutline="true">

                    <ImageView
                        android:id="@+id/btnColumnsLess"
                        android:layout_width="@dimen/_31sdp"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:padding="@dimen/_8sdp"
                        android:src="@drawable/ic_fo_minus" />

                    <TextView
                        android:id="@+id/tvColumns"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/nunito_700"
                        android:gravity="center"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/_11sdp"
                        tools:text="3" />

                    <ImageView
                        android:id="@+id/btnColumnsMore"
                        android:layout_width="@dimen/_31sdp"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:padding="@dimen/_8sdp"
                        android:src="@drawable/ic_fo_plus" />
                </LinearLayout>
            </LinearLayout>

            <Space
                android:layout_width="@dimen/_9sdp"
                android:layout_height="0dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito_600"
                    android:text="@string/rows"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/_10sdp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_35sdp"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_r9sdp"
                    android:foreground="@drawable/stroke_r9sdp_st1sdp_stroke"
                    android:clipToOutline="true">

                    <ImageView
                        android:id="@+id/btnRowsLess"
                        android:layout_width="@dimen/_31sdp"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:padding="@dimen/_8sdp"
                        android:src="@drawable/ic_fo_minus" />

                    <TextView
                        android:id="@+id/tvRows"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/nunito_700"
                        android:gravity="center"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/_11sdp"
                        tools:text="3" />

                    <ImageView
                        android:id="@+id/btnRowsMore"
                        android:layout_width="@dimen/_31sdp"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:padding="@dimen/_8sdp"
                        android:src="@drawable/ic_fo_plus" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/btnInsert"
            style="@style/ButtonAppStyle"
            android:layout_marginHorizontal="@dimen/_15sdp"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/_13sdp"
            android:text="@string/insert_table"
            android:layout_marginBottom="@dimen/_10sdp"
            android:background="@drawable/bg_button_primary"
            android:elevation="@dimen/_5sdp"
            android:outlineSpotShadowColor="@color/primary_30"
            android:outlineAmbientShadowColor="@color/primary_20"
            android:textColor="@color/white" />
    </LinearLayout>

</LinearLayout>
