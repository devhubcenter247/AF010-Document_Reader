<?xml version="1.0" encoding="utf-8"?>
<!-- Word, Excel and PowerPoint: a floating bar at the top (viewing, editing, find and replace or
     arranging slides), the document, and at the bottom the slide strip, the ribbon or the slide
     actions. OfficeActivity.render() decides what is visible. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/reader_bg"
    tools:context=".ui.main.reader.office.OfficeActivity">

    <LinearLayout
        android:id="@+id/layoutScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/layoutTop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/_9sdp"
            android:paddingTop="@dimen/_6sdp"
            android:paddingBottom="@dimen/_8sdp">

            <!-- Floating while viewing; OfficeActivity.render() docks it flat to the top while editing -->
            <FrameLayout
                android:id="@+id/cardTop"
                style="@style/FloatBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/_6sdp">

                <!-- Viewing -->
                <LinearLayout
                    android:id="@+id/barView"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_46sdp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/btnBack"
                        style="@style/ReaderBarIcon"
                        android:contentDescription="@string/back"
                        android:src="@drawable/ic_fo_back" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_2sdp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvName"
                            style="@style/OfficeBarTitle"
                            tools:text="Team offsite plan.docx" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvType"
                                style="@style/OfficeTypeBadge"
                                tools:backgroundTint="@color/color_file_word_bg"
                                tools:text="DOCX"
                                tools:textColor="@color/color_file_word" />

                            <TextView
                                android:id="@+id/tvPage"
                                style="@style/OfficeBarSubtitle"
                                tools:text="Page 1 of 3" />
                        </LinearLayout>
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btnSearch"
                        style="@style/ReaderBarIcon"
                        android:contentDescription="@string/fo_find"
                        android:src="@drawable/ic_fo_search" />

                    <ImageView
                        android:id="@+id/btnShare"
                        style="@style/ReaderBarIcon"
                        android:contentDescription="@string/file_action_share"
                        android:src="@drawable/ic_fo_share" />

                    <ImageView
                        android:id="@+id/btnMore"
                        style="@style/ReaderBarIcon"
                        android:contentDescription="@string/fo_more"
                        android:src="@drawable/ic_fo_more" />
                </LinearLayout>

                <!-- Editing -->
                <LinearLayout
                    android:id="@+id/barEdit"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_34sdp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/btnEditBack"
                        style="@style/ReaderBarIcon"
                        android:contentDescription="@string/scanner_close"
                        android:src="@drawable/ic_fo_close" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_2sdp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvEditName"
                            style="@style/OfficeBarTitle"
                            tools:text="Team offsite plan" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvTypeEdit"
                                style="@style/OfficeTypeBadge"
                                tools:backgroundTint="@color/color_file_word_bg"
                                tools:text="DOCX"
                                tools:textColor="@color/color_file_word" />

                            <TextView
                                android:id="@+id/tvStatus"
                                style="@style/OfficeBarSubtitle"
                                tools:text="Edited" />
                        </LinearLayout>
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btnPlay"
                        style="@style/ReaderBarIcon"
                        android:background="@drawable/bg_circle_variant"
                        android:backgroundTint="@color/color_file_powerpoint_bg"
                        android:contentDescription="@string/slideshow"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:padding="@dimen/_10sdp"
                        android:src="@drawable/ic_fo_play"
                        android:visibility="gone"
                        app:tint="@color/color_file_powerpoint" />

                    <ImageView
                        android:id="@+id/btnUndo"
                        style="@style/ReaderBarIcon"
                        android:contentDescription="@string/undo"
                        android:src="@drawable/ic_fo_undo" />

                    <ImageView
                        android:id="@+id/btnRedo"
                        style="@style/ReaderBarIcon"
                        android:contentDescription="@string/redo"
                        android:src="@drawable/ic_fo_redo" />

                    <TextView
                        android:id="@+id/btnSave"
                        style="@style/DockedSave"
                        android:text="@string/file_action_save" />
                </LinearLayout>

                <!-- Find and replace -->
                <LinearLayout
                    android:id="@+id/barFind"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/_6sdp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_46sdp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/btnFindClose"
                            style="@style/ReaderBarClose"
                            android:contentDescription="@string/scanner_close"
                            android:src="@drawable/ic_fo_close" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="@dimen/_34sdp"
                            android:layout_marginHorizontal="@dimen/_5sdp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_search_field_soft"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/_9sdp">

                            <ImageView
                                android:layout_width="@dimen/_14sdp"
                                android:layout_height="@dimen/_14sdp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_fo_search"
                                app:tint="@color/text_secondary" />

                            <EditText
                                android:id="@+id/edtFind"
                                style="@style/OfficeFindInput"
                                android:hint="@string/find_hint"
                                android:imeOptions="actionSearch" />

                            <TextView
                                android:id="@+id/tvFindCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/nunito_700"
                                android:maxLines="1"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/_10sdp"
                                tools:text="2 of 3" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/btnFindNext"
                            style="@style/ReaderBarIcon"
                            android:contentDescription="@string/fo_next_match"
                            android:rotation="-90"
                            android:src="@drawable/ic_fo_back" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/_39sdp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="@dimen/_34sdp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_search_field_soft"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/_9sdp">

                            <EditText
                                android:id="@+id/edtReplace"
                                style="@style/OfficeFindInput"
                                android:layout_marginHorizontal="0dp"
                                android:hint="@string/replace_hint"
                                android:imeOptions="actionDone" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/btnReplace"
                            style="@style/OfficeFindButton"
                            android:backgroundTint="@color/color_surface_variant"
                            android:text="@string/replace"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:id="@+id/btnReplaceAll"
                            style="@style/OfficeFindButton"
                            android:backgroundTint="@color/primary"
                            android:text="@string/replace_all"
                            android:textColor="@color/on_primary" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Arranging slides -->
                <LinearLayout
                    android:id="@+id/barSorter"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_46sdp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/btnSorterClose"
                        style="@style/ReaderBarClose"
                        android:contentDescription="@string/back"
                        android:src="@drawable/ic_fo_back" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_8sdp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvSorterTitle"
                            style="@style/OfficeBarTitle"
                            tools:text="Arrange slides" />

                        <TextView
                            android:id="@+id/tvSorterSubtitle"
                            style="@style/OfficeBarSubtitle"
                            android:layout_marginStart="0dp"
                            tools:text="Tap a slide, then move it" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnSorterDone"
                        style="@style/ReaderSave"
                        android:text="@string/done" />
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/tvBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_12sdp"
            android:layout_marginBottom="@dimen/_6sdp"
            android:background="@drawable/bg_rounded_panel"
            android:backgroundTint="@color/color_pro_bg"
            android:drawablePadding="@dimen/_6sdp"
            android:fontFamily="@font/nunito_600"
            android:paddingHorizontal="@dimen/_11sdp"
            android:paddingVertical="@dimen/_7sdp"
            android:text="@string/legacy_view_only"
            android:textColor="@color/color_warning"
            android:textSize="@dimen/_10sdp"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_fo_info_17sdp"
            app:drawableTint="@color/color_premium_gold"
            tools:visibility="visible" />

        <!-- Excel: the selected cell and what is in it -->
        <LinearLayout
            android:id="@+id/layoutFormula"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_28sdp"
            android:background="@drawable/bg_docked_top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_7sdp"
            android:paddingEnd="@dimen/_3sdp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tvCell"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_19sdp"
                android:background="@drawable/bg_badge"
                android:backgroundTint="@color/color_file_excel_bg"
                android:fontFamily="@font/nunito_700"
                android:gravity="center"
                android:minWidth="@dimen/_28sdp"
                android:paddingHorizontal="@dimen/_5sdp"
                android:textColor="@color/color_file_excel"
                android:textSize="@dimen/_9sdp"
                tools:text="C6" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_6sdp"
                android:fontFamily="serif"
                android:text="@string/formula_fx"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_11sdp"
                android:textStyle="bold|italic" />

            <LinearLayout
                android:id="@+id/boxFormula"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/edtFormula"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="@font/nunito_700"
                    android:hint="@string/formula_hint"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="@dimen/_11sdp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnFormulaApply"
                android:layout_width="@dimen/_26sdp"
                android:layout_height="@dimen/_26sdp"
                android:layout_marginStart="@dimen/_4sdp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/apply"
                android:padding="@dimen/_6sdp"
                android:src="@drawable/ic_fo_check"
                app:tint="@color/color_file_excel" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/layoutContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.editor.docsdk.DocumentView
                android:id="@+id/documentView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_28sdp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/primary" />

            <TextView
                android:id="@+id/tvPagePill"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_28sdp"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="@dimen/_15sdp"
                android:layout_marginBottom="@dimen/_26sdp"
                android:background="@drawable/bg_ink_pill"
                android:elevation="@dimen/_3sdp"
                android:fontFamily="@font/nunito_700"
                android:gravity="center"
                android:paddingHorizontal="@dimen/_11sdp"
                android:textColor="@color/white"
                android:textSize="@dimen/_10sdp"
                android:visibility="gone"
                tools:text="1 / 3"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEdit"
                style="@style/PrimaryPillButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_46sdp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="@dimen/_15sdp"
                android:layout_marginBottom="@dimen/_20sdp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0"
                android:minHeight="0dp"
                android:paddingStart="@dimen/_14sdp"
                android:paddingEnd="@dimen/_18sdp"
                android:stateListAnimator="@null"
                android:text="@string/fo_edit"
                android:textAllCaps="false"
                android:visibility="gone"
                app:backgroundTint="@null"
                app:icon="@drawable/ic_fo_pencil"
                app:iconPadding="@dimen/_6sdp"
                app:iconSize="@dimen/_15sdp"
                app:iconTint="@color/on_primary"
                tools:visibility="visible" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcvSorter"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/reader_bg"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingHorizontal="@dimen/_9sdp"
                android:paddingBottom="@dimen/_90sdp"
                android:visibility="gone"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="2"
                tools:listitem="@layout/item_slide_sorter" />
        </FrameLayout>

        <!-- The SDK lifts this above the keyboard while editing -->
        <LinearLayout
            android:id="@+id/layoutBottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="vertical">

            <!-- PowerPoint: the slides, with the way to arrange them -->
            <LinearLayout
                android:clipToPadding="false"
                android:id="@+id/layoutSlides"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/_9sdp"
                android:paddingBottom="@dimen/_6sdp"
                android:visibility="gone"
                tools:visibility="visible">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rcvSlides"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:overScrollMode="never"
                    android:paddingVertical="@dimen/_3sdp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_slide_thumb" />

                <ImageView
                    android:id="@+id/btnArrange"
                    android:layout_width="@dimen/_38sdp"
                    android:layout_height="@dimen/_38sdp"
                    android:layout_marginStart="@dimen/_6sdp"
                    android:background="@drawable/bg_badge"
                    android:backgroundTint="@color/color_surface_card"
                    android:contentDescription="@string/arrange_slides"
                    android:elevation="@dimen/_2sdp"
                    android:foreground="?attr/selectableItemBackground"
                    android:padding="@dimen/_10sdp"
                    android:src="@drawable/ic_fo_organize"
                    app:tint="@color/text_primary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutRibbon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_docked_bottom"
                android:orientation="vertical"
                android:paddingVertical="@dimen/_4sdp"
                android:visibility="gone"
                tools:visibility="visible">

                <HorizontalScrollView
                    android:id="@+id/scrollTabs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_3sdp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/layoutTabs"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_22sdp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/_6sdp" />
                </HorizontalScrollView>

                <!-- While typing the tab row goes: the picked tab becomes a chip at the start of the commands -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnTabPick"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_24sdp"
                        android:layout_marginStart="@dimen/_6sdp"
                        android:background="@drawable/bg_badge"
                        android:drawablePadding="@dimen/_2sdp"
                        android:fontFamily="@font/nunito_700"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:paddingStart="@dimen/_8sdp"
                        android:paddingEnd="@dimen/_5sdp"
                        android:textSize="@dimen/_10sdp"
                        android:visibility="gone"
                        app:drawableEndCompat="@drawable/ic_fo_chevron_down_13sdp"
                        tools:text="Home"
                        tools:visibility="visible" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rcvRibbon"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        android:overScrollMode="never"
                        android:paddingHorizontal="@dimen/_6sdp"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:listitem="@layout/item_ribbon" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutSorterActions"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_55sdp"
                android:layout_marginHorizontal="@dimen/_9sdp"
                android:layout_marginBottom="@dimen/_12sdp"
                android:background="@drawable/bg_ink_bar"
                android:elevation="@dimen/_10sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:outlineAmbientShadowColor="@color/color_shadow"
                android:outlineSpotShadowColor="@color/color_shadow"
                android:paddingHorizontal="@dimen/_6sdp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/btnSlideDuplicate"
                    style="@style/InkBarAction"
                    android:text="@string/duplicate"
                    app:drawableTopCompat="@drawable/ic_fo_copy_17sdp" />

                <TextView
                    android:id="@+id/btnSlideEarlier"
                    style="@style/InkBarAction"
                    android:text="@string/move_earlier"
                    app:drawableTopCompat="@drawable/ic_fo_back_17sdp" />

                <TextView
                    android:id="@+id/btnSlideLater"
                    style="@style/InkBarAction"
                    android:text="@string/move_later"
                    app:drawableTopCompat="@drawable/ic_fo_forward_17sdp" />

                <TextView
                    android:id="@+id/btnSlideAdd"
                    style="@style/InkBarAction"
                    android:text="@string/add_after"
                    app:drawableTopCompat="@drawable/ic_fo_plus_17sdp" />

                <TextView
                    android:id="@+id/btnSlideDelete"
                    style="@style/InkBarAction"
                    android:text="@string/file_action_delete"
                    android:textColor="@color/ink_bar_danger"
                    app:drawableTint="@color/ink_bar_danger"
                    app:drawableTopCompat="@drawable/ic_fo_trash_17sdp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
