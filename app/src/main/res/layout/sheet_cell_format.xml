<?xml version="1.0" encoding="utf-8"?>
<com.ui.baselib.widget.layout.UiLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/BottomSheetAppStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    tools:context=".ui.main.reader.office.sheet.CellFormatBottomSheet">

    <include
        android:id="@+id/header"
        layout="@layout/layout_sheet_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_marginHorizontal="@dimen/_14sdp"
            style="@style/TextSectionCaps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_6sdp"
            android:layout_marginTop="@dimen/_3sdp"
            android:text="@string/fill_color" />

        <LinearLayout
            android:layout_marginHorizontal="@dimen/_14sdp"
            android:id="@+id/layoutFillColors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <TextView
            android:layout_marginHorizontal="@dimen/_14sdp"
            style="@style/TextSectionCaps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_6sdp"
            android:layout_marginTop="@dimen/_11sdp"
            android:text="@string/alignment" />

        <LinearLayout
            android:layout_marginHorizontal="@dimen/_14sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.ui.baselib.widget.view.UiImageView
                android:id="@+id/btnAlignLeft"
                android:layout_width="@dimen/_36sdp"
                android:layout_height="@dimen/_36sdp"
                android:layout_marginEnd="@dimen/_6sdp"
                android:contentDescription="@null"
                android:padding="@dimen/_10sdp"
                app:uiBackgroundColor="@color/color_surface_variant"
                app:uiCornerRadius="@dimen/_11sdp" />

            <com.ui.baselib.widget.view.UiImageView
                android:id="@+id/btnAlignCenter"
                android:layout_width="@dimen/_36sdp"
                android:layout_height="@dimen/_36sdp"
                android:layout_marginEnd="@dimen/_6sdp"
                android:contentDescription="@null"
                android:padding="@dimen/_10sdp"
                app:uiBackgroundColor="@color/color_surface_variant"
                app:uiCornerRadius="@dimen/_11sdp" />

            <com.ui.baselib.widget.view.UiImageView
                android:id="@+id/btnAlignRight"
                android:layout_width="@dimen/_36sdp"
                android:layout_height="@dimen/_36sdp"
                android:layout_marginEnd="@dimen/_6sdp"
                android:contentDescription="@null"
                android:padding="@dimen/_10sdp"
                app:uiBackgroundColor="@color/color_surface_variant"
                app:uiCornerRadius="@dimen/_11sdp" />

            <com.ui.baselib.widget.view.UiTextView
                android:id="@+id/btnWrap"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_36sdp"
                android:layout_marginStart="@dimen/_8sdp"
                android:drawablePadding="@dimen/_8sdp"
                android:fontFamily="@font/nt_400"
                android:gravity="center_vertical"
                android:text="@string/wrap_text"
                android:textSize="@dimen/_12sdp"
                app:drawableStartCompat="@drawable/ic_app_checkbox_off"
                app:uiDrawableSize="@dimen/_17sdp"
                app:uiTextColor="@color/text_primary" />
        </LinearLayout>

        <com.ui.baselib.widget.view.UiTextView
            android:id="@+id/btnApply"
            android:layout_marginHorizontal="@dimen/_14sdp"
            style="@style/ButtonAppStyle"
            android:layout_marginBottom="@dimen/_10sdp"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/_13sdp"
            app:uiShadowClipParent="force"
            app:uiShadowColor="@color/primary_30"
            tools:text="Apply to 9 cells" />
    </LinearLayout>

</com.ui.baselib.widget.layout.UiLinearLayout>
