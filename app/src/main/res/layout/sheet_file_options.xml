<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/_15sdp"
    android:paddingBottom="@dimen/_18sdp">

    <View
        android:layout_width="@dimen/_34sdp"
        android:layout_height="@dimen/_4sdp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/_8sdp"
        android:background="@drawable/bg_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_14sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_3sdp">

        <TextView
            android:id="@+id/tvType"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:background="@drawable/bg_type_badge"
            android:fontFamily="@font/nunito_700"
            android:gravity="center"
            android:maxLines="1"
            android:textSize="@dimen/_9sdp"
            tools:backgroundTint="@color/color_file_pdf_bg"
            tools:text="PDF"
            tools:textColor="@color/color_file_pdf" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_11sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:fontFamily="@font/nunito_700"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_13sdp"
                tools:text="Lease_Agreement_2026.pdf" />

            <TextView
                android:id="@+id/tvMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:fontFamily="@font/nunito_500"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_10sdp"
                tools:text="2.4 MB · Downloads" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_11sdp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnShare"
            style="@style/ActionTile"
            android:text="@string/file_action_share"
            app:drawableTopCompat="@drawable/ic_fo_share_17sdp" />

        <TextView
            android:id="@+id/btnFavorite"
            style="@style/ActionTile"
            android:layout_marginStart="@dimen/_8sdp"
            android:text="@string/fo_favourite"
            app:drawableTopCompat="@drawable/ic_fo_star_17sdp" />

        <TextView
            android:id="@+id/btnRename"
            style="@style/ActionTile"
            android:layout_marginStart="@dimen/_8sdp"
            android:text="@string/file_action_rename"
            app:drawableTopCompat="@drawable/ic_fo_pen_17sdp" />

        <TextView
            android:id="@+id/btnCopy"
            style="@style/ActionTile"
            android:layout_marginStart="@dimen/_8sdp"
            android:text="@string/fo_copy"
            app:drawableTopCompat="@drawable/ic_fo_copy_17sdp" />
    </LinearLayout>

    <LinearLayout
        style="@style/FloatingCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_11sdp"
        android:background="@drawable/bg_benefits_card"
        android:clipToOutline="true"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_5sdp"
        android:paddingVertical="@dimen/_3sdp">

        <TextView
            android:id="@+id/rowInfo"
            style="@style/CardRow"
            android:text="@string/file_info"
            app:drawableEndCompat="@drawable/ic_fo_chevron_17sdp"
            app:drawableStartCompat="@drawable/ic_fo_info_17sdp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/_2sdp"
            android:layout_marginHorizontal="@dimen/_6sdp"
            android:background="@drawable/line_dashed" />

        <TextView
            android:id="@+id/rowDelete"
            style="@style/CardRow"
            android:text="@string/file_action_delete"
            android:textColor="@color/color_error"
            app:drawableStartCompat="@drawable/ic_fo_trash_17sdp"
            app:drawableTint="@color/color_error" />
    </LinearLayout>
</LinearLayout>
