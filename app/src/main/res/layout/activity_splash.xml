<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app"
    tools:context=".ui.splash.SplashActivity">

    <com.ui.baselib.widget.view.UiImageView
        android:id="@+id/uiImageView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/img_logo_splash"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.302"
        app:uiCornerRadius="@dimen/_23sdp"
        app:uiDimensionRatio="1:1"
        app:uiShadowColor="@color/primary_40"
        app:uiShadowElevation="@dimen/_13sdp"
        app:uiShadowRadius="@dimen/_27sdp"
        app:uiShadowClipParent="force"
        app:uiWidthPercent="0.35" />

    <com.ui.baselib.widget.view.UiTextView
        android:id="@+id/tvAppName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10ssp"
        android:fontFamily="@font/nt_600"
        android:text="@string/app_name"
        android:textAlignment="center"
        android:textSize="@dimen/_15sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/uiImageView" />

    <com.ui.baselib.widget.view.UiTextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/nt_400"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="@dimen/_10ssp"
        android:text="@string/create_edit_and_sign_any_document"
        android:textAlignment="center"
        android:textSize="@dimen/_10sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvAppName" />

    <com.ui.baselib.widget.view.UiTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_7sdp"
        android:text="@string/this_action_may_contain_advertising"
        app:layout_constraintBottom_toTopOf="@+id/uiLinearProgressIndicator"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.ui.baselib.widget.view.UiLinearProgressIndicator
        android:id="@+id/uiLinearProgressIndicator"
        android:layout_width="0dp"
        app:uiProgressTrackThickness="@dimen/_3sdp"
        android:layout_height="wrap_content"
        app:uiProgressTrackColor="@color/primary_30"
        app:uiProgressTrackCornerRadius="@dimen/_10ssp"
        android:layout_marginBottom="@dimen/_10ssp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.7"
        app:uiProgressGradientEnd="@color/gradient_end"
        app:uiProgressGradientStart="@color/gradient_start"
        app:uiProgressIndeterminate="true" />
</androidx.constraintlayout.widget.ConstraintLayout>
