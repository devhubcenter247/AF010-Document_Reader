<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/DialogAppStyle"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/_17sdp"
    tools:context=".ui.dialog.ChoiceDialog"
    android:background="@drawable/bg_surface_card_r18sdp"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/ivIcon"
        android:layout_width="@dimen/_55sdp"
        android:layout_height="@dimen/_55sdp"
        android:contentDescription="@null"
        android:padding="@dimen/_15sdp"
        app:tint="@color/primary"
        tools:src="@drawable/ic_app_save"
        android:background="@drawable/bg_bg_selected_r28sdp"
        android:clipToOutline="true" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_11sdp"
        android:fontFamily="@font/nunito_800"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/_13sdp"
        tools:text="Save changes before leaving?" />

    <TextView
        android:id="@+id/tvMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6sdp"
        android:fontFamily="@font/nunito_600"
        android:gravity="center"
        android:lineSpacingMultiplier="1.2"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/_9sdp"
        tools:text="Your changes aren’t saved to the original file." />

    <TextView
        android:id="@+id/btnPrimary"
        style="@style/ButtonAppStyle"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/_13sdp"
        tools:text="Save"
        android:background="@drawable/bg_button_primary"
        android:elevation="@dimen/_5sdp"
        android:outlineSpotShadowColor="@color/primary_30"
        android:outlineAmbientShadowColor="@color/primary_20"
        android:textColor="@color/white" />

    <TextView
        android:id="@+id/btnSecondary"
        style="@style/ButtonOutlineStyle"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/_6sdp"
        tools:text="Don’t save"
        android:background="@drawable/bg_surface_card_r10sdp_st1sdp_stroke"
        android:textColor="@color/text_primary" />

    <TextView
        android:id="@+id/btnTertiary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_33sdp"
        android:layout_marginTop="@dimen/_3sdp"
        android:background="?attr/selectableItemBackground"
        android:fontFamily="@font/nunito_700"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/_11sdp"
        android:visibility="gone"
        tools:text="Keep editing"
        tools:visibility="visible" />

</LinearLayout>
