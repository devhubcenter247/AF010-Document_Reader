<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/_31sdp"
    android:layout_marginEnd="@dimen/_5sdp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/_3sdp"
    android:paddingEnd="@dimen/_8sdp"
    tools:uiBackgroundColor="@color/color_f2eafe"
    android:background="@drawable/bg_r16sdp"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/ivIcon"
        android:layout_width="@dimen/_20sdp"
        android:layout_height="@dimen/_20sdp"
        android:contentDescription="@null"
        android:padding="@dimen/_5sdp"
        app:tint="@color/on_primary"
        tools:src="@drawable/ic_app_sign"
        tools:uiBackgroundColor="@color/color_9254e8"
        android:background="@drawable/bg_r12sdp"
        android:clipToOutline="true" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/_3sdp"
        android:layout_marginStart="@dimen/_7sdp"
        android:fontFamily="@font/nt_500"
        android:textColor="@color/color_ink"
        android:textSize="@dimen/_10sdp"
        tools:text="Sign" />

</LinearLayout>
