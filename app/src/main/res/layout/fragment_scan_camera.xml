<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_scan_bg"
    tools:context=".ui.main.scan.fragment.ScanCameraFragment">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBar"
        app:scaleType="fitCenter" />

    <com.af010.creator.docreader.ui.main.scan.view.DocumentOverlayView
        android:id="@+id/documentOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/previewView"
        app:layout_constraintEnd_toEndOf="@+id/previewView"
        app:layout_constraintStart_toStartOf="@+id/previewView"
        app:layout_constraintTop_toTopOf="@+id/previewView" />

    <!-- Shown instead of the preview while the camera permission is missing -->
    <LinearLayout
        android:id="@+id/layoutPermission"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_31sdp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/previewView"
        app:layout_constraintEnd_toEndOf="@+id/previewView"
        app:layout_constraintStart_toStartOf="@+id/previewView"
        app:layout_constraintTop_toTopOf="@+id/previewView"
        tools:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_500"
            android:gravity="center"
            android:text="@string/camera_permission_required"
            android:textColor="@color/on_primary"
            android:textSize="@dimen/_11sdp" />

        <TextView
            android:id="@+id/btnAllowCamera"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_34sdp"
            android:layout_marginTop="@dimen/_12sdp"
            android:fontFamily="@font/nunito_700"
            android:gravity="center"
            android:paddingHorizontal="@dimen/_18sdp"
            android:text="@string/allow_access"
            android:textSize="@dimen/_11sdp"
            android:background="@drawable/bg_ink_next"
            android:textColor="@color/ink_on_accent" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/_49sdp"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_12sdp"
        android:paddingBottom="@dimen/_8sdp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="@dimen/_34sdp"
            android:layout_height="@dimen/_34sdp"
            android:background="@drawable/bg_glass_circle"
            android:contentDescription="@string/scanner_close"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/_9sdp"
            android:src="@drawable/ic_fo_close"
            app:tint="@color/white" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/layoutModes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/bg_glass_track"
                android:orientation="horizontal"
                android:padding="@dimen/_3sdp">

                <TextView
                    android:id="@+id/btnAuto"
                    style="@style/GlassOption"
                    android:text="@string/scan_mode_auto" />

                <TextView
                    android:id="@+id/btnManual"
                    style="@style/GlassOption"
                    android:text="@string/scan_mode_manual" />
            </LinearLayout>
        </FrameLayout>

        <ImageView
            android:id="@+id/btnFlash"
            android:layout_width="@dimen/_34sdp"
            android:layout_height="@dimen/_34sdp"
            android:background="@drawable/bg_glass_circle"
            android:contentDescription="@string/scanner_flash"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/_9sdp"
            android:src="@drawable/ic_fo_flash"
            app:tint="@color/white" />
    </LinearLayout>

    <!-- What the scanner is doing, over the bottom of the preview -->
    <TextView
        android:id="@+id/scanHint"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_31sdp"
        android:layout_marginBottom="@dimen/_12sdp"
        android:background="@drawable/bg_scan_hint"
        android:drawablePadding="@dimen/_6sdp"
        android:ellipsize="end"
        android:fontFamily="@font/nunito_700"
        android:gravity="center"
        android:maxLines="1"
        android:paddingHorizontal="@dimen/_12sdp"
        android:text="@string/scanner_hint_searching"
        android:textColor="@color/ink_bar_text"
        android:textSize="@dimen/_11sdp"
        app:layout_constraintBottom_toTopOf="@+id/bottomPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_120sdp"
        android:background="@drawable/bg_scan_tray"
        android:paddingHorizontal="@dimen/_26sdp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- The pages scanned so far: the latest on top of the stack, with the count -->
        <FrameLayout
            android:id="@+id/thumbnailContainer"
            android:layout_width="@dimen/_46sdp"
            android:layout_height="@dimen/_57sdp"
            android:contentDescription="@string/scanner_scanned_pages"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible">

            <View
                android:layout_width="@dimen/_35sdp"
                android:layout_height="@dimen/_46sdp"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="@dimen/_5sdp"
                android:layout_marginBottom="@dimen/_3sdp"
                android:background="@drawable/bg_page_stack"
                android:rotation="8" />

            <ImageView
                android:id="@+id/ivThumbnail"
                android:layout_width="@dimen/_35sdp"
                android:layout_height="@dimen/_46sdp"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="@dimen/_2sdp"
                android:background="@drawable/bg_r6sdp"
                android:clipToOutline="true"
                android:foreground="@drawable/stroke_r6sdp_st1sdp_on_primary"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/tvPageCount"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_circle_variant"
                android:backgroundTint="@color/primary"
                android:fontFamily="@font/nunito_700"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="@dimen/_10sdp"
                tools:text="2" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/captureButton"
            android:layout_width="@dimen/_65sdp"
            android:layout_height="@dimen/_65sdp"
            android:background="@drawable/bg_shutter"
            android:contentDescription="@string/capture"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/btnGallery"
            android:layout_width="@dimen/_43sdp"
            android:layout_height="@dimen/_43sdp"
            android:background="@drawable/bg_glass_track"
            android:contentDescription="@string/scanner_gallery"
            android:foreground="?attr/selectableItemBackground"
            android:padding="@dimen/_12sdp"
            android:src="@drawable/ic_fo_photo"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
