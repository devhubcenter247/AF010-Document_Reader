<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/BottomSheetAppStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/_10sdp"
    android:background="@drawable/bg_surface_card_r22sdp_22sdp_0_0"
    android:clipToOutline="true">

    <include
        android:id="@+id/header"
        layout="@layout/layout_sheet_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/cardLight"
            style="@style/CardAppStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_4sdp"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/_6sdp"
            android:background="@drawable/bg_surface_card_r13sdp"
            android:foreground="@drawable/stroke_r13sdp_st1sdp_stroke"
            android:clipToOutline="true">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_84sdp"
                android:background="@drawable/bg_r11sdp"
                android:foreground="@drawable/stroke_r11sdp_st1sdp_stroke"
                android:clipToOutline="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="#F7F8FC" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="#F7F8FC" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="@dimen/_8sdp">

                    <View
                        android:layout_width="@dimen/_31sdp"
                        android:layout_height="@dimen/_5sdp"
                        android:background="@drawable/bg_x20243a_r3sdp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_20sdp"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/bg_accent_r6sdp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_13sdp"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/bg_xffffff_r5sdp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_13sdp"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/bg_xffffff_r5sdp" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/tvLight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:drawablePadding="@dimen/_4sdp"
                android:fontFamily="@font/nt_500"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:textSize="@dimen/_10sdp"
                tools:drawableStartCompat="@drawable/ic_app_radio_off"
                tools:text="Light"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardDark"
            style="@style/CardAppStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_4sdp"
            android:layout_marginEnd="@dimen/_4sdp"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/_6sdp"
            android:background="@drawable/bg_surface_card_r13sdp"
            android:foreground="@drawable/stroke_r13sdp_st1sdp_stroke"
            android:clipToOutline="true">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_84sdp"
                android:background="@drawable/bg_r11sdp"
                android:foreground="@drawable/stroke_r11sdp_st1sdp_stroke"
                android:clipToOutline="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="#0F1120" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="#0F1120" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="@dimen/_8sdp">

                    <View
                        android:layout_width="@dimen/_31sdp"
                        android:layout_height="@dimen/_5sdp"
                        android:background="@drawable/bg_xf2f3f8_r3sdp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_20sdp"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/bg_accent_r6sdp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_13sdp"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/bg_x1a1d2e_r5sdp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_13sdp"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/bg_x1a1d2e_r5sdp" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/tvDark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:drawablePadding="@dimen/_4sdp"
                android:fontFamily="@font/nt_500"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:textSize="@dimen/_10sdp"
                tools:drawableStartCompat="@drawable/ic_app_radio_off"
                tools:text="Light"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardSystem"
            style="@style/CardAppStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_4sdp"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/_6sdp"
            android:background="@drawable/bg_surface_card_r13sdp"
            android:foreground="@drawable/stroke_r13sdp_st1sdp_stroke"
            android:clipToOutline="true">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_84sdp"
                android:background="@drawable/bg_r11sdp"
                android:foreground="@drawable/stroke_r11sdp_st1sdp_stroke"
                android:clipToOutline="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="#F7F8FC" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="#0F1120" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="@dimen/_8sdp">

                    <View
                        android:layout_width="@dimen/_31sdp"
                        android:layout_height="@dimen/_5sdp"
                        android:background="@drawable/bg_x9aa1b8_r3sdp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_20sdp"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/bg_accent_r6sdp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_13sdp"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/bg_xc9cce0_r5sdp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_13sdp"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/bg_xc9cce0_r5sdp" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/tvSystem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:drawablePadding="@dimen/_4sdp"
                android:fontFamily="@font/nt_500"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:textSize="@dimen/_10sdp"
                tools:drawableStartCompat="@drawable/ic_app_radio_off"
                tools:text="Light"
                android:textColor="@color/text_primary" />
        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/btnDone"
        style="@style/ButtonAppStyle"
        android:layout_width="match_parent"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_13sdp"
        android:text="@string/done"
        android:background="@drawable/bg_grad_gradient_start_gradient_end_270_r10sdp"
        android:elevation="@dimen/_5sdp"
        android:outlineSpotShadowColor="@color/primary_30"
        android:outlineAmbientShadowColor="@color/primary_20"
        android:textColor="@color/white" />

</LinearLayout>
