<?xml version="1.0" encoding="utf-8"?>
<com.ui.baselib.widget.layout.UiLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/BottomSheetAppStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/_10sdp"
    tools:context=".ui.main.reader.pdf.sheet.ReadingModeBottomSheet">

    <include
        android:id="@+id/header"
        layout="@layout/layout_sheet_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_8sdp"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:orientation="horizontal">

        <com.ui.baselib.widget.layout.UiLinearLayout
            android:id="@+id/cardNormal"
            android:layout_width="0dp"
            android:layout_height="@dimen/_68sdp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            app:uiBackgroundColor="#FFFFFF"
            app:uiCornerRadius="@dimen/_13sdp"
            app:uiStrokeColor="@color/color_stroke"
            app:uiStrokeWidth="@dimen/_1sdp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nt_600"
                android:text="@string/theme_sample"
                android:textColor="#20243A"
                android:textSize="@dimen/_17sdp" />

            <TextView
                android:id="@+id/tvNormal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                android:fontFamily="@font/nt_500"
                android:text="@string/theme_normal"
                android:textColor="#20243A"
                android:textSize="@dimen/_10sdp" />
        </com.ui.baselib.widget.layout.UiLinearLayout>

        <com.ui.baselib.widget.layout.UiLinearLayout
            android:id="@+id/cardNight"
            android:layout_width="0dp"
            android:layout_height="@dimen/_68sdp"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            app:uiBackgroundColor="#1B1D2A"
            app:uiCornerRadius="@dimen/_13sdp"
            app:uiStrokeColor="@color/color_stroke"
            app:uiStrokeWidth="@dimen/_1sdp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nt_600"
                android:text="@string/theme_sample"
                android:textColor="#D9DBE6"
                android:textSize="@dimen/_17sdp" />

            <TextView
                android:id="@+id/tvNight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                android:fontFamily="@font/nt_500"
                android:text="@string/theme_night"
                android:textColor="#D9DBE6"
                android:textSize="@dimen/_10sdp" />
        </com.ui.baselib.widget.layout.UiLinearLayout>

        <com.ui.baselib.widget.layout.UiLinearLayout
            android:id="@+id/cardSepia"
            android:layout_width="0dp"
            android:layout_height="@dimen/_68sdp"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            app:uiBackgroundColor="#F5ECD9"
            app:uiCornerRadius="@dimen/_13sdp"
            app:uiStrokeColor="@color/color_stroke"
            app:uiStrokeWidth="@dimen/_1sdp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nt_600"
                android:text="@string/theme_sample"
                android:textColor="#5B4636"
                android:textSize="@dimen/_17sdp" />

            <TextView
                android:id="@+id/tvSepia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                android:fontFamily="@font/nt_500"
                android:text="@string/theme_sepia"
                android:textColor="#5B4636"
                android:textSize="@dimen/_10sdp" />
        </com.ui.baselib.widget.layout.UiLinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowTextView"
        style="@style/SettingRowStyle">

        <com.ui.baselib.widget.view.UiImageView
            style="@style/SettingRowIconStyle"
            android:contentDescription="@null"
            android:src="@drawable/ic_app_reading"
            app:tint="@color/color_3984ff"
            app:uiBackgroundColor="@color/color_eaf2ff" />

        <TextView
            style="@style/RowLabelStyle"
            android:text="@string/text_view" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_6sdp"
            android:fontFamily="@font/nt_400"
            android:text="@string/text_view_desc"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_10sdp" />

        <ImageView
            style="@style/RowChevronStyle"
            android:contentDescription="@null" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowReadAloud"
        style="@style/SettingRowStyle">

        <com.ui.baselib.widget.view.UiImageView
            style="@style/SettingRowIconStyle"
            android:contentDescription="@null"
            android:src="@drawable/ic_app_volume"
            app:tint="@color/color_9254e8"
            app:uiBackgroundColor="@color/color_f2eafe" />

        <TextView
            style="@style/RowLabelStyle"
            android:text="@string/read_aloud" />

        <ImageView
            style="@style/RowChevronStyle"
            android:contentDescription="@null" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowAutoScroll"
        style="@style/SettingRowStyle">

        <com.ui.baselib.widget.view.UiImageView
            style="@style/SettingRowIconStyle"
            android:contentDescription="@null"
            android:src="@drawable/ic_app_arrowr"
            app:tint="@color/color_35ac71"
            app:uiBackgroundColor="@color/color_e7f7ed" />

        <TextView
            style="@style/RowLabelStyle"
            android:text="@string/auto_scroll" />

        <ImageView
            style="@style/RowChevronStyle"
            android:contentDescription="@null" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowLayout"
        style="@style/SettingRowStyle">

        <com.ui.baselib.widget.view.UiImageView
            style="@style/SettingRowIconStyle"
            android:contentDescription="@null"
            android:src="@drawable/ic_app_pages"
            app:tint="@color/color_ff784f"
            app:uiBackgroundColor="@color/color_fff0e9" />

        <TextView
            style="@style/RowLabelStyle"
            android:text="@string/page_layout" />

        <TextView
            android:id="@+id/tvLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_6sdp"
            android:fontFamily="@font/nt_400"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_10sdp"
            tools:text="Vertical" />

        <ImageView
            style="@style/RowChevronStyle"
            android:contentDescription="@null" />
    </LinearLayout>

</com.ui.baselib.widget.layout.UiLinearLayout>
