<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/BottomSheetAppStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/_10sdp"
    tools:context=".ui.main.reader.pdf.sheet.ReadingModeBottomSheet"
    android:background="@drawable/bg_surface_card_r22sdp_22sdp_0_0"
    android:clipToOutline="true">

    <include
        android:id="@+id/header"
        layout="@layout/layout_sheet_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_8sdp"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/cardNormal"
            android:layout_width="0dp"
            android:layout_height="@dimen/_68sdp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_xffffff_r13sdp"
            android:foreground="@drawable/stroke_r13sdp_st1sdp_stroke"
            android:clipToOutline="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_800"
                android:text="@string/theme_sample"
                android:textColor="#20243A"
                android:textSize="@dimen/_17sdp" />

            <TextView
                android:id="@+id/tvNormal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                android:fontFamily="@font/nunito_700"
                android:text="@string/theme_normal"
                android:textColor="#20243A"
                android:textSize="@dimen/_10sdp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardNight"
            android:layout_width="0dp"
            android:layout_height="@dimen/_68sdp"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_x1b1d2a_r13sdp"
            android:foreground="@drawable/stroke_r13sdp_st1sdp_stroke"
            android:clipToOutline="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_800"
                android:text="@string/theme_sample"
                android:textColor="#D9DBE6"
                android:textSize="@dimen/_17sdp" />

            <TextView
                android:id="@+id/tvNight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                android:fontFamily="@font/nunito_700"
                android:text="@string/theme_night"
                android:textColor="#D9DBE6"
                android:textSize="@dimen/_10sdp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardSepia"
            android:layout_width="0dp"
            android:layout_height="@dimen/_68sdp"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_xf5ecd9_r13sdp"
            android:foreground="@drawable/stroke_r13sdp_st1sdp_stroke"
            android:clipToOutline="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_800"
                android:text="@string/theme_sample"
                android:textColor="#5B4636"
                android:textSize="@dimen/_17sdp" />

            <TextView
                android:id="@+id/tvSepia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                android:fontFamily="@font/nunito_700"
                android:text="@string/theme_sepia"
                android:textColor="#5B4636"
                android:textSize="@dimen/_10sdp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowTextView"
        style="@style/SettingRowStyle">

        <ImageView
            style="@style/SettingRowIconStyle"
            android:contentDescription="@null"
            android:src="@drawable/ic_app_reading"
            app:tint="@color/color_3984ff"
            android:background="@drawable/bg_eaf2ff_r9sdp"
            android:clipToOutline="true" />

        <TextView
            style="@style/RowLabelStyle"
            android:text="@string/text_view" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_6sdp"
            android:fontFamily="@font/nunito_600"
            android:text="@string/text_view_desc"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_10sdp" />

        <ImageView
            style="@style/RowChevronStyle"
            android:contentDescription="@null" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowReadAloud"
        style="@style/SettingRowStyle">

        <ImageView
            style="@style/SettingRowIconStyle"
            android:contentDescription="@null"
            android:src="@drawable/ic_app_volume"
            app:tint="@color/color_9254e8"
            android:background="@drawable/bg_f2eafe_r9sdp"
            android:clipToOutline="true" />

        <TextView
            style="@style/RowLabelStyle"
            android:text="@string/read_aloud" />

        <ImageView
            style="@style/RowChevronStyle"
            android:contentDescription="@null" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowAutoScroll"
        style="@style/SettingRowStyle">

        <ImageView
            style="@style/SettingRowIconStyle"
            android:contentDescription="@null"
            android:src="@drawable/ic_app_arrowr"
            app:tint="@color/color_35ac71"
            android:background="@drawable/bg_e7f7ed_r9sdp"
            android:clipToOutline="true" />

        <TextView
            style="@style/RowLabelStyle"
            android:text="@string/auto_scroll" />

        <ImageView
            style="@style/RowChevronStyle"
            android:contentDescription="@null" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowLayout"
        style="@style/SettingRowStyle">

        <ImageView
            style="@style/SettingRowIconStyle"
            android:contentDescription="@null"
            android:src="@drawable/ic_app_pages"
            app:tint="@color/color_ff784f"
            android:background="@drawable/bg_fff0e9_r9sdp"
            android:clipToOutline="true" />

        <TextView
            style="@style/RowLabelStyle"
            android:text="@string/page_layout" />

        <TextView
            android:id="@+id/tvLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_6sdp"
            android:fontFamily="@font/nunito_600"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_10sdp"
            tools:text="Vertical" />

        <ImageView
            style="@style/RowChevronStyle"
            android:contentDescription="@null" />
    </LinearLayout>

</LinearLayout>
