<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/_9sdp"
    android:background="@drawable/bg_surface_card">

    <TextView
        android:id="@+id/tvNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_12sdp"
        android:layout_marginBottom="@dimen/_8sdp"
        android:fontFamily="@font/nunito_800"
        android:gravity="center"
        android:textColor="@color/text_on_selected"
        android:textSize="@dimen/_10sdp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/btnAction"
        style="@style/ButtonAppStyle"
        android:layout_marginHorizontal="@dimen/_12sdp"
        android:layout_marginBottom="@dimen/_10sdp"
        android:layout_width="match_parent"
        tools:text="Merge 3 files · 16 pages"
        android:background="@drawable/bg_button_primary"
        android:elevation="@dimen/_5sdp"
        android:outlineSpotShadowColor="@color/primary_30"
        android:outlineAmbientShadowColor="@color/primary_20"
        android:textColor="@color/white" />

</LinearLayout>
