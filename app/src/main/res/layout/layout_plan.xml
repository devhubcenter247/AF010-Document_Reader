<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingTop="@dimen/_9sdp">

    <com.ui.baselib.widget.layout.UiLinearLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_13sdp"
        android:paddingVertical="@dimen/_11sdp"
        app:uiBackgroundColor="@color/color_surface_card"
        app:uiCornerRadius="@dimen/_14sdp"
        app:uiStrokeColor="@color/color_stroke"
        app:uiStrokeWidth="@dimen/_1sdp">

        <ImageView
            android:id="@+id/ivRadio"
            android:layout_width="@dimen/_17sdp"
            android:layout_height="@dimen/_17sdp"
            android:contentDescription="@null"
            android:src="@drawable/ic_app_radio_off" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_11sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nt_600"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_12sdp"
                tools:text="Yearly" />

            <TextView
                android:id="@+id/tvLine1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:fontFamily="@font/nt_400"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_9sdp"
                tools:text="3-day free trial, then $29.99 a year" />

            <TextView
                android:id="@+id/tvLine2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nt_400"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_9sdp"
                tools:text="Equal to $2.50 / month" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nt_600"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_13sdp"
                tools:text="$29.99" />

            <TextView
                android:id="@+id/tvPeriod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nt_400"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_9sdp"
                tools:text="per year" />
        </LinearLayout>
    </com.ui.baselib.widget.layout.UiLinearLayout>

    <com.ui.baselib.widget.view.UiTextView
        android:id="@+id/tvBadge"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_17sdp"
        android:layout_gravity="top|end"
        android:layout_marginEnd="@dimen/_11sdp"
        android:layout_marginTop="@dimen/_minus8sdp"
        android:fontFamily="@font/nt_600"
        android:gravity="center"
        android:paddingHorizontal="@dimen/_8sdp"
        android:textSize="@dimen/_9sdp"
        android:visibility="gone"
        app:uiBackgroundColor="@color/accent"
        app:uiCornerRadius="@dimen/_8sdp"
        app:uiTextColor="@color/on_accent"
        tools:text="Save 58%"
        tools:visibility="visible" />

</FrameLayout>
