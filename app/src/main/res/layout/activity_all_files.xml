<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app"
    android:orientation="vertical"
    tools:context=".ui.main.documents.AllFilesActivity">

    <include
        android:id="@+id/bar"
        layout="@layout/layout_screen_bar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_3sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_15sdp">

        <include
            android:id="@+id/segmentTab"
            layout="@layout/layout_segment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnSort"
            android:layout_width="@dimen/_37sdp"
            android:layout_height="@dimen/_37sdp"
            android:layout_marginStart="@dimen/_8sdp"
            android:background="@drawable/bg_square_button"
            android:contentDescription="@string/sort"
            android:elevation="@dimen/_3sdp"
            android:foreground="?attr/selectableItemBackground"
            android:outlineAmbientShadowColor="@color/color_shadow"
            android:outlineSpotShadowColor="@color/color_shadow"
            android:padding="@dimen/_10sdp"
            android:src="@drawable/ic_fo_sort"
            app:tint="@color/text_primary" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcvTypes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:overScrollMode="never"
        android:paddingHorizontal="@dimen/_15sdp"
        android:paddingTop="@dimen/_11sdp"
        android:paddingBottom="@dimen/_5sdp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_filter_chip" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcvDocuments"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/_15sdp"
            android:paddingTop="@dimen/_6sdp"
            android:paddingBottom="@dimen/_20sdp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_document" />

        <include
            android:id="@+id/emptyList"
            layout="@layout/layout_empty_shelf"
            android:visibility="gone" />

        <include
            android:id="@+id/emptyState"
            layout="@layout/layout_empty_state"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
