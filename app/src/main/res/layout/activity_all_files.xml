<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app"
    android:orientation="vertical"
    tools:context=".ui.main.documents.AllFilesActivity">

    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/_15sdp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcvTypes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_9sdp"
                android:layout_marginTop="@dimen/_9sdp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="2"
                tools:itemCount="4"
                tools:listitem="@layout/item_browse_type" />

            <TextView
                android:id="@+id/tvFolders"
                style="@style/TextSectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/_15sdp"
                android:paddingTop="@dimen/_13sdp"
                android:paddingBottom="@dimen/_7sdp"
                android:text="@string/folders" />

            <com.ui.baselib.widget.layout.UiFrameLayout
                android:id="@+id/layoutFolders"
                style="@style/CardAppStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_13sdp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rcvFolders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_folder" />
            </com.ui.baselib.widget.layout.UiFrameLayout>

            <TextView
                style="@style/TextSectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/_15sdp"
                android:paddingTop="@dimen/_13sdp"
                android:paddingBottom="@dimen/_7sdp"
                android:text="@string/other_types" />

            <com.ui.baselib.widget.view.UiTextView
                android:id="@+id/btnTxt"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_27sdp"
                android:layout_marginStart="@dimen/_13sdp"
                android:fontFamily="@font/nt_500"
                android:gravity="center"
                android:paddingHorizontal="@dimen/_11sdp"
                android:textSize="@dimen/_10sdp"
                app:uiBackgroundColor="@color/color_surface_card"
                app:uiCornerRadius="@dimen/_13sdp"
                app:uiStrokeColor="@color/color_stroke"
                app:uiStrokeWidth="@dimen/_1sdp"
                app:uiTextColor="@color/text_primary"
                tools:text="TXT  7" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
