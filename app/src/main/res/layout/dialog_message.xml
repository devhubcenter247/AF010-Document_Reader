<?xml version="1.0" encoding="utf-8"?>
<!-- A message from the mascot (a red warning badge when something failed) with one or two answers. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:clipToPadding="false"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/_17sdp"
    android:paddingTop="@dimen/_18sdp"
    android:paddingBottom="@dimen/_15sdp"
    tools:context=".ui.dialog.MessageDialog">

    <FrameLayout
        android:layout_width="@dimen/_77sdp"
        android:layout_height="@dimen/_80sdp"
        android:importantForAccessibility="noHideDescendants">

        <ImageView
            android:layout_width="@dimen/_54sdp"
            android:layout_height="@dimen/_67sdp"
            android:layout_gravity="center"
            android:src="@drawable/ic_mascot_smile" />

        <ImageView
            android:id="@+id/ivAlert"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_alert_badge"
            android:padding="@dimen/_7sdp"
            android:src="@drawable/ic_fo_alert"
            android:visibility="gone"
            app:tint="@color/white"
            tools:visibility="visible" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8sdp"
        android:fontFamily="@font/nunito_600"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/_15sdp" />

    <TextView
        android:id="@+id/tvMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_5sdp"
        android:fontFamily="@font/nunito_400"
        android:gravity="center"
        android:lineSpacingMultiplier="1.15"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/_10sdp" />

    <TextView
        android:id="@+id/btnConfirm"
        style="@style/DialogPrimaryButton"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/_14sdp"
        tools:text="Okay" />

    <TextView
        android:id="@+id/btnCancel"
        style="@style/DialogGhostButton"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/_2sdp"
        android:visibility="gone"
        tools:text="Delete this file"
        tools:visibility="visible" />
</LinearLayout>
