<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- The SDK plays the slides: transitions, animations, links, pen and eraser -->
    <com.editor.docsdk.SlideShowView
        android:id="@+id/showView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/layoutShowControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="@dimen/_11sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/_4sdp"
        android:background="@drawable/bg_pill_dark_r20sdp"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/btnShowExit"
            android:layout_width="@dimen/_31sdp"
            android:layout_height="@dimen/_31sdp"
            android:contentDescription="@string/scanner_close"
            android:padding="@dimen/_8sdp"
            android:src="@drawable/ic_app_close"
            app:tint="@color/on_primary" />

        <ImageView
            android:id="@+id/btnShowPen"
            android:layout_width="@dimen/_31sdp"
            android:layout_height="@dimen/_31sdp"
            android:contentDescription="@string/annot_pen"
            android:padding="@dimen/_8sdp"
            android:src="@drawable/ic_app_pen"
            app:tint="@color/on_primary" />

        <ImageView
            android:id="@+id/btnShowEraser"
            android:layout_width="@dimen/_31sdp"
            android:layout_height="@dimen/_31sdp"
            android:contentDescription="@string/annot_eraser"
            android:padding="@dimen/_8sdp"
            android:src="@drawable/ic_app_eraser"
            app:tint="@color/on_primary" />

        <ImageView
            android:id="@+id/btnShowPrevious"
            android:layout_width="@dimen/_31sdp"
            android:layout_height="@dimen/_31sdp"
            android:contentDescription="@string/scanner_back"
            android:padding="@dimen/_8sdp"
            android:src="@drawable/ic_app_chevl"
            app:tint="@color/on_primary" />

        <TextView
            android:id="@+id/tvShowPage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_800"
            android:paddingHorizontal="@dimen/_5sdp"
            android:textColor="@color/on_primary"
            android:textSize="@dimen/_10sdp"
            tools:text="1 / 12" />

        <ImageView
            android:id="@+id/btnShowNext"
            android:layout_width="@dimen/_31sdp"
            android:layout_height="@dimen/_31sdp"
            android:contentDescription="@string/next"
            android:padding="@dimen/_8sdp"
            android:src="@drawable/ic_app_chev"
            app:tint="@color/on_primary" />
    </LinearLayout>
</FrameLayout>
