<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/BottomSheetAppStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    tools:context=".ui.main.reader.pdf.sheet.SignatureBottomSheet"
    android:background="@drawable/bg_surface_card_r22sdp_22sdp_0_0"
    android:clipToOutline="true">

    <include
        android:id="@+id/header"
        layout="@layout/layout_sheet_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:orientation="horizontal"
        android:padding="@dimen/_3sdp"
        android:background="@drawable/bg_surface_track_r11sdp"
        android:clipToOutline="true">

        <TextView
            android:id="@+id/tabDraw"
            android:layout_width="0dp"
            android:layout_height="@dimen/_25sdp"
            android:layout_weight="1"
            android:fontFamily="@font/nt_500"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/sign_draw"
            android:textSize="@dimen/_10sdp" />

        <TextView
            android:id="@+id/tabType"
            android:layout_width="0dp"
            android:layout_height="@dimen/_25sdp"
            android:layout_weight="1"
            android:fontFamily="@font/nt_500"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/sign_type"
            android:textSize="@dimen/_10sdp" />

        <TextView
            android:id="@+id/tabImage"
            android:layout_width="0dp"
            android:layout_height="@dimen/_25sdp"
            android:layout_weight="1"
            android:fontFamily="@font/nt_500"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/annot_image"
            android:textSize="@dimen/_10sdp" />

        <TextView
            android:id="@+id/tabSaved"
            android:layout_width="0dp"
            android:layout_height="@dimen/_25sdp"
            android:layout_weight="1"
            android:fontFamily="@font/nt_500"
            android:gravity="center"
            android:maxLines="1"
            tools:text="Saved (1)"
            android:textSize="@dimen/_10sdp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/layoutPad"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_154sdp"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_11sdp"
        android:background="@drawable/bg_sign_pad_r14sdp"
        android:foreground="@drawable/stroke_r14sdp_st1sdp_checkbox_stroke_dash"
        android:clipToOutline="true">

        <!-- SignaturePad is added here -->
        <FrameLayout
            android:id="@+id/layoutDraw"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <EditText
            android:id="@+id/edtSignature"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:gravity="center"
            android:hint="@string/sign_type_hint"
            android:importantForAutofill="no"
            android:inputType="textPersonName|textCapWords"
            android:maxLines="1"
            android:paddingHorizontal="@dimen/_13sdp"
            android:textColor="@color/color_sign_ink"
            android:textColorHint="@color/color_checkbox_stroke"
            android:textSize="@dimen/_25sdp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/ivSignature"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:padding="@dimen/_13sdp"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnPickImage"
            style="@style/ButtonOutlineStyle"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_31sdp"
            android:layout_gravity="center"
            android:paddingHorizontal="@dimen/_13sdp"
            android:text="@string/sign_pick_image"
            android:visibility="gone"
            android:background="@drawable/bg_surface_card_r11sdp_st1sdp_stroke"
            android:textColor="@color/text_primary" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcvSaved"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:overScrollMode="never"
            android:padding="@dimen/_8sdp"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_signature" />

        <TextView
            android:id="@+id/tvSavedEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/nt_400"
            android:text="@string/sign_no_saved"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_10sdp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnClear"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_25sdp"
            android:layout_gravity="top|end"
            android:layout_margin="@dimen/_8sdp"
            android:fontFamily="@font/nt_500"
            android:gravity="center"
            android:paddingHorizontal="@dimen/_9sdp"
            android:text="@string/sign_clear"
            android:textSize="@dimen/_10sdp"
            android:background="@drawable/bg_white_r13sdp"
            android:textColor="@color/color_sign_ink" />

        <LinearLayout
            android:id="@+id/layoutColors"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="@dimen/_8sdp"
            android:orientation="horizontal" />
    </FrameLayout>

    <TextView
        android:id="@+id/btnSaveNext"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_33sdp"
        android:layout_marginStart="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_3sdp"
        android:drawablePadding="@dimen/_8sdp"
        android:fontFamily="@font/nt_400"
        android:gravity="center_vertical"
        android:text="@string/sign_save_next"
        android:textSize="@dimen/_11sdp"
        android:textColor="@color/text_primary"
        app:drawableStartCompat="@drawable/ic_app_checkbox_on_17sdp" />

    <TextView
        android:id="@+id/btnUse"
        style="@style/ButtonAppStyle"
        android:layout_marginBottom="@dimen/_10sdp"
        android:layout_width="match_parent"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_6sdp"
        android:text="@string/sign_use"
        android:background="@drawable/bg_grad_gradient_start_gradient_end_270_r10sdp"
        android:elevation="@dimen/_5sdp"
        android:outlineSpotShadowColor="@color/primary_30"
        android:outlineAmbientShadowColor="@color/primary_20"
        android:textColor="@color/white" />

</LinearLayout>
