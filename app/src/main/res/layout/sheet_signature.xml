<?xml version="1.0" encoding="utf-8"?>
<com.ui.baselib.widget.layout.UiLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/BottomSheetAppStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    tools:context=".ui.main.reader.pdf.sheet.SignatureBottomSheet">

    <include
        android:id="@+id/header"
        layout="@layout/layout_sheet_header" />

    <com.ui.baselib.widget.layout.UiLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:orientation="horizontal"
        android:padding="@dimen/_3sdp"
        app:uiBackgroundColor="@color/color_surface_track"
        app:uiCornerRadius="@dimen/_11sdp">

        <com.ui.baselib.widget.view.UiTextView
            android:id="@+id/tabDraw"
            android:layout_width="0dp"
            android:layout_height="@dimen/_25sdp"
            android:layout_weight="1"
            android:fontFamily="@font/nt_500"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/sign_draw"
            android:textSize="@dimen/_10sdp"
            app:uiCornerRadius="@dimen/_8sdp" />

        <com.ui.baselib.widget.view.UiTextView
            android:id="@+id/tabType"
            android:layout_width="0dp"
            android:layout_height="@dimen/_25sdp"
            android:layout_weight="1"
            android:fontFamily="@font/nt_500"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/sign_type"
            android:textSize="@dimen/_10sdp"
            app:uiCornerRadius="@dimen/_8sdp" />

        <com.ui.baselib.widget.view.UiTextView
            android:id="@+id/tabImage"
            android:layout_width="0dp"
            android:layout_height="@dimen/_25sdp"
            android:layout_weight="1"
            android:fontFamily="@font/nt_500"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/annot_image"
            android:textSize="@dimen/_10sdp"
            app:uiCornerRadius="@dimen/_8sdp" />

        <com.ui.baselib.widget.view.UiTextView
            android:id="@+id/tabSaved"
            android:layout_width="0dp"
            android:layout_height="@dimen/_25sdp"
            android:layout_weight="1"
            android:fontFamily="@font/nt_500"
            android:gravity="center"
            android:maxLines="1"
            tools:text="Saved (1)"
            android:textSize="@dimen/_10sdp"
            app:uiCornerRadius="@dimen/_8sdp" />
    </com.ui.baselib.widget.layout.UiLinearLayout>

    <com.ui.baselib.widget.layout.UiFrameLayout
        android:id="@+id/layoutPad"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_154sdp"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_11sdp"
        app:uiBackgroundColor="@color/color_sign_pad"
        app:uiCornerRadius="@dimen/_14sdp"
        app:uiStrokeColor="@color/color_checkbox_stroke"
        app:uiStrokeDashed="true"
        app:uiStrokeWidth="@dimen/_1sdp">

        <!-- SignaturePad is added here -->
        <FrameLayout
            android:id="@+id/layoutDraw"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <EditText
            android:id="@+id/edtSignature"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:gravity="center"
            android:hint="@string/sign_type_hint"
            android:importantForAutofill="no"
            android:inputType="textPersonName|textCapWords"
            android:maxLines="1"
            android:paddingHorizontal="@dimen/_13sdp"
            android:textColor="@color/color_sign_ink"
            android:textColorHint="@color/color_checkbox_stroke"
            android:textSize="@dimen/_25sdp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/ivSignature"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:padding="@dimen/_13sdp"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <com.ui.baselib.widget.view.UiTextView
            android:id="@+id/btnPickImage"
            style="@style/ButtonOutlineStyle"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_31sdp"
            android:layout_gravity="center"
            android:paddingHorizontal="@dimen/_13sdp"
            android:text="@string/sign_pick_image"
            android:visibility="gone"
            app:uiCornerRadius="@dimen/_11sdp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcvSaved"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:overScrollMode="never"
            android:padding="@dimen/_8sdp"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_signature" />

        <TextView
            android:id="@+id/tvSavedEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/nt_400"
            android:text="@string/sign_no_saved"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_10sdp"
            android:visibility="gone" />

        <com.ui.baselib.widget.view.UiTextView
            android:id="@+id/btnClear"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_25sdp"
            android:layout_gravity="top|end"
            android:layout_margin="@dimen/_8sdp"
            android:fontFamily="@font/nt_500"
            android:gravity="center"
            android:paddingHorizontal="@dimen/_9sdp"
            android:text="@string/sign_clear"
            android:textSize="@dimen/_10sdp"
            app:uiBackgroundColor="@color/white"
            app:uiCornerRadius="@dimen/_13sdp"
            app:uiTextColor="@color/color_sign_ink" />

        <LinearLayout
            android:id="@+id/layoutColors"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="@dimen/_8sdp"
            android:orientation="horizontal" />
    </com.ui.baselib.widget.layout.UiFrameLayout>

    <com.ui.baselib.widget.view.UiTextView
        android:id="@+id/btnSaveNext"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_33sdp"
        android:layout_marginStart="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_3sdp"
        android:drawablePadding="@dimen/_8sdp"
        android:fontFamily="@font/nt_400"
        android:gravity="center_vertical"
        android:text="@string/sign_save_next"
        android:textSize="@dimen/_11sdp"
        app:drawableStartCompat="@drawable/ic_app_checkbox_on"
        app:uiDrawableSize="@dimen/_17sdp"
        app:uiTextColor="@color/text_primary" />

    <com.ui.baselib.widget.view.UiTextView
        android:id="@+id/btnUse"
        style="@style/ButtonAppStyle"
        android:layout_marginBottom="@dimen/_10sdp"
        android:layout_width="match_parent"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_6sdp"
        android:text="@string/sign_use"
        app:uiShadowClipParent="force"
        app:uiShadowColor="@color/primary_30" />

</com.ui.baselib.widget.layout.UiLinearLayout>
