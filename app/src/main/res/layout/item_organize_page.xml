<?xml version="1.0" encoding="utf-8"?>
<!-- A page to organize, like every page thumbnail (showPageThumb): the page fills the card as a
     white sheet and is ringed in the file's colour, with a tick, once picked. A turned page turns
     its picture, not the sheet (OrganizePageAdapter). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/_4sdp">

    <FrameLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_115sdp"
        android:duplicateParentState="true"
        android:foreground="@drawable/bg_page_thumb">

        <ImageView
            android:id="@+id/ivPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_page_sheet"
            android:clipToOutline="true"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/ivCheck"
            android:layout_width="@dimen/_18sdp"
            android:layout_height="@dimen/_18sdp"
            android:layout_gravity="top|end"
            android:layout_margin="@dimen/_6sdp"
            android:background="@drawable/bg_circle_variant"
            android:backgroundTint="@color/primary"
            android:importantForAccessibility="no"
            android:padding="@dimen/_4sdp"
            android:src="@drawable/ic_fo_check"
            android:visibility="gone"
            app:tint="@color/on_primary"
            tools:visibility="visible" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvNumber"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_18sdp"
        android:layout_marginTop="@dimen/_4sdp"
        android:background="@drawable/bg_page_number_pill"
        android:duplicateParentState="true"
        android:fontFamily="@font/nunito_700"
        android:gravity="center"
        android:minWidth="@dimen/_18sdp"
        android:paddingHorizontal="@dimen/_6sdp"
        android:textColor="@color/text_page_number"
        android:textSize="@dimen/_10sdp"
        tools:text="1" />
</LinearLayout>
