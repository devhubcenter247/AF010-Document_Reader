<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/_3sdp">

    <com.ui.baselib.widget.layout.UiFrameLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_105sdp"
        app:uiBackgroundColor="@color/white"
        app:uiCornerRadius="@dimen/_5sdp"
        app:uiStrokeColor="@color/color_stroke"
        app:uiStrokeWidth="@dimen/_1sdp">

        <ImageView
            android:id="@+id/ivPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/_3sdp"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/ivCheck"
            android:layout_width="@dimen/_15sdp"
            android:layout_height="@dimen/_15sdp"
            android:layout_gravity="top|end"
            android:layout_margin="@dimen/_4sdp"
            android:contentDescription="@null"
            android:src="@drawable/ic_app_checkbox_on"
            android:visibility="gone"
            tools:visibility="visible" />
    </com.ui.baselib.widget.layout.UiFrameLayout>

    <TextView
        android:id="@+id/tvNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_3sdp"
        android:fontFamily="@font/nt_500"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/_9sdp"
        tools:text="1" />

</LinearLayout>
