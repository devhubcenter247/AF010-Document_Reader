<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app"
    tools:context=".ui.main.tools.ToolsFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:liftOnScroll="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/_5sdp"
            android:paddingStart="@dimen/_15sdp"
            android:paddingEnd="@dimen/_13sdp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nt_400"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/_9sdp"
                    tools:text="17 tools · all work offline" />

                <TextView
                    style="@style/TextScreenTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tools"
                    android:textSize="@dimen/_15sdp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnPro"
                style="@style/ProBadgeStyle"
                android:background="@drawable/bg_grad_gradient_start_gradient_end_315_r14sdp"
                android:textColor="@color/on_primary"
                app:drawableStartCompat="@drawable/ic_app_crown_13sdp" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/_15sdp">

            <!-- Search -->
            <LinearLayout
                style="@style/CardAppStyle"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_37sdp"
                android:layout_marginHorizontal="@dimen/_13sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/_11sdp"
                android:background="@drawable/bg_surface_card_r13sdp"
                android:foreground="@drawable/stroke_r13sdp_st1sdp_stroke"
                android:clipToOutline="true">

                <ImageView
                    android:layout_width="@dimen/_15sdp"
                    android:layout_height="@dimen/_15sdp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_app_search"
                    app:tint="@color/text_secondary" />

                <EditText
                    android:id="@+id/edtSearch"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:background="@null"
                    android:fontFamily="@font/nt_400"
                    android:hint="@string/search_tools"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="@dimen/_11sdp" />
            </LinearLayout>

            <!-- Highlights -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutHighlights"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_13sdp"
                android:layout_marginTop="@dimen/_11sdp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cardScan"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_100sdp"
                    android:layout_marginEnd="@dimen/_4sdp"
                    android:clipToPadding="false"
                    android:padding="@dimen/_10sdp"
                    app:layout_constraintEnd_toStartOf="@+id/cardSign"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:background="@drawable/bg_accent_r18sdp"
                    android:clipToOutline="true">

                    <View
                        android:layout_width="@dimen/_125sdp"
                        android:layout_height="@dimen/_125sdp"
                        android:layout_marginStart="@dimen/_minus38sdp"
                        android:layout_marginBottom="@dimen/_minus50sdp"
                        android:background="@drawable/bg_circle_white_14"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <ImageView
                        android:layout_width="@dimen/_43sdp"
                        android:layout_height="@dimen/_43sdp"
                        android:layout_marginTop="@dimen/_minus5sdp"
                        android:layout_marginEnd="@dimen/_minus5sdp"
                        android:contentDescription="@null"
                        android:src="@drawable/img_scan_paper"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvScanTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nt_600"
                        android:maxLines="1"
                        android:text="@string/scan_to_pdf"
                        android:textColor="@color/color_ink"
                        android:textSize="@dimen/_11sdp"
                        app:layout_constraintBottom_toTopOf="@+id/tvScanDesc"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/tvScanDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_8sdp"
                        android:fontFamily="@font/nt_400"
                        android:text="@string/tool_scan_highlight_desc"
                        android:textColor="@color/color_on_accent_secondary"
                        android:textSize="@dimen/_9sdp"
                        app:layout_constraintBottom_toTopOf="@+id/tvScanNow"
                        app:layout_constraintStart_toStartOf="parent" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tvScanNow"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_23sdp"
                        android:fontFamily="@font/nt_500"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/_9sdp"
                        android:text="@string/scan_now"
                        android:textSize="@dimen/_10sdp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        android:background="@drawable/bg_ink_r13sdp"
                        android:textColor="@color/on_primary"
                        app:icon="@drawable/ic_app_camera"
                        app:iconGravity="textStart"
                        app:iconPadding="@dimen/_5sdp"
                        app:iconSize="@dimen/_12sdp"
                        app:iconTint="@color/on_primary"
                        app:backgroundTint="@null"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:textAllCaps="false"
                        android:letterSpacing="0"
                        android:stateListAnimator="@null"
                        android:paddingVertical="0dp"
                        android:elevation="0dp" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <LinearLayout
                    android:id="@+id/cardSign"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_48sdp"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/_6sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/cardScan"
                    app:layout_constraintTop_toTopOf="parent"
                    android:background="@drawable/bg_grad_gradient_start_gradient_end_315_r15sdp"
                    android:clipToOutline="true">

                    <ImageView
                        android:layout_width="@dimen/_26sdp"
                        android:layout_height="@dimen/_26sdp"
                        android:contentDescription="@null"
                        android:padding="@dimen/_5sdp"
                        android:src="@drawable/ic_app_sign"
                        app:tint="@color/on_primary"
                        android:background="@drawable/bg_white_16_r9sdp"
                        android:clipToOutline="true" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_5sdp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="@font/nt_600"
                            android:maxLines="1"
                            android:text="@string/sign_pdf"
                            android:textColor="@color/on_primary"
                            android:textSize="@dimen/_9sdp" />

                        <TextView
                            android:id="@+id/tvSignDesc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="@font/nt_400"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="@string/tool_sign_desc"
                            android:textColor="@color/color_on_gradient_secondary"
                            android:textSize="@dimen/_9sdp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardCompress"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_48sdp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/_6sdp"
                    app:layout_constraintBottom_toBottomOf="@+id/cardScan"
                    app:layout_constraintEnd_toEndOf="@+id/cardSign"
                    app:layout_constraintStart_toStartOf="@+id/cardSign"
                    android:background="@drawable/bg_e0f8f3_r15sdp"
                    android:clipToOutline="true">

                    <ImageView
                        android:layout_width="@dimen/_26sdp"
                        android:layout_height="@dimen/_26sdp"
                        android:contentDescription="@null"
                        android:padding="@dimen/_5sdp"
                        android:src="@drawable/ic_app_compress"
                        app:tint="@color/on_primary"
                        android:background="@drawable/bg_14b8a6_r9sdp"
                        android:clipToOutline="true" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_5sdp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="@font/nt_600"
                            android:maxLines="1"
                            android:text="@string/tool_compress"
                            android:textColor="@color/on_accent"
                            android:textSize="@dimen/_9sdp" />

                        <TextView
                            android:id="@+id/tvCompressDesc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="@font/nt_400"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="@string/tool_compress_desc"
                            android:textColor="@color/color_on_teal_secondary"
                            android:textSize="@dimen/_9sdp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Group filter -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcvGroups"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_11sdp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:overScrollMode="never"
                android:paddingHorizontal="@dimen/_13sdp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_filter_chip" />

            <LinearLayout
                android:id="@+id/layoutSections"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
