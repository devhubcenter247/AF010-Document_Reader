<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/color_tools_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/_15sdp"
        android:paddingTop="@dimen/_8sdp"
        android:paddingEnd="@dimen/_12sdp">

        <FrameLayout
            android:layout_width="@dimen/_38sdp"
            android:layout_height="@dimen/_38sdp"
            android:background="@drawable/bg_mascot_tile"
            android:rotation="-6">

            <ImageView
                android:layout_width="@dimen/_22sdp"
                android:layout_height="@dimen/_28sdp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_mascot_smile_ink" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/DisplayTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fo_toolbox" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_500"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_11sdp"
                tools:text="17 handy tools for your files" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnPro"
            android:layout_width="@dimen/_34sdp"
            android:layout_height="@dimen/_34sdp"
            android:background="@drawable/bg_circle_pro"
            android:contentDescription="@string/fo_pro_name"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/_9sdp"
            android:src="@drawable/ic_fo_crown"
            android:visibility="gone"
            app:tint="@color/color_premium_gold"
            tools:visibility="visible" />
    </LinearLayout>

    <EditText
        android:id="@+id/edtSearch"
        style="@style/FloatingCard"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_38sdp"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_11sdp"
        android:background="@drawable/bg_search_field"
        android:drawablePadding="@dimen/_7sdp"
        android:fontFamily="@font/nunito_600"
        android:hint="@string/search_tools"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:paddingHorizontal="@dimen/_12sdp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:textSize="@dimen/_12sdp"
        app:drawableStartCompat="@drawable/ic_fo_search_16sdp"
        app:drawableTint="@color/text_secondary" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcvGroups"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_9sdp"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:overScrollMode="never"
        android:paddingHorizontal="@dimen/_15sdp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_filter_chip" />

    <FrameLayout
        android:paddingTop="@dimen/_12sdp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/_100sdp">

            <LinearLayout
                android:id="@+id/layoutSections"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/_10sdp" />
        </androidx.core.widget.NestedScrollView>


        <TextView
            android:id="@+id/tvNoTools"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_31sdp"
            android:fontFamily="@font/nunito_600"
            android:gravity="center"
            android:text="@string/fo_no_tools"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_11sdp"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
