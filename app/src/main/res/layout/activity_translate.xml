<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app"
    android:orientation="vertical"
    tools:context=".ui.main.tools.translate.TranslateActivity">

    <include
        android:id="@+id/topBar"
        layout="@layout/layout_tool_topbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_12sdp"
            android:paddingBottom="@dimen/_10sdp">

            <include
                android:id="@+id/header"
                layout="@layout/layout_tool_header" />

            <include
                android:id="@+id/file"
                layout="@layout/layout_tool_file"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_13sdp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_13sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnFrom"
                    style="@style/CardAppStyle"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_43sdp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/_11sdp"
                    android:background="@drawable/bg_surface_card_r13sdp"
                    android:foreground="@drawable/stroke_r13sdp_st1sdp_stroke"
                    android:clipToOutline="true">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_600"
                        android:text="@string/translate_from"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/_9sdp" />

                    <TextView
                        android:id="@+id/tvFrom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/nunito_800"
                        android:maxLines="1"
                        android:textSize="@dimen/_11sdp"
                        app:drawableTint="@color/text_secondary"
                        tools:text="Spanish"
                        android:textColor="@color/text_primary"
                        app:drawableEndCompat="@drawable/ic_app_chevd_12sdp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/_28sdp"
                    android:layout_height="@dimen/_28sdp"
                    android:layout_marginHorizontal="@dimen/_6sdp"
                    android:contentDescription="@null"
                    android:padding="@dimen/_7sdp"
                    android:src="@drawable/ic_app_arrowr"
                    app:tint="@color/text_on_selected"
                    android:background="@drawable/bg_bg_selected_r14sdp"
                    android:clipToOutline="true" />

                <LinearLayout
                    android:id="@+id/btnTo"
                    style="@style/CardAppStyle"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_43sdp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/_11sdp"
                    android:background="@drawable/bg_surface_card_r13sdp"
                    android:foreground="@drawable/stroke_r13sdp_st1sdp_stroke"
                    android:clipToOutline="true">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_600"
                        android:text="@string/translate_to_short"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/_9sdp" />

                    <TextView
                        android:id="@+id/tvTo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/nunito_800"
                        android:maxLines="1"
                        android:textSize="@dimen/_11sdp"
                        app:drawableTint="@color/text_secondary"
                        tools:text="Spanish"
                        android:textColor="@color/text_primary"
                        app:drawableEndCompat="@drawable/ic_app_chevd_12sdp" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                style="@style/CardAppStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_13sdp"
                android:orientation="horizontal"
                android:padding="@dimen/_11sdp"
                android:background="@drawable/bg_surface_card_r13sdp"
                android:foreground="@drawable/stroke_r13sdp_st1sdp_stroke"
                android:clipToOutline="true">

                <ImageView
                    android:layout_width="@dimen/_17sdp"
                    android:layout_height="@dimen/_17sdp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_app_download"
                    app:tint="@color/text_on_selected" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_9sdp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_800"
                        android:text="@string/language_pack_title"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/_10sdp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_3sdp"
                        android:fontFamily="@font/nunito_600"
                        android:text="@string/language_pack_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/_9sdp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/action"
        layout="@layout/layout_tool_action" />

</LinearLayout>
