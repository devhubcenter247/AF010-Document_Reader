<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app"
    android:orientation="vertical"
    tools:context=".ui.main.scan.fragment.ScanFiltersFragment">

    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/color_surface_track">

        <ImageView
            android:id="@+id/ivPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="@dimen/_46sdp"
            android:layout_marginVertical="@dimen/_15sdp"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/btnPrevious"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="@dimen/_11sdp"
            android:contentDescription="@null"
            android:padding="@dimen/_7sdp"
            android:src="@drawable/ic_app_chevl"
            android:background="@drawable/bg_surface_card_r14sdp"
            android:clipToOutline="true" />

        <ImageView
            android:id="@+id/btnNext"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="@dimen/_11sdp"
            android:contentDescription="@null"
            android:padding="@dimen/_7sdp"
            android:src="@drawable/ic_app_chev"
            android:background="@drawable/bg_surface_card_r14sdp"
            android:clipToOutline="true" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/primary"
            android:visibility="gone" />
    </FrameLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcvFilters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_surface_card"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:overScrollMode="never"
        android:paddingHorizontal="@dimen/_8sdp"
        android:paddingTop="@dimen/_11sdp"
        android:paddingBottom="@dimen/_9sdp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_scan_filter" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="@dimen/_3sdp"
        android:background="@drawable/bg_surface_card_line_top_1sdp_stroke">

        <TextView
            android:id="@+id/btnCrop"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:drawablePadding="@dimen/_3sdp"
            android:fontFamily="@font/nunito_700"
            android:gravity="center"
            android:paddingVertical="@dimen/_11sdp"
            android:text="@string/scan_crop"
            android:textSize="@dimen/_9sdp"
            app:drawableTint="@color/text_primary"
            android:textColor="@color/text_primary"
            app:drawableTopCompat="@drawable/ic_app_crop_17sdp" />

        <TextView
            android:id="@+id/btnRotate"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:drawablePadding="@dimen/_3sdp"
            android:fontFamily="@font/nunito_700"
            android:gravity="center"
            android:paddingVertical="@dimen/_11sdp"
            android:text="@string/scanner_rotate"
            android:textSize="@dimen/_9sdp"
            app:drawableTint="@color/text_primary"
            android:textColor="@color/text_primary"
            app:drawableTopCompat="@drawable/ic_app_rotate_17sdp" />

        <TextView
            android:id="@+id/btnCleanUp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:drawablePadding="@dimen/_3sdp"
            android:fontFamily="@font/nunito_700"
            android:gravity="center"
            android:paddingVertical="@dimen/_11sdp"
            android:text="@string/scan_clean_up"
            android:textSize="@dimen/_9sdp"
            app:drawableTint="@color/text_primary"
            android:textColor="@color/text_primary"
            app:drawableTopCompat="@drawable/ic_app_eraser_17sdp" />

        <TextView
            android:id="@+id/btnAddPage"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:drawablePadding="@dimen/_3sdp"
            android:fontFamily="@font/nunito_700"
            android:gravity="center"
            android:paddingVertical="@dimen/_11sdp"
            android:text="@string/scanner_add_page"
            android:textSize="@dimen/_9sdp"
            app:drawableTint="@color/text_primary"
            android:textColor="@color/text_primary"
            app:drawableTopCompat="@drawable/ic_app_plus_17sdp" />

        <TextView
            android:id="@+id/btnDelete"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:drawablePadding="@dimen/_3sdp"
            android:fontFamily="@font/nunito_700"
            android:gravity="center"
            android:paddingVertical="@dimen/_11sdp"
            android:text="@string/file_action_delete"
            android:textSize="@dimen/_9sdp"
            app:drawableTint="@color/color_error"
            android:textColor="@color/color_error"
            app:drawableTopCompat="@drawable/ic_app_trash_17sdp" />

    </LinearLayout>

</LinearLayout>
