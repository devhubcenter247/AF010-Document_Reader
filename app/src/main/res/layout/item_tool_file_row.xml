<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/CardAppStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/_6sdp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/_8sdp"
    android:paddingEnd="@dimen/_3sdp"
    android:paddingVertical="@dimen/_8sdp"
    android:background="@drawable/bg_surface_card_r10sdp"
    android:foreground="@drawable/stroke_r10sdp_st1sdp_stroke"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/ivDrag"
        android:layout_width="@dimen/_15sdp"
        android:layout_height="@dimen/_25sdp"
        android:layout_marginEnd="@dimen/_6sdp"
        android:contentDescription="@null"
        android:src="@drawable/ic_app_grip"
        app:tint="@color/color_icon_muted" />

    <ImageView
        android:id="@+id/ivType"
        android:layout_width="@dimen/_23sdp"
        android:layout_height="@dimen/_28sdp"
        android:contentDescription="@null"
        tools:src="@drawable/ic_file_pdf" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_8sdp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:fontFamily="@font/nt_500"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/_11sdp"
            tools:text="Lease-agreement.pdf" />

        <TextView
            android:id="@+id/tvMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:fontFamily="@font/nt_400"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_9sdp"
            tools:text="1.1 MB · 12 pages" />
    </LinearLayout>

    <ImageView
        android:id="@+id/btnRemove"
        android:layout_width="@dimen/_27sdp"
        android:layout_height="@dimen/_27sdp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/scanner_close"
        android:padding="@dimen/_7sdp"
        android:src="@drawable/ic_app_close"
        app:tint="@color/text_secondary" />

</LinearLayout>
