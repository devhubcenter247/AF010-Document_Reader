<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_3sdp"
    android:clickable="true"
    android:focusable="true"
    android:padding="@dimen/_10sdp"
    android:background="@drawable/bg_surface_card_r10sdp"
    android:foreground="@drawable/stroke_r10sdp_st1sdp_stroke"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/ivIcon"
        android:layout_width="@dimen/_27sdp"
        android:layout_height="@dimen/_27sdp"
        android:contentDescription="@null"
        android:padding="@dimen/_5sdp"
        app:tint="@color/white"
        android:src="@drawable/ic_use_case_work"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:background="@drawable/bg_x3582ff_r8sdp"
        android:clipToOutline="true" />

    <ImageView
        android:id="@+id/ivCheck"
        android:layout_width="@dimen/_15sdp"
        android:layout_height="@dimen/_15sdp"
        android:contentDescription="@null"
        android:src="@drawable/ic_check_circle"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_7sdp"
        android:fontFamily="@font/nt_600"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/_11sdp"
        app:layout_constraintTop_toBottomOf="@+id/ivIcon"
        tools:text="Work" />

    <TextView
        android:id="@+id/tvDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_2sdp"
        android:lines="2"
        android:gravity="center_vertical"
        android:fontFamily="@font/nt_400"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/_9sdp"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        tools:text="Contracts, reports, signing" />

</androidx.constraintlayout.widget.ConstraintLayout>
