<?xml version="1.0" encoding="utf-8"?>
<!-- Leaving the app: the mascot asks, Stay is the main answer. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:clipToPadding="false"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/_17sdp"
    android:paddingTop="@dimen/_18sdp"
    android:paddingBottom="@dimen/_15sdp"
    tools:context=".ui.dialog.QuitDialog">

    <ImageView
        android:layout_width="@dimen/_54sdp"
        android:layout_height="@dimen/_67sdp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_mascot_smile" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8sdp"
        android:fontFamily="@font/nunito_600"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/_15sdp"
        android:text="@string/fo_quit_title" />

    <TextView
        android:id="@+id/tvQuitMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_5sdp"
        android:fontFamily="@font/nunito_400"
        android:gravity="center"
        android:lineSpacingMultiplier="1.15"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/_10sdp"
        android:text="@string/fo_quit_message" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_14sdp"
        android:clipToPadding="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnExit"
            style="@style/DialogSoftButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/fo_exit" />

        <TextView
            android:id="@+id/btnStay"
            style="@style/DialogPrimaryButton"
            android:layout_width="0dp"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_weight="1.3"
            android:text="@string/fo_stay" />
    </LinearLayout>
</LinearLayout>
