<?xml version="1.0" encoding="utf-8"?>
<com.ui.baselib.widget.layout.UiLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/DialogAppStyle"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/_17sdp"
    tools:context=".ui.dialog.QuitDialog">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/nt_600"
        android:text="@string/quit_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/_13sdp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6sdp"
        android:fontFamily="@font/nt_400"
        android:text="@string/quit_message"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/_9sdp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_13sdp"
        android:orientation="horizontal">

        <com.ui.baselib.widget.view.UiTextView
            android:id="@+id/btnExit"
            style="@style/ButtonOutlineStyle"
            android:layout_width="0dp"
            android:layout_marginEnd="@dimen/_4sdp"
            android:layout_weight="1"
            android:text="@string/quit_exit" />

        <com.ui.baselib.widget.view.UiTextView
            android:id="@+id/btnStay"
            style="@style/ButtonAppStyle"
            android:layout_width="0dp"
            android:layout_marginStart="@dimen/_4sdp"
            android:layout_weight="1"
            android:text="@string/quit_stay"
            app:uiShadowClipParent="force"
            app:uiShadowColor="@color/primary_30" />
    </LinearLayout>

</com.ui.baselib.widget.layout.UiLinearLayout>
