<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/DialogAppStyle"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/_17sdp"
    tools:context=".ui.dialog.OpenPasswordDialog"
    android:background="@drawable/bg_surface_card_r18sdp"
    android:clipToOutline="true">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/nunito_800"
        android:text="@string/protected_file"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/_13sdp"
        tools:text="Protected file" />

    <TextView
        android:id="@+id/tvMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6sdp"
        android:fontFamily="@font/nunito_600"
        android:lineSpacingMultiplier="1.2"
        android:text="@string/enter_password_to_open"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/_9sdp"
        tools:text="Enter the password to open" />

    <LinearLayout
        style="@style/CardAppStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_11sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_8sdp"
        android:paddingVertical="@dimen/_8sdp"
        android:background="@drawable/bg_surface_card_r10sdp"
        android:foreground="@drawable/stroke_r10sdp_st1sdp_stroke"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/ivType"
            android:layout_width="@dimen/_25sdp"
            android:layout_height="@dimen/_25sdp"
            android:contentDescription="@null"
            tools:src="@drawable/ic_file_pdf" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_9sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:fontFamily="@font/nunito_700"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_11sdp"
                tools:text="Bank-statement.pdf" />

            <TextView
                android:id="@+id/tvMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                android:fontFamily="@font/nunito_600"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_9sdp"
                tools:text="Protected · 1.2 MB" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_11sdp"
        android:fontFamily="@font/nunito_700"
        android:text="@string/tool_password"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/_10sdp" />

    <LinearLayout
        android:id="@+id/layoutPassword"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_37sdp"
        android:layout_marginTop="@dimen/_5sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="@dimen/_3sdp"
        android:paddingStart="@dimen/_11sdp"
        android:background="@drawable/bg_surface_card_r11sdp"
        android:foreground="@drawable/stroke_r11sdp_st1sdp_primary"
        android:clipToOutline="true">

        <EditText
            android:id="@+id/edtPassword"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="@font/nunito_600"
            android:hint="@string/tool_password"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="@dimen/_10sdp" />

        <ImageView
            android:id="@+id/btnShow"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:padding="@dimen/_8sdp"
            android:src="@drawable/ic_app_eye"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_5sdp"
        android:fontFamily="@font/nunito_600"
        android:text="@string/error_file_password_incorrect"
        android:textColor="@color/color_error"
        android:textSize="@dimen/_9sdp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_13sdp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancel"
            style="@style/ButtonOutlineStyle"
            android:layout_width="0dp"
            android:layout_marginEnd="@dimen/_4sdp"
            android:layout_weight="1"
            android:text="@string/file_action_cancel"
            android:background="@drawable/bg_surface_card_r10sdp_st1sdp_stroke"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/btnConfirm"
            style="@style/ButtonAppStyle"
            android:layout_width="0dp"
            android:layout_marginStart="@dimen/_4sdp"
            android:layout_weight="1"
            android:text="@string/open"
            android:background="@drawable/bg_button_primary"
            android:elevation="@dimen/_5sdp"
            android:outlineSpotShadowColor="@color/primary_30"
            android:outlineAmbientShadowColor="@color/primary_20"
            android:textColor="@color/white" />
    </LinearLayout>

</LinearLayout>
