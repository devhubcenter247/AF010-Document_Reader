<?xml version="1.0" encoding="utf-8"?>
<!-- A locked file: its lock, the password field (red when the last try was wrong), Cancel / Open. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:clipToPadding="false"
    android:gravity="start"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/_17sdp"
    android:paddingTop="@dimen/_17sdp"
    android:paddingBottom="@dimen/_15sdp"
    tools:context=".ui.dialog.OpenPasswordDialog">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivType"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:background="@drawable/bg_rounded_panel"
            android:backgroundTint="@color/color_file_excel_bg"
            android:importantForAccessibility="no"
            android:padding="@dimen/_11sdp"
            android:rotation="-5"
            android:src="@drawable/ic_fo_lock"
            app:tint="@color/color_file_excel" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_11sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_600"
                android:text="@string/fo_locked_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_15sdp" />

            <TextView
                android:id="@+id/tvMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:fontFamily="@font/nunito_400"
                android:maxLines="2"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_10sdp"
                tools:text="Enter the password for Tenant ID copy.pdf" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvName"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvMeta"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layoutPassword"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_43sdp"
        android:layout_marginTop="@dimen/_12sdp"
        android:addStatesFromChildren="true"
        android:background="@drawable/bg_field"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/_12sdp"
        android:paddingEnd="@dimen/_4sdp">

        <EditText
            android:id="@+id/edtPassword"
            style="@style/FieldInput"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:fontFamily="@font/nunito_600"
            android:hint="@string/password_hint"
            android:imeOptions="actionDone"
            android:inputType="textPassword" />

        <ImageView
            android:id="@+id/btnShow"
            android:layout_width="@dimen/_34sdp"
            android:layout_height="@dimen/_34sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/fo_show_password"
            android:padding="@dimen/_9sdp"
            android:src="@drawable/ic_fo_eye"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_5sdp"
        android:drawablePadding="@dimen/_5sdp"
        android:fontFamily="@font/nunito_600"
        android:text="@string/fo_wrong_password"
        android:textColor="@color/color_file_pdf"
        android:textSize="@dimen/_10sdp"
        android:visibility="gone"
        app:drawableStartCompat="@drawable/ic_fo_info_17sdp"
        app:drawableTint="@color/color_file_pdf"
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_14sdp"
        android:clipToPadding="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancel"
            style="@style/DialogSoftButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/file_action_cancel" />

        <TextView
            android:id="@+id/btnConfirm"
            style="@style/DialogPrimaryButton"
            android:layout_width="0dp"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_weight="1.3"
            android:text="@string/fo_open" />
    </LinearLayout>
</LinearLayout>
