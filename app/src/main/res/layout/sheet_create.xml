<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/_15sdp"
    android:paddingBottom="@dimen/_18sdp">

    <View
        android:layout_width="@dimen/_34sdp"
        android:layout_height="@dimen/_4sdp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/_8sdp"
        android:background="@drawable/bg_handle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_3sdp"
        android:layout_marginTop="@dimen/_14sdp"
        android:fontFamily="@font/nunito_800"
        android:letterSpacing="-0.015"
        android:text="@string/fo_create_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/_20sdp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_3sdp"
        android:layout_marginTop="@dimen/_2sdp"
        android:fontFamily="@font/nunito_600"
        android:text="@string/fo_create_location"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/_10sdp" />

    <LinearLayout
        android:id="@+id/cardScan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_11sdp"
        android:background="@drawable/bg_card_primary"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/_14sdp">

        <ImageView
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:background="@drawable/bg_glass_tile"
            android:importantForAccessibility="no"
            android:padding="@dimen/_10sdp"
            android:rotation="-5"
            android:src="@drawable/ic_fo_camera"
            app:tint="@color/color_ink" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_11sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_800"
                android:text="@string/fo_scan_document"
                android:textColor="@color/on_primary"
                android:textSize="@dimen/_13sdp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:fontFamily="@font/nunito_600"
                android:text="@string/fo_scan_document_desc"
                android:textColor="@color/color_on_primary_soft"
                android:textSize="@dimen/_10sdp" />
        </LinearLayout>

        <ImageView
            android:layout_width="@dimen/_16sdp"
            android:layout_height="@dimen/_16sdp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_fo_chevron"
            app:tint="@color/on_primary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cardImages"
        style="@style/FloatingCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_11sdp"
        android:background="@drawable/bg_benefits_card"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_14sdp"
        android:paddingVertical="@dimen/_11sdp">

        <ImageView
            android:layout_width="@dimen/_35sdp"
            android:layout_height="@dimen/_35sdp"
            android:background="@drawable/bg_soft_image_tile"
            android:importantForAccessibility="no"
            android:padding="@dimen/_9sdp"
            android:src="@drawable/ic_fo_photo"
            app:tint="@color/color_file_image" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_11sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_800"
                android:text="@string/photos_to_pdf"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_12sdp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:fontFamily="@font/nunito_600"
                android:text="@string/fo_photos_desc"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_10sdp" />
        </LinearLayout>

        <ImageView
            android:layout_width="@dimen/_16sdp"
            android:layout_height="@dimen/_16sdp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_fo_chevron"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_3sdp"
        android:layout_marginTop="@dimen/_14sdp"
        android:fontFamily="@font/nunito_800"
        android:text="@string/fo_blank_page"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/_10sdp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_9sdp"
        android:orientation="horizontal">

        <include
            android:id="@+id/cardWord"
            layout="@layout/layout_blank_tile"
            android:layout_width="0dp"
            android:layout_height="@dimen/_80sdp"
            android:layout_weight="1" />

        <include
            android:id="@+id/cardExcel"
            layout="@layout/layout_blank_tile"
            android:layout_width="0dp"
            android:layout_height="@dimen/_80sdp"
            android:layout_marginHorizontal="@dimen/_8sdp"
            android:layout_weight="1" />

        <include
            android:id="@+id/cardPpt"
            layout="@layout/layout_blank_tile"
            android:layout_width="0dp"
            android:layout_height="@dimen/_80sdp"
            android:layout_weight="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnNotNow"
        style="@style/GhostButton"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/_9sdp"
        android:text="@string/not_now" />
</LinearLayout>
