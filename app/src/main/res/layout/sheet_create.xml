<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/BottomSheetAppStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/_10sdp"
    android:background="@drawable/bg_surface_card_r22sdp_22sdp_0_0"
    android:clipToOutline="true">

    <include
        android:id="@+id/header"
        layout="@layout/layout_sheet_header" />

    <LinearLayout
        android:id="@+id/cardScan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/_13sdp"
        android:background="@drawable/bg_accent_r15sdp"
        android:clipToOutline="true">

        <ImageView
            android:layout_width="@dimen/_35sdp"
            android:layout_height="@dimen/_35sdp"
            android:contentDescription="@null"
            android:padding="@dimen/_8sdp"
            android:src="@drawable/ic_app_scan"
            app:tint="@color/on_accent"
            android:background="@drawable/bg_white_28_r13sdp"
            android:clipToOutline="true" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_11sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nt_600"
                android:text="@string/scan_document"
                android:textColor="@color/on_accent"
                android:textSize="@dimen/_12sdp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nt_400"
                android:text="@string/scan_document_desc"
                android:textColor="@color/color_on_accent_secondary"
                android:textSize="@dimen/_9sdp" />
        </LinearLayout>

        <ImageView
            android:layout_width="@dimen/_17sdp"
            android:layout_height="@dimen/_17sdp"
            android:contentDescription="@null"
            android:src="@drawable/ic_app_arrowr"
            app:tint="@color/on_accent" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cardImages"
        style="@style/CardAppStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_13sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_13sdp"
        android:paddingVertical="@dimen/_9sdp"
        android:background="@drawable/bg_surface_card_r15sdp"
        android:foreground="@drawable/stroke_r15sdp_st1sdp_stroke"
        android:clipToOutline="true">

        <ImageView
            android:layout_width="@dimen/_33sdp"
            android:layout_height="@dimen/_33sdp"
            android:contentDescription="@null"
            android:src="@drawable/ic_app_tool_images_to_pdf" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_11sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nt_600"
                android:text="@string/images_to_pdf"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_11sdp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nt_400"
                android:text="@string/images_to_pdf_desc"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_9sdp" />
        </LinearLayout>

        <ImageView style="@style/RowChevronStyle" android:contentDescription="@null" />
    </LinearLayout>

    <TextView
        style="@style/TextSectionCaps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_17sdp"
        android:text="@string/new_blank_document" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_11sdp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/cardWord"
            style="@style/CardAppStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_4sdp"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_3sdp"
            android:paddingVertical="@dimen/_11sdp"
            android:background="@drawable/bg_surface_card_r13sdp"
            android:foreground="@drawable/stroke_r13sdp_st1sdp_stroke"
            android:clipToOutline="true">

            <ImageView
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_33sdp"
                android:contentDescription="@null"
                android:src="@drawable/ic_file_word" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:ellipsize="end"
                android:fontFamily="@font/nt_500"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/tab_word"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_10sdp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:ellipsize="end"
                android:fontFamily="@font/nt_400"
                android:gravity="center"
                android:lines="2"
                android:text="@string/word_desc"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_9sdp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardExcel"
            style="@style/CardAppStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_4sdp"
            android:layout_marginEnd="@dimen/_4sdp"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_3sdp"
            android:paddingVertical="@dimen/_11sdp"
            android:background="@drawable/bg_surface_card_r13sdp"
            android:foreground="@drawable/stroke_r13sdp_st1sdp_stroke"
            android:clipToOutline="true">

            <ImageView
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_33sdp"
                android:contentDescription="@null"
                android:src="@drawable/ic_file_excel" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:ellipsize="end"
                android:fontFamily="@font/nt_500"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/tab_excel"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_10sdp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:ellipsize="end"
                android:fontFamily="@font/nt_400"
                android:gravity="center"
                android:lines="2"
                android:text="@string/excel_desc"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_9sdp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardPpt"
            style="@style/CardAppStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_4sdp"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_3sdp"
            android:paddingVertical="@dimen/_11sdp"
            android:background="@drawable/bg_surface_card_r13sdp"
            android:foreground="@drawable/stroke_r13sdp_st1sdp_stroke"
            android:clipToOutline="true">

            <ImageView
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_33sdp"
                android:contentDescription="@null"
                android:src="@drawable/ic_file_powerpoint" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:ellipsize="end"
                android:fontFamily="@font/nt_500"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/powerpoint"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_10sdp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:ellipsize="end"
                android:fontFamily="@font/nt_400"
                android:gravity="center"
                android:lines="2"
                android:text="@string/powerpoint_desc"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_9sdp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
