<?xml version="1.0" encoding="utf-8"?><!-- The Files tab. With file access: a header that stays, the file types with their counts (picking
     one narrows the list; they scroll away with the list), Recent / Favourites / All with the sort button,
     and the files. Without access, the library with its own header. FilesFragment shows one or the other. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_home_background"
    tools:context=".ui.main.files.FilesFragment">

    <LinearLayout
        android:id="@+id/screenFiles"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/headerHome"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_49sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_15sdp"
            android:paddingEnd="@dimen/_9sdp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/_9sdp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- The app's name is long: it scrolls (marquee, started by FilesFragment) rather than being cut -->
                <TextView
                    android:id="@+id/tvAppName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="marquee"
                    android:fontFamily="@font/nunito_700"
                    android:letterSpacing="-0.015"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:singleLine="true"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/_18sdp" />

                <TextView
                    android:id="@+id/tvGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito_600"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/_11sdp"
                    tools:text="Good morning" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnSearch"
                style="@style/RoundIconButton"
                android:contentDescription="@string/search_files"
                android:src="@drawable/ic_fo_search" />

            <ImageView
                android:id="@+id/btnPro"
                android:layout_width="@dimen/_34sdp"
                android:layout_height="@dimen/_34sdp"
                android:layout_marginStart="@dimen/_9sdp"
                android:background="@drawable/bg_circle_pro"
                android:contentDescription="@string/fo_pro_name"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="@dimen/_9sdp"
                android:src="@drawable/ic_fo_crown"
                app:tint="@color/color_premium_gold" />
        </LinearLayout>

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.google.android.material.appbar.AppBarLayout
                android:id="@+id/appBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/color_home_background"
                android:stateListAnimator="@null"
                app:elevation="0dp"
                app:liftOnScroll="false">

                <!-- The file types: tap one to narrow the list, tap it again for every type -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/_15sdp"
                    android:paddingTop="@dimen/_5sdp"
                    android:paddingBottom="@dimen/_6sdp"
                    app:layout_scrollFlags="scroll|enterAlways|snap">

                    <include
                        android:id="@+id/typePdf"
                        layout="@layout/layout_type_count" />

                    <include
                        android:id="@+id/typeWord"
                        layout="@layout/layout_type_count"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_7sdp"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/typeExcel"
                        layout="@layout/layout_type_count"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_7sdp"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/typePpt"
                        layout="@layout/layout_type_count"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_7sdp"
                        android:layout_weight="1" />
                </LinearLayout>

                <!-- Recent / Favourites / All and the sort button: stays under the header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/_15sdp"
                    android:paddingTop="@dimen/_6sdp"
                    android:paddingBottom="@dimen/_6sdp">

                    <include
                        android:id="@+id/segmentTab"
                        layout="@layout/layout_segment"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/btnSort"
                        android:layout_width="@dimen/_37sdp"
                        android:layout_height="@dimen/_37sdp"
                        android:layout_marginStart="@dimen/_8sdp"
                        android:background="@drawable/bg_square_button"
                        android:contentDescription="@string/sort"
                        android:elevation="@dimen/_3sdp"
                        android:foreground="?attr/selectableItemBackground"
                        android:outlineAmbientShadowColor="@color/color_shadow"
                        android:outlineSpotShadowColor="@color/color_shadow"
                        android:padding="@dimen/_10sdp"
                        android:src="@drawable/ic_fo_sort"
                        app:tint="@color/text_primary" />
                </LinearLayout>
            </com.google.android.material.appbar.AppBarLayout>

            <!-- The files, as rows of one card; the bottom padding keeps the last row above the floating bar -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcvDocuments"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingHorizontal="@dimen/_15sdp"
                android:paddingTop="@dimen/_4sdp"
                android:paddingBottom="@dimen/_80sdp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_behavior="@string/appbar_scrolling_view_behavior"
                tools:listitem="@layout/item_document" />

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scrollEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                app:layout_behavior="@string/appbar_scrolling_view_behavior">

                <include
                    android:id="@+id/emptyList"
                    layout="@layout/layout_empty_shelf" />
            </androidx.core.widget.NestedScrollView>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/screenNoAccess"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/headerNoAccess"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_49sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_15sdp"
            android:paddingEnd="@dimen/_12sdp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/nunito_700"
                android:letterSpacing="-0.018"
                android:text="@string/fo_your_library"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_21sdp" />

            <TextView
                android:id="@+id/btnProPill"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_31sdp"
                android:background="@drawable/bg_pro_pill"
                android:drawablePadding="@dimen/_5sdp"
                android:fontFamily="@font/nunito_700"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/_8sdp"
                android:paddingEnd="@dimen/_11sdp"
                android:text="@string/fo_pro"
                android:textColor="@color/color_warning"
                android:textSize="@dimen/_11sdp"
                app:drawableStartCompat="@drawable/ic_fo_crown_13sdp"
                app:drawableTint="@color/color_premium_gold" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollNoAccess"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/_100sdp">

            <LinearLayout
                android:id="@+id/layoutNoAccess"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_15sdp"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:background="@drawable/bg_access_card"
                    android:clipChildren="false"
                    android:orientation="vertical"
                    android:padding="@dimen/_15sdp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/_49sdp"
                            android:layout_height="@dimen/_62sdp"
                            android:importantForAccessibility="no"
                            android:rotation="-6"
                            android:src="@drawable/ic_mascot_smile" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_11sdp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/nunito_700"
                                android:text="@string/fo_no_access_title"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/_13sdp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_3sdp"
                                android:fontFamily="@font/nunito_500"
                                android:lineSpacingMultiplier="1.15"
                                android:text="@string/fo_no_access_desc"
                                android:textColor="@color/text_tertiary"
                                android:textSize="@dimen/_11sdp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_11sdp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnAllowAccess"
                            style="@style/PrimaryPillButton"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/_37sdp"
                            android:layout_weight="1"
                            android:paddingHorizontal="@dimen/_6sdp"
                            android:text="@string/allow_access"
                            android:textSize="@dimen/_11sdp" />

                        <TextView
                            android:id="@+id/btnOpenFile"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/_37sdp"
                            android:layout_marginStart="@dimen/_8sdp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_button_outline"
                            android:fontFamily="@font/nunito_700"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center"
                            android:text="@string/open_a_file"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/_11sdp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/SectionHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/_15sdp"
                    android:paddingTop="@dimen/_17sdp"
                    android:paddingBottom="@dimen/_8sdp"
                    android:text="@string/fo_quick_start" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/_15sdp">

                    <include
                        android:id="@+id/quickScan"
                        layout="@layout/layout_quick_tile"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_74sdp"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/quickPhotos"
                        layout="@layout/layout_quick_tile"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_74sdp"
                        android:layout_marginHorizontal="@dimen/_8sdp"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/quickNew"
                        layout="@layout/layout_quick_tile"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_74sdp"
                        android:layout_weight="1" />
                </LinearLayout>

                <include
                    android:id="@+id/emptyShelf"
                    layout="@layout/layout_empty_shelf" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</FrameLayout>