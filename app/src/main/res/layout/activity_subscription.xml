<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app"
    android:orientation="vertical"
    tools:context=".ui.main.premium.SubscriptionActivity">

    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_13sdp"
            android:paddingVertical="@dimen/_15sdp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/_13sdp"
                android:background="@drawable/bg_grad_gradient_start_gradient_end_315_r17sdp"
                android:clipToOutline="true">

                <ImageView
                    android:layout_width="@dimen/_37sdp"
                    android:layout_height="@dimen/_37sdp"
                    android:contentDescription="@null"
                    android:padding="@dimen/_10sdp"
                    android:src="@drawable/ic_app_crown"
                    app:tint="@color/on_primary"
                    android:background="@drawable/bg_white_16_r13sdp"
                    android:clipToOutline="true" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_11sdp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPlan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_800"
                        android:textColor="@color/on_primary"
                        android:textSize="@dimen/_13sdp"
                        tools:text="Free plan" />

                    <TextView
                        android:id="@+id/tvPlanState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_600"
                        android:textColor="@color/color_on_brand_secondary"
                        android:textSize="@dimen/_9sdp"
                        tools:text="No active subscription" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/CardAppStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_13sdp"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:clipToOutline="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/_13sdp"
                    android:paddingVertical="@dimen/_11sdp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/nunito_600"
                        android:text="@string/subscription_status"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/_10sdp" />

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_700"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/_10sdp"
                        tools:text="Google Play" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_1sdp"
                    android:background="@color/color_stroke" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/_13sdp"
                    android:paddingVertical="@dimen/_11sdp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/nunito_600"
                        android:text="@string/subscription_amount"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/_10sdp" />

                    <TextView
                        android:id="@+id/tvAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_700"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/_10sdp"
                        tools:text="Google Play" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_1sdp"
                    android:background="@color/color_stroke" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/_13sdp"
                    android:paddingVertical="@dimen/_11sdp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/nunito_600"
                        android:text="@string/subscription_renews"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/_10sdp" />

                    <TextView
                        android:id="@+id/tvRenews"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_700"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/_10sdp"
                        tools:text="Google Play" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_1sdp"
                    android:background="@color/color_stroke" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/_13sdp"
                    android:paddingVertical="@dimen/_11sdp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/nunito_600"
                        android:text="@string/subscription_billed_through"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/_10sdp" />

                    <TextView
                        android:id="@+id/tvBilledThrough"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_700"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/_10sdp"
                        tools:text="Google Play" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_13sdp"
                android:drawablePadding="@dimen/_8sdp"
                android:fontFamily="@font/nunito_600"
                android:lineSpacingMultiplier="1.2"
                android:paddingHorizontal="@dimen/_11sdp"
                android:paddingVertical="@dimen/_9sdp"
                android:text="@string/subscription_none_notice"
                android:textSize="@dimen/_9sdp"
                app:drawableTint="@color/color_warning"
                android:background="@drawable/bg_warning_bg_r11sdp"
                android:textColor="@color/color_on_warning"
                app:drawableStartCompat="@drawable/ic_app_info_13sdp" />

            <TextView
                android:id="@+id/btnPrimary"
                style="@style/ButtonAppStyle"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/_13sdp"
                tools:text="See Premium plans"
                android:background="@drawable/bg_button_primary"
                android:elevation="@dimen/_5sdp"
                android:outlineSpotShadowColor="@color/primary_30"
                android:outlineAmbientShadowColor="@color/primary_20"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/btnGooglePlay"
                style="@style/ButtonOutlineStyle"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/_8sdp"
                android:text="@string/manage_in_google_play"
                android:background="@drawable/bg_surface_card_r10sdp_st1sdp_stroke"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_13sdp"
                android:fontFamily="@font/nunito_600"
                android:lineSpacingMultiplier="1.2"
                android:text="@string/how_to_cancel"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_9sdp" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
