<?xml version="1.0" encoding="utf-8"?>
<!-- The plan the user is on, what it includes, and where to change it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app"
    android:orientation="vertical"
    tools:context=".ui.main.premium.SubscriptionActivity">

    <include
        android:id="@+id/topBar"
        layout="@layout/layout_screen_bar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_15sdp"
            android:paddingTop="@dimen/_6sdp"
            android:paddingBottom="@dimen/_20sdp">

            <LinearLayout
                style="@style/FloatingCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/_14sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="@dimen/_40sdp"
                        android:layout_height="@dimen/_40sdp"
                        android:background="@drawable/bg_mascot_tile"
                        android:rotation="-5">

                        <ImageView
                            android:layout_width="@dimen/_23sdp"
                            android:layout_height="@dimen/_29sdp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_mascot_smile_ink" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_11sdp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_700"
                            android:text="@string/fo_current_plan"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/_10sdp" />

                        <TextView
                            android:id="@+id/tvPlan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_700"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/_18sdp"
                            tools:text="Free" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_22sdp"
                        android:background="@drawable/bg_badge"
                        android:backgroundTint="@color/color_file_excel_bg"
                        android:fontFamily="@font/nunito_700"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/_9sdp"
                        android:text="@string/fo_active"
                        android:textColor="@color/color_file_excel"
                        android:textSize="@dimen/_10sdp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_2sdp"
                    android:layout_marginTop="@dimen/_11sdp"
                    android:background="@drawable/line_dashed" />

            <LinearLayout style="@style/CheckRow">

                <ImageView
                    style="@style/CheckRowIcon"
                    android:backgroundTint="@color/color_file_excel_bg"
                    android:src="@drawable/ic_fo_check"
                    app:tint="@color/color_file_excel" />

                <TextView
                    style="@style/CheckRowText"
                    android:text="@string/fo_free_read_edit"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <LinearLayout style="@style/CheckRow">

                <ImageView
                    style="@style/CheckRowIcon"
                    android:backgroundTint="@color/color_file_excel_bg"
                    android:src="@drawable/ic_fo_check"
                    app:tint="@color/color_file_excel" />

                <TextView
                    style="@style/CheckRowText"
                    android:text="@string/fo_free_tools"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <LinearLayout style="@style/CheckRow">

                <ImageView
                    style="@style/CheckRowIcon"
                    android:backgroundTint="@color/color_file_excel_bg"
                    android:src="@drawable/ic_fo_check"
                    app:tint="@color/color_file_excel" />

                <TextView
                    style="@style/CheckRowText"
                    android:text="@string/fo_free_translate"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <LinearLayout style="@style/CheckRow">

                <ImageView
                    style="@style/CheckRowIcon"
                    android:backgroundTint="@color/color_surface_variant"
                    android:src="@drawable/ic_fo_close"
                    app:tint="@color/text_secondary" />

                <TextView
                    style="@style/CheckRowText"
                    android:text="@string/fo_pro_ocr_protect"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <LinearLayout style="@style/CheckRow">

                <ImageView
                    style="@style/CheckRowIcon"
                    android:backgroundTint="@color/color_surface_variant"
                    android:src="@drawable/ic_fo_close"
                    app:tint="@color/text_secondary" />

                <TextView
                    style="@style/CheckRowText"
                    android:text="@string/fo_pro_no_ads"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardUpgrade"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_11sdp"
                android:background="@drawable/bg_rounded_panel"
                android:backgroundTint="@color/color_pro_bg"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/_14sdp">

                <ImageView
                    android:layout_width="@dimen/_38sdp"
                    android:layout_height="@dimen/_38sdp"
                    android:background="@drawable/bg_rounded_panel"
                    android:backgroundTint="@color/color_pro"
                    android:importantForAccessibility="no"
                    android:padding="@dimen/_10sdp"
                    android:rotation="-6"
                    android:src="@drawable/ic_fo_crown"
                    app:tint="@color/ink_bar_text" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_11sdp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_700"
                        android:text="@string/fo_upgrade_pro"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/_13sdp" />

                    <TextView
                        android:id="@+id/tvUpgradePrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_600"
                        android:textColor="@color/color_warning"
                        android:textSize="@dimen/_10sdp"
                        tools:text="$29.99 a year · 3 days free" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/_15sdp"
                    android:layout_height="@dimen/_15sdp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_fo_chevron"
                    app:tint="@color/color_warning" />
            </LinearLayout>

            <LinearLayout
                style="@style/FloatingCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_11sdp"
                android:background="@drawable/bg_benefits_card"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/_6sdp"
                android:paddingVertical="@dimen/_3sdp">

                <LinearLayout
                    android:id="@+id/rowRestore"
                    style="@style/SheetRow">

                    <ImageView
                        style="@style/SheetRowIcon"
                        android:src="@drawable/ic_fo_rotate" />

                    <TextView
                        style="@style/SheetRowTitle"
                        android:layout_width="0dp"
                        android:layout_marginHorizontal="@dimen/_9sdp"
                        android:layout_weight="1"
                        android:text="@string/restore_purchases" />

                    <ImageView
                        android:layout_width="@dimen/_15sdp"
                        android:layout_height="@dimen/_15sdp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_fo_chevron"
                        app:tint="@color/text_secondary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_2sdp"
                    android:layout_marginHorizontal="@dimen/_6sdp"
                    android:background="@drawable/line_dashed" />

                <LinearLayout
                    android:id="@+id/rowGooglePlay"
                    style="@style/SheetRow">

                    <ImageView
                        style="@style/SheetRowIcon"
                        android:src="@drawable/ic_fo_card" />

                    <TextView
                        style="@style/SheetRowTitle"
                        android:layout_width="0dp"
                        android:layout_marginHorizontal="@dimen/_9sdp"
                        android:layout_weight="1"
                        android:text="@string/fo_manage_play" />

                    <ImageView
                        android:layout_width="@dimen/_15sdp"
                        android:layout_height="@dimen/_15sdp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_fo_chevron"
                        app:tint="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
