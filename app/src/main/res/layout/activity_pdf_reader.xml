<?xml version="1.0" encoding="utf-8"?>
<!-- The PDF reader: a floating bar at the top (reading, an edit mode, or search), the pages,
     and a floating card at the bottom whose content follows the mode. PdfReaderActivity.render()
     decides what is visible. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/reader_bg"
    android:orientation="vertical"
    tools:context=".ui.main.reader.pdf.PdfReaderActivity">

    <FrameLayout
        android:id="@+id/layoutTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/_9sdp"
        android:paddingTop="@dimen/_6sdp"
        android:paddingBottom="@dimen/_8sdp">

        <FrameLayout
            style="@style/FloatBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_46sdp"
            android:paddingHorizontal="@dimen/_6sdp">

            <!-- Reading -->
            <LinearLayout
                android:id="@+id/barReader"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnBack"
                    style="@style/ReaderBarIcon"
                    android:contentDescription="@string/back"
                    android:src="@drawable/ic_fo_back" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_2sdp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="middle"
                        android:fontFamily="@font/nunito_800"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/_12sdp"
                        tools:text="Lease_Agreement_2026.pdf" />

                    <TextView
                        android:id="@+id/tvPage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_700"
                        android:maxLines="1"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/_10sdp"
                        tools:text="Page 12 of 38" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnSearch"
                    style="@style/ReaderBarIcon"
                    android:contentDescription="@string/search_files"
                    android:src="@drawable/ic_fo_search" />

                <ImageView
                    android:id="@+id/btnBookmark"
                    style="@style/ReaderBarIcon"
                    android:contentDescription="@string/fo_bookmark_page"
                    android:src="@drawable/ic_fo_star" />

                <ImageView
                    android:id="@+id/btnNormal"
                    style="@style/ReaderBarIcon"
                    android:contentDescription="@string/theme_normal"
                    android:src="@drawable/ic_fo_sun"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/btnMore"
                    style="@style/ReaderBarIcon"
                    android:contentDescription="@string/fo_more"
                    android:src="@drawable/ic_fo_more" />
            </LinearLayout>

            <!-- An edit mode or the contents -->
            <LinearLayout
                android:id="@+id/barMode"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/btnModeClose"
                    style="@style/ReaderBarClose"
                    android:contentDescription="@string/scanner_close"
                    android:src="@drawable/ic_fo_close" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvModeTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/nunito_800"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/_12sdp"
                        tools:text="Add text" />

                    <TextView
                        android:id="@+id/tvModeSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="middle"
                        android:fontFamily="@font/nunito_700"
                        android:maxLines="1"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/_10sdp"
                        tools:text="Lease_Agreement_2026.pdf" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnUndo"
                    style="@style/ReaderBarIcon"
                    android:contentDescription="@string/undo"
                    android:src="@drawable/ic_fo_undo" />

                <ImageView
                    android:id="@+id/btnRedo"
                    style="@style/ReaderBarIcon"
                    android:contentDescription="@string/redo"
                    android:src="@drawable/ic_fo_redo" />

                <TextView
                    android:id="@+id/btnModeAction"
                    style="@style/ReaderSave"
                    android:text="@string/file_action_save" />
            </LinearLayout>

            <!-- Search in the file -->
            <LinearLayout
                android:id="@+id/barSearch"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/btnSearchClose"
                    style="@style/ReaderBarClose"
                    android:contentDescription="@string/scanner_close"
                    android:src="@drawable/ic_fo_close" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_34sdp"
                    android:layout_marginHorizontal="@dimen/_5sdp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_field_soft"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/_9sdp">

                    <ImageView
                        android:layout_width="@dimen/_14sdp"
                        android:layout_height="@dimen/_14sdp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_fo_search"
                        app:tint="@color/text_secondary" />

                    <EditText
                        android:id="@+id/edtSearch"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="@dimen/_5sdp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:fontFamily="@font/nunito_800"
                        android:hint="@string/fo_search_in_file"
                        android:imeOptions="actionSearch"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="@dimen/_12sdp" />

                    <TextView
                        android:id="@+id/tvSearchCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_800"
                        android:maxLines="1"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/_10sdp"
                        tools:text="2 of 7" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnSearchPrevious"
                    style="@style/ReaderBarIcon"
                    android:contentDescription="@string/fo_previous_match"
                    android:rotation="90"
                    android:src="@drawable/ic_fo_back" />

                <ImageView
                    android:id="@+id/btnSearchNext"
                    style="@style/ReaderBarIcon"
                    android:contentDescription="@string/fo_next_match"
                    android:rotation="-90"
                    android:src="@drawable/ic_fo_back" />
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/tvBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_12sdp"
        android:layout_marginBottom="@dimen/_6sdp"
        android:background="@drawable/bg_rounded_panel"
        android:backgroundTint="@color/color_bg_selected"
        android:drawablePadding="@dimen/_6sdp"
        android:fontFamily="@font/nunito_700"
        android:paddingHorizontal="@dimen/_11sdp"
        android:paddingVertical="@dimen/_7sdp"
        android:text="@string/form_hint"
        android:textColor="@color/text_on_selected"
        android:textSize="@dimen/_10sdp"
        android:visibility="gone"
        app:drawableStartCompat="@drawable/ic_fo_info_17sdp"
        app:drawableTint="@color/text_on_selected"
        tools:visibility="visible" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.reader.pdfviewer.PDFView
            android:id="@+id/pdfView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- PdfOverlayView goes here: it draws and takes the touches of the edit modes -->
        <FrameLayout
            android:id="@+id/layoutOverlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvPagePill"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_26sdp"
            android:layout_marginEnd="@dimen/_14sdp"
            android:layout_marginBottom="@dimen/_9sdp"
            android:background="@drawable/bg_ink_pill"
            android:elevation="@dimen/_3sdp"
            android:fontFamily="@font/nunito_800"
            android:gravity="center"
            android:paddingHorizontal="@dimen/_11sdp"
            android:textColor="@color/white"
            android:textSize="@dimen/_10sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="12 / 38" />

        <!-- Actions on the selected text (markup) or the selected object (duplicate, delete) -->
        <LinearLayout
            android:id="@+id/layoutMarkup"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_35sdp"
            android:layout_marginBottom="@dimen/_9sdp"
            android:background="@drawable/bg_ink_bar"
            android:elevation="@dimen/_8sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_3sdp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:visibility="visible">

            <TextView
                android:id="@+id/btnMarkHighlight"
                style="@style/MarkupActionStyle"
                android:text="@string/annot_highlight" />

            <TextView
                android:id="@+id/btnMarkUnderline"
                style="@style/MarkupActionStyle"
                android:text="@string/pdf_edit_underline" />

            <TextView
                android:id="@+id/btnMarkStrike"
                style="@style/MarkupActionStyle"
                android:text="@string/pdf_edit_strikethrough" />

            <TextView
                android:id="@+id/btnMarkDuplicate"
                style="@style/MarkupActionStyle"
                android:text="@string/duplicate" />

            <TextView
                android:id="@+id/btnMarkDelete"
                style="@style/MarkupActionStyle"
                android:text="@string/file_action_delete"
                android:textColor="@color/ink_bar_danger" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:indeterminateTint="@color/primary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <include
            android:id="@+id/contents"
            layout="@layout/layout_pdf_contents"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/layoutBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/_9sdp"
        android:paddingTop="@dimen/_6sdp"
        android:paddingBottom="@dimen/_15sdp">

        <!-- Reading: where you are, and the edit modes -->
        <LinearLayout
            android:id="@+id/bottomReader"
            style="@style/FloatBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_6sdp"
            android:paddingTop="@dimen/_6sdp"
            android:paddingBottom="@dimen/_5sdp">

            <SeekBar
                android:id="@+id/seekPage"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_20sdp"
                android:contentDescription="@string/fo_go_to_page"
                android:maxHeight="@dimen/_5sdp"
                android:minHeight="@dimen/_5sdp"
                android:paddingHorizontal="@dimen/_12sdp"
                android:progressBackgroundTint="@color/color_surface_variant"
                android:progressTint="@color/text_on_selected"
                android:splitTrack="false"
                android:thumbTint="@color/text_on_selected" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnEdit"
                    style="@style/ReaderTab">

                    <ImageView
                        style="@style/ReaderTabIcon"
                        android:src="@drawable/ic_fo_type" />

                    <TextView
                        style="@style/ReaderTabLabel"
                        android:text="@string/fo_text" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnAnnotate"
                    style="@style/ReaderTab">

                    <ImageView
                        style="@style/ReaderTabIcon"
                        android:src="@drawable/ic_fo_highlight" />

                    <TextView
                        style="@style/ReaderTabLabel"
                        android:text="@string/tool_annotate" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnSign"
                    style="@style/ReaderTab">

                    <ImageView
                        style="@style/ReaderTabIcon"
                        android:src="@drawable/ic_fo_sign" />

                    <TextView
                        style="@style/ReaderTabLabel"
                        android:text="@string/tool_sign" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnFill"
                    style="@style/ReaderTab">

                    <ImageView
                        style="@style/ReaderTabIcon"
                        android:src="@drawable/ic_fo_form" />

                    <TextView
                        style="@style/ReaderTabLabel"
                        android:text="@string/tool_fill_form" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnContents"
                    style="@style/ReaderTab">

                    <ImageView
                        style="@style/ReaderTabIcon"
                        android:src="@drawable/ic_fo_list" />

                    <TextView
                        style="@style/ReaderTabLabel"
                        android:text="@string/contents" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Add text: size and colour of the next text -->
        <LinearLayout
            android:id="@+id/bottomText"
            style="@style/FloatBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/_11sdp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_segment_track"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/_3sdp">

                <ImageView
                    android:id="@+id/btnTextSmaller"
                    android:layout_width="@dimen/_31sdp"
                    android:layout_height="@dimen/_31sdp"
                    android:background="@drawable/bg_circle_variant"
                    android:backgroundTint="@color/color_surface_card"
                    android:contentDescription="@string/fo_smaller"
                    android:padding="@dimen/_8sdp"
                    android:src="@drawable/ic_fo_minus"
                    app:tint="@color/text_primary" />

                <TextView
                    android:id="@+id/tvTextSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito_800"
                    android:gravity="center"
                    android:minWidth="@dimen/_40sdp"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/_12sdp"
                    tools:text="12 pt" />

                <ImageView
                    android:id="@+id/btnTextLarger"
                    android:layout_width="@dimen/_31sdp"
                    android:layout_height="@dimen/_31sdp"
                    android:background="@drawable/bg_circle_variant"
                    android:backgroundTint="@color/color_surface_card"
                    android:contentDescription="@string/fo_bigger"
                    android:padding="@dimen/_8sdp"
                    android:src="@drawable/ic_fo_plus"
                    app:tint="@color/text_primary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_9sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/layoutTextColors"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

                <TextView
                    style="@style/ReaderHint"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:gravity="end|center_vertical"
                    android:text="@string/fo_tap_to_add" />
            </LinearLayout>
        </LinearLayout>

        <!-- Annotate: colours, width, tools -->
        <LinearLayout
            android:id="@+id/bottomAnnotate"
            style="@style/FloatBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/_11sdp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/_3sdp">

                <LinearLayout
                    android:id="@+id/layoutInkColors"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/nunito_800"
                    android:gravity="end"
                    android:text="@string/fo_size"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/_10sdp" />

                <SeekBar
                    android:id="@+id/seekInkWidth"
                    android:layout_width="@dimen/_72sdp"
                    android:layout_height="wrap_content"
                    android:max="7"
                    android:paddingHorizontal="@dimen/_8sdp"
                    android:progressBackgroundTint="@color/color_surface_variant"
                    android:progressTint="@color/text_primary"
                    android:splitTrack="false"
                    android:thumbTint="@color/text_primary" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcvAnnotateTools"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="8"
                tools:itemCount="8"
                tools:listitem="@layout/item_annotate_tool" />

            <TextView
                android:id="@+id/tvAnnotateHint"
                style="@style/ReaderHint"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/_8sdp"
                android:gravity="center"
                tools:text="Shapes · tap to place, drag to resize" />
        </LinearLayout>

        <!-- Place signature -->
        <LinearLayout
            android:id="@+id/bottomSign"
            style="@style/FloatBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/_11sdp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/btnAddSignature"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_46sdp"
                    android:layout_weight="1.4"
                    android:background="@drawable/bg_option_card"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/ivSignature"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:padding="@dimen/_6sdp"
                        android:scaleType="fitCenter"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvAddSignature"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:drawablePadding="@dimen/_5sdp"
                        android:fontFamily="@font/nunito_800"
                        android:gravity="center"
                        android:text="@string/add_signature"
                        android:textColor="@color/text_on_selected"
                        android:textSize="@dimen/_11sdp"
                        app:drawableStartCompat="@drawable/ic_fo_sign_17sdp"
                        app:drawableTint="@color/text_on_selected" />
                </FrameLayout>

                <TextView
                    android:id="@+id/btnSignInitials"
                    style="@style/SoftTile"
                    android:layout_width="0dp"
                    android:layout_marginStart="@dimen/_6sdp"
                    android:layout_weight="1"
                    android:text="@string/sign_initials" />

                <TextView
                    android:id="@+id/btnSignDate"
                    style="@style/SoftTile"
                    android:layout_width="0dp"
                    android:layout_marginStart="@dimen/_6sdp"
                    android:layout_weight="1"
                    android:text="@string/sign_date" />
            </LinearLayout>

            <TextView
                style="@style/ReaderHint"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/_8sdp"
                android:gravity="center"
                android:text="@string/fo_sign_hint" />
        </LinearLayout>

        <!-- Fill form -->
        <LinearLayout
            android:id="@+id/bottomForm"
            style="@style/FloatBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/_11sdp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_4sdp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvFieldCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito_800"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/_10sdp"
                    tools:text="Field 3 of 4" />

                <TextView
                    android:id="@+id/tvField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/nunito_800"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/_12sdp"
                    tools:text="New address" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnFieldPrevious"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:background="@drawable/bg_circle_variant"
                android:contentDescription="@string/fo_previous_field"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="@dimen/_11sdp"
                android:src="@drawable/ic_fo_back"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/btnFieldNext"
                style="@style/PrimaryPillButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_40sdp"
                android:layout_marginStart="@dimen/_6sdp"
                android:elevation="0dp"
                android:text="@string/fo_next_field" />

            <TextView
                android:id="@+id/btnFormDone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/done"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Search: every match, by page -->
        <LinearLayout
            android:id="@+id/bottomSearch"
            style="@style/FloatBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/_11sdp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/_3sdp">

                <TextView
                    android:id="@+id/tvMatches"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/nunito_800"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/_12sdp"
                    tools:text="7 matches" />

                <TextView
                    android:id="@+id/tvMatchPages"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_20sdp"
                    android:background="@drawable/bg_badge"
                    android:backgroundTint="@color/color_surface_variant"
                    android:fontFamily="@font/nunito_800"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/_8sdp"
                    android:textColor="@color/text_tertiary"
                    android:textSize="@dimen/_10sdp"
                    tools:text="on 3 pages" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcvMatches"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:maxHeight="@dimen/_160sdp"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="4"
                tools:listitem="@layout/item_search_match" />
        </LinearLayout>

        <!-- Read aloud and auto-scroll controls -->
        <LinearLayout
            android:id="@+id/bottomPlay"
            style="@style/FloatBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_52sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_15sdp"
            android:paddingEnd="@dimen/_6sdp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvPlayTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/nunito_800"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_11sdp"
                tools:text="Reading page 3" />

            <ImageView
                android:id="@+id/btnPlayPrevious"
                style="@style/ReaderBarIcon"
                android:contentDescription="@string/fo_previous_page"
                android:src="@drawable/ic_fo_back" />

            <ImageView
                android:id="@+id/btnPlayToggle"
                android:layout_width="@dimen/_34sdp"
                android:layout_height="@dimen/_34sdp"
                android:background="@drawable/bg_circle_variant"
                android:backgroundTint="@color/primary"
                android:contentDescription="@string/fo_pause"
                android:padding="@dimen/_9sdp"
                android:src="@drawable/ic_app_pause"
                app:tint="@color/on_primary" />

            <!-- Auto-scroll: the speed, between the slower and faster buttons -->
            <TextView
                android:id="@+id/tvPlaySpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_800"
                android:gravity="center"
                android:minWidth="@dimen/_23sdp"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_12sdp"
                android:visibility="gone"
                tools:text="10" />

            <ImageView
                android:id="@+id/btnPlayNext"
                style="@style/ReaderBarIcon"
                android:contentDescription="@string/fo_next_page"
                android:rotation="180"
                android:src="@drawable/ic_fo_back" />

            <ImageView
                android:id="@+id/btnPlayClose"
                style="@style/ReaderBarClose"
                android:layout_marginStart="@dimen/_3sdp"
                android:contentDescription="@string/scanner_close"
                android:src="@drawable/ic_fo_close" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
