<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/_6sdp"
    android:background="@drawable/bg_language_item"
    android:elevation="@dimen/_3sdp"
    android:gravity="center_vertical"
    android:minHeight="@dimen/_49sdp"
    android:orientation="horizontal"
    android:outlineAmbientShadowColor="@color/color_shadow"
    android:outlineSpotShadowColor="@color/color_shadow"
    android:paddingHorizontal="@dimen/_11sdp"
    android:paddingVertical="@dimen/_6sdp">

    <TextView
        android:id="@+id/tvBadge"
        android:layout_width="@dimen/_31sdp"
        android:layout_height="@dimen/_31sdp"
        android:background="@drawable/bg_language_badge"
        android:duplicateParentState="true"
        android:fontFamily="@font/nunito_800"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/text_language_badge"
        android:textSize="@dimen/_9sdp"
        tools:text="EN" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_11sdp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/languageName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_800"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/_12sdp"
            tools:text="English" />

        <TextView
            android:id="@+id/locateName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_600"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_10sdp"
            tools:text="English" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivCheck"
        android:layout_width="@dimen/_22sdp"
        android:layout_height="@dimen/_22sdp"
        android:background="@drawable/bg_circle_primary"
        android:contentDescription="@null"
        android:padding="@dimen/_5sdp"
        android:src="@drawable/ic_fo_check"
        android:visibility="invisible"
        app:tint="@color/on_primary" />
</LinearLayout>
