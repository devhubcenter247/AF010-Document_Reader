<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:layout_marginVertical="@dimen/_5sdp"
    android:padding="@dimen/_8sdp"
    android:background="@drawable/bg_language_item"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/itemLanguage"
        android:layout_width="@dimen/_23sdp"
        android:layout_height="@dimen/_23sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@tools:sample/avatars"
        android:background="@drawable/bg_r10sdp"
        android:foreground="@drawable/stroke_r10sdp_st1sdp_stroke"
        android:clipToOutline="true" />

    <LinearLayout
        android:orientation="vertical"
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_gravity="center_vertical"
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            tools:text="@tools:sample/lorem"
            android:layout_width="match_parent"
            android:id="@+id/languageName"
            android:fontFamily="@font/nt_500"
            android:singleLine="true"
            android:textSize="@dimen/_11sdp"
            android:layout_height="match_parent"/>
        <TextView
            tools:text="@tools:sample/lorem"
            android:layout_width="match_parent"
            android:id="@+id/locateName"
            android:singleLine="true"
            android:textColor="@color/text_secondary"
            android:fontFamily="@font/nt_400"
            android:textSize="@dimen/_9sdp"
            android:layout_height="match_parent"/>

    </LinearLayout>

    <ImageView
        android:layout_width="@dimen/_17sdp"
        android:layout_height="@dimen/_17sdp"
        android:padding="@dimen/_1sdp"
        android:src="@drawable/ic_state_language" />
</LinearLayout>