<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app"
    android:orientation="vertical"
    tools:context=".ui.language.LanguageActivity">

    <TextView
        android:id="@+id/headerLanguage"
        style="@style/TextHeadLine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:fontFamily="@font/nt_600"
        android:text="@string/choose_language"
        android:textSize="@dimen/_13sdp"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView"
        style="@style/TextSubContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:fontFamily="@font/nt_400"
        android:text="@string/you_can_change_it_anytime_in_settings"
        app:layout_constraintTop_toBottomOf="@+id/headerLanguage" />


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcvLangue"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:clipToPadding="false"
        android:layout_marginBottom="@dimen/_15sdp"
        android:paddingBottom="@dimen/_32sdp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="@+id/lnButtonStyle"
        app:layout_constraintTop_toBottomOf="@+id/textView"
        tools:layout_editor_absoluteX="16dp"
        tools:listitem="@layout/item_view_language" />

    <LinearLayout
        android:id="@+id/lnButtonStyle"
        android:layout_width="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.5"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.ui.baselib.widget.view.UiTextView
            android:id="@+id/btnContinue"
            style="@style/ButtonAppStyle"
            android:layout_width="0dp"
            app:uiWidthPercent="50"
            android:layout_marginHorizontal="@dimen/_13sdp"
            android:layout_marginVertical="@dimen/_10sdp"
            android:drawableEnd="@drawable/ic_app_arrowr"
            android:elevation="@dimen/_10sdp"
            android:paddingHorizontal="@dimen/_13sdp"
            android:text="@string/txt_continues"
            app:uiBackgroundGradientEnabled="false"
            app:uiDrawableAlign="text"
            app:uiDrawablePadding="@dimen/_7sdp"
            app:uiDrawableSize="@dimen/_17sdp"
            app:uiDrawableTint="@color/white"
            app:uiStrokeGradient="false" />
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>