<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app"
    android:orientation="vertical"
    tools:context=".ui.language.LanguageActivity">

    <!-- Only when opened again from Settings: on first run there is nothing to go back to -->
    <ImageView
        android:id="@+id/btnBack"
        style="@style/RoundIconButton"
        android:layout_width="@dimen/_32sdp"
        android:layout_height="@dimen/_32sdp"
        android:layout_marginStart="@dimen/_12sdp"
        android:layout_marginTop="@dimen/_7sdp"
        android:contentDescription="@string/back"
        android:src="@drawable/ic_fo_back"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tvTitle"
        style="@style/DisplayTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_18sdp"
        android:layout_marginTop="@dimen/_6sdp"
        android:text="@string/fo_language_title" />

    <TextView
        android:id="@+id/tvSubtitle"
        style="@style/DisplaySubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_18sdp"
        android:layout_marginTop="@dimen/_6sdp"
        android:text="@string/fo_language_subtitle" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcvLangue"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/_12sdp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/_15sdp"
        android:paddingTop="@dimen/_3sdp"
        android:paddingBottom="@dimen/_6sdp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_view_language" />

    <TextView
        android:id="@+id/btnContinue"
        style="@style/PrimaryPillButton"
        android:layout_width="match_parent"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_9sdp"
        android:layout_marginBottom="@dimen/_12sdp"
        android:text="@string/txt_continues" />
</LinearLayout>
