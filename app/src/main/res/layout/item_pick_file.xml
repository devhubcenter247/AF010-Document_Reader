<?xml version="1.0" encoding="utf-8"?>
<!-- A file to pick: soft type tile, name, size and date, and its place in the order once picked. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/_6sdp"
    android:background="@drawable/bg_pick_row"
    android:elevation="@dimen/_3sdp"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/_51sdp"
    android:orientation="horizontal"
    android:outlineAmbientShadowColor="@color/color_shadow"
    android:outlineSpotShadowColor="@color/color_shadow"
    android:paddingHorizontal="@dimen/_11sdp"
    android:paddingVertical="@dimen/_6sdp">

    <TextView
        android:id="@+id/tvType"
        android:layout_width="@dimen/_32sdp"
        android:layout_height="@dimen/_32sdp"
        android:background="@drawable/bg_file_tile"
        android:fontFamily="@font/nunito_800"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:textSize="@dimen/_9sdp"
        tools:backgroundTint="@color/color_file_pdf_bg"
        tools:text="PDF"
        tools:textColor="@color/color_file_pdf" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_9sdp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:fontFamily="@font/nunito_800"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/_12sdp"
            tools:text="Lease_Agreement_2026.pdf" />

        <TextView
            android:id="@+id/tvMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_600"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_10sdp"
            tools:text="2.4 MB · Oct 15" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvOrder"
        android:layout_width="@dimen/_23sdp"
        android:layout_height="@dimen/_23sdp"
        android:background="@drawable/bg_pick_order"
        android:duplicateParentState="true"
        android:fontFamily="@font/nunito_800"
        android:gravity="center"
        android:textColor="@color/on_primary"
        android:textSize="@dimen/_11sdp"
        tools:text="1" />
</LinearLayout>
