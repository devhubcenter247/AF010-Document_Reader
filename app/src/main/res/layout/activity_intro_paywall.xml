<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app"
    android:orientation="vertical"
    tools:context=".ui.main.premium.IntroPaywallActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_43sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_12sdp">

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="@dimen/_32sdp"
            android:layout_height="@dimen/_32sdp"
            android:background="@drawable/bg_circle_variant"
            android:contentDescription="@string/close"
            android:padding="@dimen/_8sdp"
            android:src="@drawable/ic_fo_close"
            app:tint="@color/text_tertiary" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnRestore"
            style="@style/GhostButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_34sdp"
            android:paddingHorizontal="@dimen/_9sdp"
            android:text="@string/fo_restore_purchase"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_11sdp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/_8sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/_18sdp"
                android:paddingTop="@dimen/_3sdp"
                android:paddingBottom="@dimen/_14sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_26sdp"
                        android:background="@drawable/bg_pro_chip"
                        android:drawablePadding="@dimen/_5sdp"
                        android:fontFamily="@font/nunito_800"
                        android:gravity="center_vertical"
                        android:paddingStart="@dimen/_8sdp"
                        android:paddingEnd="@dimen/_11sdp"
                        android:text="@string/fo_pro_name"
                        android:textColor="@color/color_warning"
                        android:textSize="@dimen/_11sdp"
                        app:drawableStartCompat="@drawable/ic_fo_crown_14sdp"
                        app:drawableTint="@color/color_premium_gold" />

                    <TextView
                        style="@style/DisplayTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_9sdp"
                        android:text="@string/fo_paywall_first_title" />

                    <TextView
                        style="@style/DisplaySubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_9sdp"
                        android:text="@string/fo_paywall_first_subtitle" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/_15sdp"
                    android:layout_height="@dimen/_15sdp"
                    android:layout_gravity="end"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:layout_marginEnd="@dimen/_28sdp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_sparkle"
                    app:tint="@color/color_pro" />

                <ImageView
                    android:layout_width="@dimen/_9sdp"
                    android:layout_height="@dimen/_9sdp"
                    android:layout_gravity="end"
                    android:layout_marginTop="@dimen/_31sdp"
                    android:layout_marginEnd="@dimen/_12sdp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_sparkle"
                    app:tint="@color/color_sparkle_orange" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:background="@drawable/bg_benefits_card"
                android:elevation="@dimen/_3sdp"
                android:orientation="vertical"
                android:outlineAmbientShadowColor="@color/color_shadow"
                android:outlineSpotShadowColor="@color/color_shadow"
                android:paddingHorizontal="@dimen/_12sdp"
                android:paddingVertical="@dimen/_5sdp">

                <include android:id="@+id/benefitOcr" layout="@layout/layout_benefit_row" />

                <View android:layout_width="match_parent" android:layout_height="@dimen/_2sdp" android:background="@drawable/line_dashed" />

                <include android:id="@+id/benefitProtect" layout="@layout/layout_benefit_row" />

                <View android:layout_width="match_parent" android:layout_height="@dimen/_2sdp" android:background="@drawable/line_dashed" />

                <include android:id="@+id/benefitTranslate" layout="@layout/layout_benefit_row" />

                <View android:layout_width="match_parent" android:layout_height="@dimen/_2sdp" android:background="@drawable/line_dashed" />

                <include android:id="@+id/benefitAds" layout="@layout/layout_benefit_row" />
            </LinearLayout>

            <include
                android:id="@+id/planYearly"
                layout="@layout/layout_plan_option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:layout_marginTop="@dimen/_12sdp" />

            <include
                android:id="@+id/planMonthly"
                layout="@layout/layout_plan_option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:layout_marginTop="@dimen/_8sdp" />

            <include
                android:id="@+id/planLifetime"
                layout="@layout/layout_plan_option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:layout_marginTop="@dimen/_8sdp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <TextView
        android:id="@+id/btnPurchase"
        style="@style/PrimaryPillButton"
        android:layout_width="match_parent"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_9sdp"
        tools:text="Try 3 days free" />

    <TextView
        android:id="@+id/tvLegal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:layout_marginBottom="@dimen/_20sdp"
        android:fontFamily="@font/nunito_600"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textColorLink="@color/text_tertiary"
        android:textSize="@dimen/_10sdp"
        tools:text="No charge today. Cancel any time in Google Play · Terms · Privacy" />
</LinearLayout>
