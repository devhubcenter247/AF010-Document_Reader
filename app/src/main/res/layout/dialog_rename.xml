<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/DialogAppStyle"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/_17sdp"
    tools:context=".ui.dialog.RenameDialog"
    android:background="@drawable/bg_surface_card_r18sdp"
    android:clipToOutline="true">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/nt_600"
        android:gravity="center"
        android:text="@string/rename_file"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/_13sdp" />

    <TextView
        android:id="@+id/tvLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_11sdp"
        android:fontFamily="@font/nt_500"
        android:text="@string/new_name"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/_10sdp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_37sdp"
        android:layout_marginTop="@dimen/_5sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_11sdp"
        android:background="@drawable/bg_surface_card_r11sdp"
        android:foreground="@drawable/stroke_r11sdp_st1sdp_primary"
        android:clipToOutline="true">

        <EditText
            android:id="@+id/edtName"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="@font/nt_400"
            android:hint="@string/new_name"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="@dimen/_12sdp" />

        <TextView
            android:id="@+id/tvExtension"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_6sdp"
            android:fontFamily="@font/nt_400"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_12sdp"
            tools:text=".docx" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_13sdp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancel"
            style="@style/ButtonOutlineStyle"
            android:layout_width="0dp"
            android:layout_marginEnd="@dimen/_4sdp"
            android:layout_weight="1"
            android:text="@string/file_action_cancel"
            android:background="@drawable/bg_surface_card_r10sdp_st1sdp_stroke"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/btnConfirm"
            style="@style/ButtonAppStyle"
            android:layout_width="0dp"
            android:layout_marginStart="@dimen/_4sdp"
            android:layout_weight="1"
            android:text="@string/file_action_save"
            android:background="@drawable/bg_grad_gradient_start_gradient_end_270_r10sdp"
            android:elevation="@dimen/_5sdp"
            android:outlineSpotShadowColor="@color/primary_30"
            android:outlineAmbientShadowColor="@color/primary_20"
            android:textColor="@color/white" />
    </LinearLayout>

</LinearLayout>
