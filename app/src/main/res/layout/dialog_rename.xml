<?xml version="1.0" encoding="utf-8"?>
<!-- A new name (rename) or any single line of text (TextInputDialog). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:clipToPadding="false"
    android:gravity="start"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/_17sdp"
    android:paddingTop="@dimen/_17sdp"
    android:paddingBottom="@dimen/_15sdp"
    tools:context=".ui.dialog.RenameDialog">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/nunito_600"
        android:text="@string/fo_new_name_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/_15sdp" />

    <TextView
        android:id="@+id/tvLabel"
        style="@style/FieldLabel"
        android:layout_marginTop="@dimen/_11sdp"
        android:labelFor="@id/edtName"
        android:text="@string/fo_file_name" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_43sdp"
        android:addStatesFromChildren="true"
        android:background="@drawable/bg_field"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_12sdp">

        <EditText
            android:id="@+id/edtName"
            style="@style/FieldInput"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:fontFamily="@font/nunito_600"
            android:imeOptions="actionDone"
            android:inputType="text" />

        <TextView
            android:id="@+id/tvExtension"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_5sdp"
            android:fontFamily="@font/nunito_600"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_12sdp"
            tools:text=".pdf" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_5sdp"
        android:fontFamily="@font/nunito_500"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/_10sdp"
        android:visibility="gone"
        tools:text="The .pdf ending stays the same."
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_14sdp"
        android:clipToPadding="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancel"
            style="@style/DialogSoftButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/file_action_cancel" />

        <TextView
            android:id="@+id/btnConfirm"
            style="@style/DialogPrimaryButton"
            android:layout_width="0dp"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_weight="1.3"
            android:text="@string/fo_rename" />
    </LinearLayout>
</LinearLayout>
