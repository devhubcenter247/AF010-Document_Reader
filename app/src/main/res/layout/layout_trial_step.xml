<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp"
            android:contentDescription="@null"
            android:padding="@dimen/_5sdp"
            app:tint="@color/on_primary"
            tools:src="@drawable/ic_app_crown"
            android:background="@drawable/bg_primary_r11sdp"
            android:clipToOutline="true" />

        <View
            android:id="@+id/line"
            android:layout_width="@dimen/_2sdp"
            android:layout_height="0dp"
            android:layout_marginVertical="@dimen/_3sdp"
            android:layout_weight="1"
            android:background="@color/color_stroke" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_9sdp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingBottom="@dimen/_11sdp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_800"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/_11sdp"
            tools:text="Today · $0.00" />

        <TextView
            android:id="@+id/tvDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:fontFamily="@font/nunito_600"
            android:lineSpacingMultiplier="1.15"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_9sdp"
            tools:text="Full Premium access starts now. You won’t be charged today." />
    </LinearLayout>

</LinearLayout>
