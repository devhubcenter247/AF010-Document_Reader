<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <FrameLayout
        android:layout_width="@dimen/_254sdp"
        android:layout_height="@dimen/_254sdp"
        android:layout_gravity="center"
        android:clipChildren="false">

        <ImageView
            android:layout_width="@dimen/_231sdp"
            android:layout_height="@dimen/_231sdp"
            android:layout_marginStart="@dimen/_12sdp"
            android:layout_marginTop="@dimen/_12sdp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_blob"
            app:tint="@color/color_blob_peach" />

        <include
            android:id="@+id/cardWord"
            layout="@layout/layout_doc_card"
            android:layout_width="@dimen/_86sdp"
            android:layout_height="@dimen/_108sdp"
            android:layout_marginStart="@dimen/_22sdp"
            android:layout_marginTop="@dimen/_54sdp" />

        <include
            android:id="@+id/cardExcel"
            layout="@layout/layout_doc_card"
            android:layout_width="@dimen/_86sdp"
            android:layout_height="@dimen/_108sdp"
            android:layout_marginStart="@dimen/_148sdp"
            android:layout_marginTop="@dimen/_46sdp" />

        <include
            android:id="@+id/cardSlides"
            layout="@layout/layout_doc_card"
            android:layout_width="@dimen/_86sdp"
            android:layout_height="@dimen/_108sdp"
            android:layout_marginStart="@dimen/_77sdp"
            android:layout_marginTop="@dimen/_131sdp" />

        <ImageView
            android:layout_width="@dimen/_74sdp"
            android:layout_height="@dimen/_92sdp"
            android:layout_marginStart="@dimen/_86sdp"
            android:layout_marginTop="@dimen/_26sdp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_mascot_cheer"
            android:translationZ="@dimen/_12sdp" />

        <ImageView
            android:layout_width="@dimen/_17sdp"
            android:layout_height="@dimen/_17sdp"
            android:layout_marginStart="@dimen/_214sdp"
            android:layout_marginTop="@dimen/_15sdp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_sparkle"
            app:tint="@color/color_pro" />
    </FrameLayout>
</FrameLayout>
