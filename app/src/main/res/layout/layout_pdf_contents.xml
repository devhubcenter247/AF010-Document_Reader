<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_surface_card"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <include
        android:id="@+id/segment"
        layout="@layout/layout_segment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_6sdp"
        android:layout_marginHorizontal="@dimen/_13sdp"
        android:layout_marginTop="@dimen/_11sdp" />

    <TextView
        android:id="@+id/btnAddBookmark"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_31sdp"
        android:background="?attr/selectableItemBackground"
        android:drawablePadding="@dimen/_8sdp"
        android:fontFamily="@font/nunito_700"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/_15sdp"
        android:textSize="@dimen/_10sdp"
        android:visibility="gone"
        app:drawableTint="@color/text_on_selected"
        tools:text="Bookmark page 3"
        tools:visibility="visible"
        android:textColor="@color/text_on_selected"
        app:drawableStartCompat="@drawable/ic_app_bookmark_15sdp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcvContents"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="@dimen/_11sdp" />

        <TextView
            android:id="@+id/tvContentsEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_50sdp"
            android:fontFamily="@font/nunito_600"
            android:gravity="center"
            android:paddingHorizontal="@dimen/_18sdp"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_10sdp"
            android:visibility="gone"
            tools:text="This PDF has no table of contents" />
    </FrameLayout>

</LinearLayout>
