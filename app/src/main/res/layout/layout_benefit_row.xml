<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/_38sdp"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/ivIcon"
        android:layout_width="@dimen/_25sdp"
        android:layout_height="@dimen/_25sdp"
        android:background="@drawable/bg_icon_tile_soft"
        android:importantForAccessibility="no"
        android:padding="@dimen/_6sdp"
        app:tint="@color/text_on_selected"
        tools:src="@drawable/ic_fo_sparkles" />

    <TextView
        android:id="@+id/tvText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_9sdp"
        android:layout_weight="1"
        android:fontFamily="@font/nunito_600"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/_11sdp"
        tools:text="Turn scans into editable text (OCR)" />

    <ImageView
        android:layout_width="@dimen/_14sdp"
        android:layout_height="@dimen/_14sdp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_fo_check"
        app:tint="@color/color_success" />
</LinearLayout>
