<?xml version="1.0" encoding="utf-8"?>
<com.ui.baselib.widget.layout.UiLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="@dimen/_3sdp"
    app:uiBackgroundColor="@color/color_surface_track"
    app:uiCornerRadius="@dimen/_9sdp">

    <com.ui.baselib.widget.view.UiTextView
        android:id="@+id/tvFirst"
        android:layout_width="0dp"
        android:layout_height="@dimen/_25sdp"
        android:layout_weight="1"
        android:fontFamily="@font/nt_500"
        android:gravity="center"
        android:paddingHorizontal="@dimen/_11sdp"
        android:textSize="@dimen/_10sdp"
        app:uiCornerRadius="@dimen/_8sdp"
        tools:text="Recent" />

    <com.ui.baselib.widget.view.UiTextView
        android:id="@+id/tvSecond"
        android:layout_width="0dp"
        android:layout_height="@dimen/_25sdp"
        android:layout_weight="1"
        android:fontFamily="@font/nt_500"
        android:gravity="center"
        android:paddingHorizontal="@dimen/_11sdp"
        android:textSize="@dimen/_10sdp"
        app:uiCornerRadius="@dimen/_8sdp"
        tools:text="Favorites" />

    <com.ui.baselib.widget.view.UiTextView
        android:id="@+id/tvThird"
        android:layout_width="0dp"
        android:layout_height="@dimen/_25sdp"
        android:layout_weight="1"
        android:fontFamily="@font/nt_500"
        android:gravity="center"
        android:paddingHorizontal="@dimen/_11sdp"
        android:textSize="@dimen/_10sdp"
        app:uiCornerRadius="@dimen/_8sdp"
        android:visibility="gone"
        tools:text="Side by side" />

</com.ui.baselib.widget.layout.UiLinearLayout>
