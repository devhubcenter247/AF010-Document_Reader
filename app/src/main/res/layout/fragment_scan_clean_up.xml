<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_scan_bg"
    android:orientation="vertical"
    tools:context=".ui.main.scan.fragment.ScanCleanUpFragment">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/_46sdp"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_9sdp">

        <com.ui.baselib.widget.view.UiImageView
            android:id="@+id/btnBack"
            style="@style/IconButtonStyle"
            android:contentDescription="@string/scanner_back"
            android:src="@drawable/ic_app_back"
            app:tint="@color/on_primary"
            app:uiBackgroundColor="@color/color_white_12" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_6sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nt_500"
                android:text="@string/scan_clean_up"
                android:textColor="@color/on_primary"
                android:textSize="@dimen/_12sdp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.7"
                android:ellipsize="end"
                android:fontFamily="@font/nt_400"
                android:maxLines="1"
                android:text="@string/scan_clean_hint"
                android:textColor="@color/on_primary"
                android:textSize="@dimen/_9sdp" />
        </LinearLayout>

        <com.ui.baselib.widget.view.UiTextView
            android:id="@+id/btnDone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_23sdp"
            android:fontFamily="@font/nt_600"
            android:gravity="center"
            android:paddingHorizontal="@dimen/_10sdp"
            android:text="@string/done"
            android:textSize="@dimen/_10sdp"
            app:uiBackgroundColor="@color/accent"
            app:uiCornerRadius="@dimen/_12sdp"
            app:uiTextColor="@color/on_accent" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.af010.creator.docreader.ui.main.scan.view.CleanUpView
            android:id="@+id/cleanView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/_15sdp" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/accent"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_54sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_12sdp"
        android:paddingBottom="@dimen/_7sdp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nt_500"
            android:text="@string/scan_brush"
            android:textColor="@color/on_primary"
            android:textSize="@dimen/_10sdp" />

        <SeekBar
            android:id="@+id/seekBrush"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_6sdp"
            android:layout_weight="1"
            android:max="100"
            android:progressBackgroundTint="@color/color_white_12"
            android:progressTint="@color/accent"
            android:thumbTint="@color/accent" />

        <com.ui.baselib.widget.view.UiImageView
            android:id="@+id/btnUndo"
            style="@style/IconButtonStyle"
            android:contentDescription="@string/undo"
            android:src="@drawable/ic_app_undo"
            app:tint="@color/on_primary"
            app:uiBackgroundColor="@color/color_white_12" />
    </LinearLayout>

</LinearLayout>
