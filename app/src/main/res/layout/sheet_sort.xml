<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingBottom="@dimen/_18sdp">

    <include
        android:id="@+id/header"
        layout="@layout/layout_sheet_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_15sdp">

        <include
            android:id="@+id/rowDate"
            layout="@layout/layout_choice_row" />

        <include
            android:id="@+id/rowName"
            layout="@layout/layout_choice_row"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_46sdp"
            android:layout_marginTop="@dimen/_5sdp" />

        <include
            android:id="@+id/rowSize"
            layout="@layout/layout_choice_row"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_46sdp"
            android:layout_marginTop="@dimen/_5sdp" />

        <include
            android:id="@+id/rowType"
            layout="@layout/layout_choice_row"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_46sdp"
            android:layout_marginTop="@dimen/_5sdp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_3sdp"
            android:layout_marginTop="@dimen/_14sdp"
            android:fontFamily="@font/nunito_700"
            android:text="@string/fo_order"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_10sdp" />

        <include
            android:id="@+id/segmentOrder"
            layout="@layout/layout_segment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_9sdp" />

        <TextView
            android:id="@+id/btnApply"
            style="@style/PrimaryPillButton"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/_14sdp"
            android:text="@string/fo_show_files" />
    </LinearLayout>
</LinearLayout>
