<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/BottomSheetAppStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_surface_card_r22sdp_22sdp_0_0"
    android:clipToOutline="true">

    <include
        android:id="@+id/header"
        layout="@layout/layout_sheet_header" />

    <TextView
        android:id="@+id/tvSortDate"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_40sdp"
        android:background="?attr/selectableItemBackground"
        android:drawablePadding="@dimen/_11sdp"
        android:fontFamily="@font/nunito_600"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/_15sdp"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/_12sdp"
        tools:drawableStartCompat="@drawable/ic_app_radio_off" />

    <TextView
        android:id="@+id/tvSortName"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_40sdp"
        android:background="?attr/selectableItemBackground"
        android:drawablePadding="@dimen/_11sdp"
        android:fontFamily="@font/nunito_600"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/_15sdp"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/_12sdp"
        tools:drawableStartCompat="@drawable/ic_app_radio_off" />

    <TextView
        android:id="@+id/tvSortSize"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_40sdp"
        android:background="?attr/selectableItemBackground"
        android:drawablePadding="@dimen/_11sdp"
        android:fontFamily="@font/nunito_600"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/_15sdp"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/_12sdp"
        tools:drawableStartCompat="@drawable/ic_app_radio_off" />

    <TextView
        android:id="@+id/tvSortType"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_40sdp"
        android:background="?attr/selectableItemBackground"
        android:drawablePadding="@dimen/_11sdp"
        android:fontFamily="@font/nunito_600"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/_15sdp"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/_12sdp"
        tools:drawableStartCompat="@drawable/ic_app_radio_off" />

    <include
        android:id="@+id/segmentOrder"
        layout="@layout/layout_segment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_9sdp" />

    <TextView
        android:id="@+id/btnApply"
        style="@style/ButtonAppStyle"
        android:layout_marginBottom="10sp"
        android:layout_width="match_parent"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_13sdp"
        android:text="@string/apply"
        android:background="@drawable/bg_button_primary"
        android:elevation="@dimen/_5sdp"
        android:outlineSpotShadowColor="@color/primary_30"
        android:outlineAmbientShadowColor="@color/primary_20"
        android:textColor="@color/white" />

</LinearLayout>
