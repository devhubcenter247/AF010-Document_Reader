<?xml version="1.0" encoding="utf-8"?>
<!-- A blank file to start from: its extension on a white badge over the app's name. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="@dimen/_80sdp"
    android:layout_weight="1"
    android:clipToOutline="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center"
    android:orientation="vertical"
    tools:background="@drawable/bg_blank_word">

    <TextView
        android:id="@+id/tvBadge"
        android:layout_width="@dimen/_34sdp"
        android:layout_height="@dimen/_34sdp"
        android:background="@drawable/bg_blank_badge"
        android:fontFamily="@font/nunito_700"
        android:gravity="center"
        android:textSize="@dimen/_9sdp"
        tools:text="DOCX"
        tools:textColor="@color/color_file_word" />

    <TextView
        android:id="@+id/tvName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8sdp"
        android:fontFamily="@font/nunito_700"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/_11sdp"
        tools:text="Word" />
</LinearLayout>
