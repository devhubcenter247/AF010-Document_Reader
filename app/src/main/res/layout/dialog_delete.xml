<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/DialogAppStyle"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/_17sdp"
    tools:context=".ui.dialog.DeleteDialog"
    android:background="@drawable/bg_surface_card_r18sdp"
    android:clipToOutline="true">

    <ImageView
        android:layout_width="@dimen/_55sdp"
        android:layout_height="@dimen/_55sdp"
        android:contentDescription="@null"
        android:padding="@dimen/_15sdp"
        android:src="@drawable/ic_app_trash"
        app:tint="@color/color_error"
        android:background="@drawable/bg_error_bg_r28sdp"
        android:clipToOutline="true" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_11sdp"
        android:fontFamily="@font/nt_600"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/_13sdp"
        tools:text="Delete 3 files?" />

    <TextView
        android:id="@+id/tvMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8sdp"
        android:fontFamily="@font/nt_400"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/_9sdp"
        tools:text="The files will be deleted from this device and can’t be recovered." />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_13sdp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancel"
            style="@style/ButtonOutlineStyle"
            android:layout_width="0dp"
            android:layout_marginEnd="@dimen/_4sdp"
            android:layout_weight="1"
            android:text="@string/file_action_cancel"
            android:background="@drawable/bg_surface_card_r10sdp_st1sdp_stroke"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/btnConfirm"
            style="@style/ButtonAppStyle"
            android:layout_width="0dp"
            android:layout_marginStart="@dimen/_4sdp"
            android:layout_weight="1"
            android:text="@string/file_action_delete"
            android:background="@drawable/bg_grad_gradient_start_gradient_end_270_r10sdp"
            android:textColor="@color/white" />
    </LinearLayout>

</LinearLayout>
