<?xml version="1.0" encoding="utf-8"?>
<!-- Deleting files: a tilted red bin, what goes, and Keep it / Delete. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:clipToPadding="false"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/_17sdp"
    android:paddingTop="@dimen/_18sdp"
    android:paddingBottom="@dimen/_15sdp"
    tools:context=".ui.dialog.DeleteDialog">

    <ImageView
        android:layout_width="@dimen/_49sdp"
        android:layout_height="@dimen/_49sdp"
        android:background="@drawable/bg_rounded_panel"
        android:backgroundTint="@color/color_file_pdf_bg"
        android:importantForAccessibility="no"
        android:padding="@dimen/_13sdp"
        android:rotation="-6"
        android:src="@drawable/ic_fo_trash"
        app:tint="@color/color_file_pdf" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_11sdp"
        android:fontFamily="@font/nunito_600"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/_15sdp" />

    <TextView
        android:id="@+id/tvMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_5sdp"
        android:fontFamily="@font/nunito_400"
        android:gravity="center"
        android:lineSpacingMultiplier="1.15"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/_10sdp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_14sdp"
        android:clipToPadding="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancel"
            style="@style/DialogSoftButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/fo_keep_it" />

        <TextView
            android:id="@+id/btnConfirm"
            style="@style/DialogPrimaryButton"
            android:layout_width="0dp"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_weight="1.3"
            android:background="@drawable/bg_button_danger"
            android:elevation="0dp"
            android:text="@string/file_action_delete" />
    </LinearLayout>
</LinearLayout>
