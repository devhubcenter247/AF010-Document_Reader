<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app"
    tools:context=".ui.welcome.WelcomeActivity">

    <!-- Header Title -->
    <TextView
        android:id="@+id/tvTitle"
        style="@style/TextHeadLine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:fontFamily="@font/nt_600"
        android:text="@string/welcome_use_case_title"
        android:textSize="@dimen/_13sdp"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tvSubtitle"
        style="@style/TextSubContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_3sdp"
        android:fontFamily="@font/nt_400"
        android:text="@string/welcome_use_case_subtitle"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcvUseCase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_7sdp"
        android:layout_marginTop="@dimen/_7sdp"
        android:overScrollMode="never"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="2"
        app:layout_constraintTop_toBottomOf="@+id/tvSubtitle"
        tools:listitem="@layout/item_use_case" />

    <FrameLayout
        android:id="@+id/layoutContinue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.ui.baselib.widget.view.UiTextView
            android:id="@+id/btnContinue"
            style="@style/ButtonAppStyle"
            android:layout_width="match_parent"
            android:layout_marginHorizontal="@dimen/_13sdp"
            android:layout_marginVertical="@dimen/_10sdp"
            android:text="@string/txt_continues"
            app:uiShadowClipParent="force"
            app:uiShadowColor="@color/primary_30" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
