<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app"
    tools:context=".ui.main.settings.SettingsFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:liftOnScroll="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/_5sdp"
            android:paddingStart="@dimen/_15sdp"
            android:paddingEnd="@dimen/_13sdp">

            <TextView
                style="@style/TextScreenTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings"
                android:textSize="@dimen/_15sdp" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/_15sdp">

            <!-- Premium -->
            <com.ui.baselib.widget.layout.UiConstraintLayout
                android:id="@+id/cardPremium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_13sdp"
                android:clipToPadding="false"
                android:padding="@dimen/_10sdp"
                app:uiBackgroundGradientEnabled="true"
                app:uiBackgroundGradientEnd="@color/gradient_end"
                app:uiBackgroundGradientOrientation="tl_br"
                app:uiBackgroundGradientStart="@color/gradient_start"
                app:uiCornerRadius="@dimen/_18sdp">

                <com.ui.baselib.widget.layout.UiFrameLayout
                    android:layout_width="@dimen/_54sdp"
                    android:layout_height="@dimen/_54sdp"
                    android:rotation="10"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:uiBackgroundColor="@color/color_white_16"
                    app:uiCornerRadius="@dimen/_18sdp">

                    <com.ui.baselib.widget.view.UiImageView
                        android:layout_width="@dimen/_35sdp"
                        android:layout_height="@dimen/_35sdp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:padding="@dimen/_9sdp"
                        android:rotation="-10"
                        android:src="@drawable/ic_app_crown"
                        app:tint="#5A3300"
                        app:uiBackgroundGradientEnabled="true"
                        app:uiBackgroundGradientEnd="@color/color_premium_gold"
                        app:uiBackgroundGradientOrientation="tl_br"
                        app:uiBackgroundGradientStart="#FFE08A"
                        app:uiCornerRadius="@dimen/_13sdp" />
                </com.ui.baselib.widget.layout.UiFrameLayout>

                <TextView
                    android:id="@+id/tvPlan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nt_600"
                    android:letterSpacing="0.08"
                    android:text="@string/free_plan"
                    android:textAllCaps="true"
                    android:textColor="@color/color_on_gradient_secondary"
                    android:textSize="@dimen/_9sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvPremiumTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:layout_marginEnd="@dimen/_67sdp"
                    android:fontFamily="@font/nt_600"
                    android:text="@string/premium_title"
                    android:textColor="@color/on_primary"
                    android:textSize="@dimen/_13sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvPlan" />

                <com.ui.baselib.widget.flexbox.FlexboxLayout
                    android:id="@+id/layoutBenefits"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_7sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvPremiumTitle"
                    app:uiFlexWrap="wrap">

                    <com.ui.baselib.widget.view.UiTextView
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_22sdp"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:layout_marginEnd="@dimen/_5sdp"
                        android:drawablePadding="@dimen/_3sdp"
                        android:fontFamily="@font/nt_500"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/_5sdp"
                        android:text="@string/no_ads"
                        android:textSize="@dimen/_9sdp"
                        app:drawableStartCompat="@drawable/ic_app_eyeoff"
                        app:drawableTint="@color/on_primary"
                        app:uiBackgroundColor="@color/color_white_16"
                        app:uiCornerRadius="@dimen/_12sdp"
                        app:uiDrawableSize="@dimen/_11sdp"
                        app:uiTextColor="@color/on_primary" />

                    <com.ui.baselib.widget.view.UiTextView
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_22sdp"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:layout_marginEnd="@dimen/_5sdp"
                        android:drawablePadding="@dimen/_3sdp"
                        android:fontFamily="@font/nt_500"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/_5sdp"
                        android:text="@string/unlimited_tools"
                        android:textSize="@dimen/_9sdp"
                        app:drawableStartCompat="@drawable/ic_app_sparkle"
                        app:drawableTint="@color/on_primary"
                        app:uiBackgroundColor="@color/color_white_16"
                        app:uiCornerRadius="@dimen/_12sdp"
                        app:uiDrawableSize="@dimen/_11sdp"
                        app:uiTextColor="@color/on_primary" />

                    <com.ui.baselib.widget.view.UiTextView
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_22sdp"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:layout_marginEnd="@dimen/_5sdp"
                        android:drawablePadding="@dimen/_3sdp"
                        android:fontFamily="@font/nt_500"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/_5sdp"
                        android:text="@string/tool_ocr"
                        android:textSize="@dimen/_9sdp"
                        app:drawableStartCompat="@drawable/ic_app_ocr"
                        app:drawableTint="@color/on_primary"
                        app:uiBackgroundColor="@color/color_white_16"
                        app:uiCornerRadius="@dimen/_12sdp"
                        app:uiDrawableSize="@dimen/_11sdp"
                        app:uiTextColor="@color/on_primary" />

                </com.ui.baselib.widget.flexbox.FlexboxLayout>

                <com.ui.baselib.widget.view.UiTextView
                    android:id="@+id/btnTrial"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_33sdp"
                    android:layout_marginTop="@dimen/_13sdp"
                    android:drawablePadding="@dimen/_6sdp"
                    android:fontFamily="@font/nt_600"
                    android:gravity="center"
                    android:text="@string/start_free_trial"
                    android:textSize="@dimen/_11sdp"
                    app:drawableEndCompat="@drawable/ic_app_arrowr"
                    app:drawableTint="@color/primary_dark"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/layoutBenefits"
                    app:uiBackgroundColor="@color/on_primary"
                    app:uiCornerRadius="@dimen/_13sdp"
                    app:uiDrawableAlign="text"
                    app:uiDrawableSize="@dimen/_13sdp"
                    app:uiTextColor="@color/primary_dark" />
            </com.ui.baselib.widget.layout.UiConstraintLayout>

            <TextView
                style="@style/TextSectionCaps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/_15sdp"
                android:paddingTop="@dimen/_13sdp"
                android:paddingBottom="@dimen/_7sdp"
                android:text="@string/preferences" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_13sdp"
                android:orientation="horizontal">

                <com.ui.baselib.widget.layout.UiLinearLayout
                    android:id="@+id/cardLanguage"
                    style="@style/CardAppStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_4sdp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/_9sdp"
                    android:paddingVertical="@dimen/_11sdp">

                    <FrameLayout
                        android:layout_width="@dimen/_31sdp"
                        android:layout_height="@dimen/_31sdp">

                        <com.ui.baselib.widget.layout.UiView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:uiBackgroundColor="@color/color_eaf2ff"
                            app:uiCornerRadius="@dimen/_10sdp" />

                        <com.ui.baselib.widget.view.UiImageView
                            android:layout_width="@dimen/_20sdp"
                            android:layout_height="@dimen/_20sdp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:padding="@dimen/_4sdp"
                            android:src="@drawable/ic_app_globe"
                            app:tint="@color/on_primary"
                            app:uiBackgroundColor="@color/color_3984ff"
                            app:uiCornerRadius="@dimen/_7sdp" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_9sdp"
                        android:ellipsize="end"
                        android:fontFamily="@font/nt_400"
                        android:maxLines="1"
                        android:text="@string/language"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/_9sdp" />

                    <com.ui.baselib.widget.view.UiTextView
                        android:id="@+id/tvLanguage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:ellipsize="end"
                        android:fontFamily="@font/nt_500"
                        android:maxLines="1"
                        android:textSize="@dimen/_10sdp"
                        app:drawableEndCompat="@drawable/ic_app_chev"
                        app:drawableTint="@color/color_icon_muted"
                        app:uiDrawableSize="@dimen/_11sdp"
                        app:uiTextColor="@color/text_primary"
                        tools:text="English" />
                </com.ui.baselib.widget.layout.UiLinearLayout>

                <com.ui.baselib.widget.layout.UiLinearLayout
                    android:id="@+id/cardTheme"
                    style="@style/CardAppStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:layout_marginEnd="@dimen/_4sdp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/_9sdp"
                    android:paddingVertical="@dimen/_11sdp">

                    <FrameLayout
                        android:layout_width="@dimen/_31sdp"
                        android:layout_height="@dimen/_31sdp">

                        <com.ui.baselib.widget.layout.UiView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:uiBackgroundColor="@color/color_fdebf5"
                            app:uiCornerRadius="@dimen/_10sdp" />

                        <com.ui.baselib.widget.view.UiImageView
                            android:layout_width="@dimen/_20sdp"
                            android:layout_height="@dimen/_20sdp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:padding="@dimen/_4sdp"
                            android:src="@drawable/ic_app_palette"
                            app:tint="@color/on_primary"
                            app:uiBackgroundColor="@color/color_ef4da8"
                            app:uiCornerRadius="@dimen/_7sdp" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_9sdp"
                        android:ellipsize="end"
                        android:fontFamily="@font/nt_400"
                        android:maxLines="1"
                        android:text="@string/theme"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/_9sdp" />

                    <com.ui.baselib.widget.view.UiTextView
                        android:id="@+id/tvTheme"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:ellipsize="end"
                        android:fontFamily="@font/nt_500"
                        android:maxLines="1"
                        android:textSize="@dimen/_10sdp"
                        app:drawableEndCompat="@drawable/ic_app_chev"
                        app:drawableTint="@color/color_icon_muted"
                        app:uiDrawableSize="@dimen/_11sdp"
                        app:uiTextColor="@color/text_primary"
                        tools:text="English" />
                </com.ui.baselib.widget.layout.UiLinearLayout>

            </LinearLayout>

            <TextView
                style="@style/TextSectionCaps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/_15sdp"
                android:paddingTop="@dimen/_13sdp"
                android:paddingBottom="@dimen/_7sdp"
                android:text="@string/support" />

            <com.ui.baselib.widget.layout.UiLinearLayout
                style="@style/CardAppStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_13sdp"
                android:orientation="vertical"
                android:padding="@dimen/_13sdp"
                app:uiCornerRadius="@dimen/_15sdp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nt_600"
                    android:text="@string/enjoying_the_app"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/_12sdp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:fontFamily="@font/nt_400"
                    android:text="@string/tap_a_star_to_rate"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/_10sdp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_9sdp"
                    android:orientation="horizontal">

                    <com.ui.baselib.widget.view.UiImageView
                        android:id="@+id/btnStar1"
                        android:layout_width="@dimen/_33sdp"
                        android:layout_height="@dimen/_33sdp"
                        android:contentDescription="@string/rate_us"
                        android:padding="@dimen/_8sdp"
                        android:src="@drawable/ic_app_star"
                        app:tint="@color/color_e4a11b"
                        app:uiBackgroundColor="@color/color_fff6da"
                        app:uiCornerRadius="@dimen/_11sdp" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <com.ui.baselib.widget.view.UiImageView
                        android:id="@+id/btnStar2"
                        android:layout_width="@dimen/_33sdp"
                        android:layout_height="@dimen/_33sdp"
                        android:contentDescription="@string/rate_us"
                        android:padding="@dimen/_8sdp"
                        android:src="@drawable/ic_app_star"
                        app:tint="@color/color_e4a11b"
                        app:uiBackgroundColor="@color/color_fff6da"
                        app:uiCornerRadius="@dimen/_11sdp" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <com.ui.baselib.widget.view.UiImageView
                        android:id="@+id/btnStar3"
                        android:layout_width="@dimen/_33sdp"
                        android:layout_height="@dimen/_33sdp"
                        android:contentDescription="@string/rate_us"
                        android:padding="@dimen/_8sdp"
                        android:src="@drawable/ic_app_star"
                        app:tint="@color/color_e4a11b"
                        app:uiBackgroundColor="@color/color_fff6da"
                        app:uiCornerRadius="@dimen/_11sdp" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <com.ui.baselib.widget.view.UiImageView
                        android:id="@+id/btnStar4"
                        android:layout_width="@dimen/_33sdp"
                        android:layout_height="@dimen/_33sdp"
                        android:contentDescription="@string/rate_us"
                        android:padding="@dimen/_8sdp"
                        android:src="@drawable/ic_app_star"
                        app:tint="@color/color_e4a11b"
                        app:uiBackgroundColor="@color/color_fff6da"
                        app:uiCornerRadius="@dimen/_11sdp" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <com.ui.baselib.widget.view.UiImageView
                        android:id="@+id/btnStar5"
                        android:layout_width="@dimen/_33sdp"
                        android:layout_height="@dimen/_33sdp"
                        android:contentDescription="@string/rate_us"
                        android:padding="@dimen/_8sdp"
                        android:src="@drawable/ic_app_star"
                        app:tint="@color/color_e4a11b"
                        app:uiBackgroundColor="@color/color_fff6da"
                        app:uiCornerRadius="@dimen/_11sdp" />

                </LinearLayout>
            </com.ui.baselib.widget.layout.UiLinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="@dimen/_8sdp" />

            <com.ui.baselib.widget.layout.UiLinearLayout
                style="@style/CardAppStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_13sdp"
                android:orientation="vertical"
                app:uiCornerRadius="@dimen/_15sdp">

                <LinearLayout
                    android:id="@+id/rowShare"
                    style="@style/SettingRowStyle">

                    <com.ui.baselib.widget.view.UiImageView
                        style="@style/SettingRowIconStyle"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_app_share"
                        app:tint="@color/color_3984ff"
                        app:uiBackgroundColor="@color/color_eaf2ff" />

                    <TextView
                        style="@style/RowLabelStyle"
                        android:text="@string/share_the_app" />

                    <ImageView
                        style="@style/RowChevronStyle"
                        android:contentDescription="@null" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowFeedback"
                    style="@style/SettingRowStyle">

                    <com.ui.baselib.widget.view.UiImageView
                        style="@style/SettingRowIconStyle"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_app_chat"
                        app:tint="@color/color_14b8a6"
                        app:uiBackgroundColor="@color/color_e0f8f3" />

                    <TextView
                        style="@style/RowLabelStyle"
                        android:text="@string/send_feedback" />

                    <ImageView
                        style="@style/RowChevronStyle"
                        android:contentDescription="@null" />
                </LinearLayout>
            </com.ui.baselib.widget.layout.UiLinearLayout>

            <TextView
                android:id="@+id/tvPremiumSection"
                style="@style/TextSectionCaps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/_15sdp"
                android:paddingTop="@dimen/_13sdp"
                android:paddingBottom="@dimen/_7sdp"
                android:text="@string/premium" />

            <com.ui.baselib.widget.layout.UiLinearLayout
                android:id="@+id/cardPremiumRows"
                style="@style/CardAppStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_13sdp"
                android:orientation="vertical"
                app:uiCornerRadius="@dimen/_15sdp">

                <LinearLayout
                    android:id="@+id/rowRestore"
                    style="@style/SettingRowStyle">

                    <com.ui.baselib.widget.view.UiImageView
                        style="@style/SettingRowIconStyle"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_app_restore"
                        app:tint="@color/color_35ac71"
                        app:uiBackgroundColor="@color/color_e7f7ed" />

                    <TextView
                        style="@style/RowLabelStyle"
                        android:text="@string/restore_purchases" />

                    <ImageView
                        style="@style/RowChevronStyle"
                        android:contentDescription="@null" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowSubscription"
                    style="@style/SettingRowStyle">

                    <com.ui.baselib.widget.view.UiImageView
                        style="@style/SettingRowIconStyle"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_app_crown"
                        app:tint="@color/text_on_selected"
                        app:uiBackgroundColor="@color/color_bg_selected" />

                    <TextView
                        style="@style/RowLabelStyle"
                        android:text="@string/manage_subscription" />

                    <ImageView
                        style="@style/RowChevronStyle"
                        android:contentDescription="@null" />
                </LinearLayout>
            </com.ui.baselib.widget.layout.UiLinearLayout>

            <TextView
                style="@style/TextSectionCaps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/_15sdp"
                android:paddingTop="@dimen/_13sdp"
                android:paddingBottom="@dimen/_7sdp"
                android:text="@string/about" />

            <com.ui.baselib.widget.layout.UiLinearLayout
                style="@style/CardAppStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_13sdp"
                android:orientation="vertical"
                app:uiCornerRadius="@dimen/_15sdp">

                <LinearLayout
                    android:id="@+id/rowPrivacy"
                    style="@style/SettingRowStyle">

                    <com.ui.baselib.widget.view.UiImageView
                        style="@style/SettingRowIconStyle"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_app_shield"
                        app:tint="@color/text_secondary"
                        app:uiBackgroundColor="@color/color_surface_variant" />

                    <TextView
                        style="@style/RowLabelStyle"
                        android:text="@string/privacy_policy" />

                    <ImageView
                        style="@style/RowChevronStyle"
                        android:contentDescription="@null" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowTerms"
                    style="@style/SettingRowStyle">

                    <com.ui.baselib.widget.view.UiImageView
                        style="@style/SettingRowIconStyle"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_app_file"
                        app:tint="@color/text_secondary"
                        app:uiBackgroundColor="@color/color_surface_variant" />

                    <TextView
                        style="@style/RowLabelStyle"
                        android:text="@string/term_of_service" />

                    <ImageView
                        style="@style/RowChevronStyle"
                        android:contentDescription="@null" />
                </LinearLayout>
            </com.ui.baselib.widget.layout.UiLinearLayout>

            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_13sdp"
                android:fontFamily="@font/nt_400"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_9sdp"
                tools:text="PDF Reader &amp; Editor · Version 1.0.0" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
