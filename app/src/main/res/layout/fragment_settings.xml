<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/_100sdp"
    tools:context=".ui.main.settings.SettingsFragment">

    <LinearLayout
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_15sdp">

        <!-- Header in the Files and Tools style: the mascot, the title and the app's version -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="@dimen/_8sdp"
            android:paddingBottom="@dimen/_12sdp">

            <FrameLayout
                android:layout_width="@dimen/_38sdp"
                android:layout_height="@dimen/_38sdp"
                android:background="@drawable/bg_mascot_tile"
                android:rotation="-6">

                <ImageView
                    android:layout_width="@dimen/_22sdp"
                    android:layout_height="@dimen/_28sdp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_mascot_smile_ink" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/DisplayTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings" />

                <TextView
                    android:id="@+id/tvVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito_500"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/_11sdp"
                    tools:text="Folio 1.0.0 (1) · Made with care" />
            </LinearLayout>
        </LinearLayout>

        <!-- Free plan: the Pro offer -->
        <FrameLayout
            android:id="@+id/cardPremium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pro_card"
            android:clipToOutline="true"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="@dimen/_14sdp"
                android:layout_height="@dimen/_14sdp"
                android:layout_gravity="top|end"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_marginEnd="@dimen/_88sdp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_sparkle"
                app:tint="@color/color_pro" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/_14sdp">

                <ImageView
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="@dimen/_40sdp"
                    android:background="@drawable/bg_crown_tile"
                    android:importantForAccessibility="no"
                    android:padding="@dimen/_10sdp"
                    android:rotation="-6"
                    android:src="@drawable/ic_fo_crown"
                    app:tint="@color/on_accent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_11sdp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPlan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_700"
                        android:text="@string/fo_free_plan"
                        android:textColor="@color/color_warning"
                        android:textSize="@dimen/_10sdp" />

                    <TextView
                        android:id="@+id/tvPremiumTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:fontFamily="@font/nunito_700"
                        android:lineSpacingMultiplier="1.1"
                        android:text="@string/fo_free_plan_pitch"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/_12sdp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnTrial"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_29sdp"
                    android:background="@drawable/bg_ink_pill"
                    android:fontFamily="@font/nunito_700"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingHorizontal="@dimen/_11sdp"
                    android:text="@string/fo_try_free"
                    android:textColor="@color/on_primary"
                    android:textSize="@dimen/_10sdp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_2sdp"
            android:paddingTop="@dimen/_6sdp"
            android:paddingBottom="@dimen/_8sdp">

            <View
                android:layout_width="@dimen/_10sdp"
                android:layout_height="@dimen/_10sdp"
                android:background="@drawable/bg_letter_badge"
                android:backgroundTint="@color/primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_7sdp"
                android:fontFamily="@font/nunito_700"
                android:text="@string/fo_make_it_yours"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_14sdp" />
        </LinearLayout>

        <LinearLayout
            style="@style/HomeCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToOutline="true"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_6sdp"
            android:paddingVertical="@dimen/_3sdp">

            <include
                android:id="@+id/rowLanguage"
                layout="@layout/layout_settings_row" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="@dimen/_46sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                android:background="@color/color_stroke" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/_8sdp"
                android:paddingTop="@dimen/_9sdp"
                android:paddingBottom="@dimen/_11sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/_29sdp"
                        android:layout_height="@dimen/_29sdp"
                        android:background="@drawable/bg_tool_glyph"
                        android:backgroundTint="@color/color_file_image"
                        android:importantForAccessibility="no"
                        android:padding="@dimen/_7sdp"
                        android:src="@drawable/ic_fo_moon"
                        app:tint="@color/on_primary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_9sdp"
                        android:layout_weight="1"
                        android:fontFamily="@font/nunito_700"
                        android:text="@string/fo_theme"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/_12sdp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/themeAuto"
                        layout="@layout/layout_theme_option" />

                    <Space
                        android:layout_width="@dimen/_8sdp"
                        android:layout_height="0dp" />

                    <include
                        android:id="@+id/themeLight"
                        layout="@layout/layout_theme_option" />

                    <Space
                        android:layout_width="@dimen/_8sdp"
                        android:layout_height="0dp" />

                    <include
                        android:id="@+id/themeDark"
                        layout="@layout/layout_theme_option" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Rating: the mascot asks, five stars answer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp"
            android:background="@drawable/bg_rate_card"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/_11sdp"
            android:paddingStart="@dimen/_12sdp"
            android:paddingEnd="@dimen/_6sdp">

            <ImageView
                android:layout_width="@dimen/_38sdp"
                android:layout_height="@dimen/_48sdp"
                android:importantForAccessibility="no"
                android:rotation="-6"
                android:src="@drawable/ic_mascot_smile" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_7sdp"
                    android:fontFamily="@font/nunito_700"
                    android:text="@string/fo_rate_0"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/_12sdp" />

                <LinearLayout
                    android:id="@+id/layoutStars"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_2sdp"
            android:paddingTop="@dimen/_16sdp"
            android:paddingBottom="@dimen/_8sdp">

            <View
                android:layout_width="@dimen/_10sdp"
                android:layout_height="@dimen/_10sdp"
                android:background="@drawable/bg_letter_badge"
                android:backgroundTint="@color/color_file_image" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_7sdp"
                android:fontFamily="@font/nunito_700"
                android:text="@string/fo_about"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_14sdp" />
        </LinearLayout>

        <LinearLayout
            style="@style/HomeCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToOutline="true"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_6sdp"
            android:paddingVertical="@dimen/_3sdp">

            <include
                android:id="@+id/rowPrivacy"
                layout="@layout/layout_settings_row" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="@dimen/_46sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                android:background="@color/color_stroke" />

            <include
                android:id="@+id/rowShare"
                layout="@layout/layout_settings_row" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
