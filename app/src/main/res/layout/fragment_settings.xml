<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/_100sdp"
    tools:context=".ui.main.settings.SettingsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_15sdp">

        <TextView
            style="@style/DisplayTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/_8sdp"
            android:paddingBottom="@dimen/_11sdp"
            android:text="@string/settings" />

        <!-- Free plan: the Pro offer -->
        <FrameLayout
            android:id="@+id/cardPremium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pro_card"
            android:clipToOutline="true"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="@dimen/_14sdp"
                android:layout_height="@dimen/_14sdp"
                android:layout_gravity="top|end"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_marginEnd="@dimen/_88sdp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_sparkle"
                app:tint="@color/color_pro" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/_14sdp">

                <ImageView
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="@dimen/_40sdp"
                    android:background="@drawable/bg_crown_tile"
                    android:importantForAccessibility="no"
                    android:padding="@dimen/_10sdp"
                    android:rotation="-6"
                    android:src="@drawable/ic_fo_crown"
                    app:tint="@color/on_accent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_11sdp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPlan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_800"
                        android:text="@string/fo_free_plan"
                        android:textColor="@color/color_warning"
                        android:textSize="@dimen/_10sdp" />

                    <TextView
                        android:id="@+id/tvPremiumTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:fontFamily="@font/nunito_800"
                        android:lineSpacingMultiplier="1.1"
                        android:text="@string/fo_free_plan_pitch"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/_12sdp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnTrial"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_29sdp"
                    android:background="@drawable/bg_ink_pill"
                    android:fontFamily="@font/nunito_800"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingHorizontal="@dimen/_11sdp"
                    android:text="@string/fo_try_free"
                    android:textColor="@color/on_primary"
                    android:textSize="@dimen/_10sdp" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            style="@style/SectionHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/_17sdp"
            android:paddingBottom="@dimen/_8sdp"
            android:text="@string/fo_make_it_yours" />

        <LinearLayout
            style="@style/FloatingCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_benefits_card"
            android:clipToOutline="true"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_6sdp"
            android:paddingVertical="@dimen/_3sdp">

            <include
                android:id="@+id/rowLanguage"
                layout="@layout/layout_settings_row" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/_2sdp"
                android:layout_marginHorizontal="@dimen/_6sdp"
                android:background="@drawable/line_dashed" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/_49sdp"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/_8sdp">

                <ImageView
                    android:layout_width="@dimen/_29sdp"
                    android:layout_height="@dimen/_29sdp"
                    android:background="@drawable/bg_soft_teal_tile"
                    android:importantForAccessibility="no"
                    android:padding="@dimen/_7sdp"
                    android:src="@drawable/ic_fo_moon"
                    app:tint="@color/color_file_image" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_9sdp"
                    android:layout_weight="1"
                    android:fontFamily="@font/nunito_800"
                    android:text="@string/fo_theme"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/_12sdp" />

                <include
                    android:id="@+id/segmentTheme"
                    layout="@layout/layout_segment"
                    android:layout_width="@dimen/_146sdp"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/_2sdp"
                android:layout_marginHorizontal="@dimen/_6sdp"
                android:background="@drawable/line_dashed" />

            <include
                android:id="@+id/rowUseCases"
                layout="@layout/layout_settings_row" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_11sdp"
            android:background="@drawable/bg_rate_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/_12sdp">

            <TextView
                android:id="@+id/tvRate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_800"
                android:text="@string/fo_rate_0"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_12sdp" />

            <LinearLayout
                android:id="@+id/layoutStars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                android:orientation="horizontal" />
        </LinearLayout>

        <TextView
            style="@style/SectionHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/_17sdp"
            android:paddingBottom="@dimen/_8sdp"
            android:text="@string/fo_about" />

        <LinearLayout
            style="@style/FloatingCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_benefits_card"
            android:clipToOutline="true"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_6sdp"
            android:paddingVertical="@dimen/_3sdp">

            <include
                android:id="@+id/rowPrivacy"
                layout="@layout/layout_settings_row" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/_2sdp"
                android:layout_marginHorizontal="@dimen/_6sdp"
                android:background="@drawable/line_dashed" />

            <include
                android:id="@+id/rowShare"
                layout="@layout/layout_settings_row" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_700"
            android:gravity="center"
            android:paddingTop="@dimen/_11sdp"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_10sdp"
            tools:text="Folio 1.0.0 (1) · Made with care" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
