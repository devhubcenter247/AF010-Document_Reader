<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app"
    tools:context=".ui.main.settings.SettingsFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:liftOnScroll="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/_5sdp"
            android:paddingStart="@dimen/_15sdp"
            android:paddingEnd="@dimen/_13sdp">

            <TextView
                style="@style/TextScreenTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings"
                android:textSize="@dimen/_15sdp" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/_15sdp">

            <!-- Premium -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardPremium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_13sdp"
                android:clipToPadding="false"
                android:padding="@dimen/_10sdp"
                android:background="@drawable/bg_grad_gradient_start_gradient_end_315_r18sdp"
                android:clipToOutline="true">

                <FrameLayout
                    android:layout_width="@dimen/_54sdp"
                    android:layout_height="@dimen/_54sdp"
                    android:rotation="10"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:background="@drawable/bg_white_16_r18sdp"
                    android:clipToOutline="true">

                    <ImageView
                        android:layout_width="@dimen/_35sdp"
                        android:layout_height="@dimen/_35sdp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:padding="@dimen/_9sdp"
                        android:rotation="-10"
                        android:src="@drawable/ic_app_crown"
                        app:tint="#5A3300"
                        android:background="@drawable/bg_grad_xffe08a_premium_gold_315_r13sdp"
                        android:clipToOutline="true" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvPlan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nt_600"
                    android:letterSpacing="0.08"
                    android:text="@string/free_plan"
                    android:textAllCaps="true"
                    android:textColor="@color/color_on_gradient_secondary"
                    android:textSize="@dimen/_9sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvPremiumTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:layout_marginEnd="@dimen/_67sdp"
                    android:fontFamily="@font/nt_600"
                    android:text="@string/premium_title"
                    android:textColor="@color/on_primary"
                    android:textSize="@dimen/_13sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvPlan" />

                <com.ui.baselib.widget.flexbox.FlexboxLayout
                    android:id="@+id/layoutBenefits"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_7sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvPremiumTitle"
                    app:uiFlexWrap="wrap">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_22sdp"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:layout_marginEnd="@dimen/_5sdp"
                        android:drawablePadding="@dimen/_3sdp"
                        android:fontFamily="@font/nt_500"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/_5sdp"
                        android:text="@string/no_ads"
                        android:textSize="@dimen/_9sdp"
                        app:drawableTint="@color/on_primary"
                        android:background="@drawable/bg_white_16_r12sdp"
                        android:textColor="@color/on_primary"
                        app:drawableStartCompat="@drawable/ic_app_eyeoff_11sdp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_22sdp"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:layout_marginEnd="@dimen/_5sdp"
                        android:drawablePadding="@dimen/_3sdp"
                        android:fontFamily="@font/nt_500"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/_5sdp"
                        android:text="@string/unlimited_tools"
                        android:textSize="@dimen/_9sdp"
                        app:drawableTint="@color/on_primary"
                        android:background="@drawable/bg_white_16_r12sdp"
                        android:textColor="@color/on_primary"
                        app:drawableStartCompat="@drawable/ic_app_sparkle_11sdp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_22sdp"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:layout_marginEnd="@dimen/_5sdp"
                        android:drawablePadding="@dimen/_3sdp"
                        android:fontFamily="@font/nt_500"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/_5sdp"
                        android:text="@string/tool_ocr"
                        android:textSize="@dimen/_9sdp"
                        app:drawableTint="@color/on_primary"
                        android:background="@drawable/bg_white_16_r12sdp"
                        android:textColor="@color/on_primary"
                        app:drawableStartCompat="@drawable/ic_app_ocr_11sdp" />

                </com.ui.baselib.widget.flexbox.FlexboxLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTrial"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_33sdp"
                    android:layout_marginTop="@dimen/_13sdp"
                    android:fontFamily="@font/nt_600"
                    android:gravity="center"
                    android:text="@string/start_free_trial"
                    android:textSize="@dimen/_11sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/layoutBenefits"
                    android:background="@drawable/bg_on_primary_r13sdp"
                    android:textColor="@color/primary_dark"
                    app:icon="@drawable/ic_app_arrowr"
                    app:iconGravity="textEnd"
                    app:iconPadding="@dimen/_6sdp"
                    app:iconSize="@dimen/_13sdp"
                    app:iconTint="@color/primary_dark"
                    app:backgroundTint="@null"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:textAllCaps="false"
                    android:letterSpacing="0"
                    android:stateListAnimator="@null"
                    android:paddingHorizontal="0dp"
                    android:paddingVertical="0dp"
                    android:elevation="0dp" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                style="@style/TextSectionCaps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/_15sdp"
                android:paddingTop="@dimen/_13sdp"
                android:paddingBottom="@dimen/_7sdp"
                android:text="@string/preferences" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_13sdp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/cardLanguage"
                    style="@style/CardAppStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_4sdp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/_9sdp"
                    android:paddingVertical="@dimen/_11sdp"
                    android:background="@drawable/bg_surface_card_r15sdp"
                    android:foreground="@drawable/stroke_r15sdp_st1sdp_stroke"
                    android:clipToOutline="true">

                    <FrameLayout
                        android:layout_width="@dimen/_31sdp"
                        android:layout_height="@dimen/_31sdp">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_eaf2ff_r10sdp" />

                        <ImageView
                            android:layout_width="@dimen/_20sdp"
                            android:layout_height="@dimen/_20sdp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:padding="@dimen/_4sdp"
                            android:src="@drawable/ic_app_globe"
                            app:tint="@color/on_primary"
                            android:background="@drawable/bg_3984ff_r7sdp"
                            android:clipToOutline="true" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_9sdp"
                        android:ellipsize="end"
                        android:fontFamily="@font/nt_400"
                        android:maxLines="1"
                        android:text="@string/language"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/_9sdp" />

                    <TextView
                        android:id="@+id/tvLanguage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:ellipsize="end"
                        android:fontFamily="@font/nt_500"
                        android:maxLines="1"
                        android:textSize="@dimen/_10sdp"
                        app:drawableTint="@color/color_icon_muted"
                        tools:text="English"
                        android:textColor="@color/text_primary"
                        app:drawableEndCompat="@drawable/ic_app_chev_11sdp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardTheme"
                    style="@style/CardAppStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:layout_marginEnd="@dimen/_4sdp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/_9sdp"
                    android:paddingVertical="@dimen/_11sdp"
                    android:background="@drawable/bg_surface_card_r15sdp"
                    android:foreground="@drawable/stroke_r15sdp_st1sdp_stroke"
                    android:clipToOutline="true">

                    <FrameLayout
                        android:layout_width="@dimen/_31sdp"
                        android:layout_height="@dimen/_31sdp">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_fdebf5_r10sdp" />

                        <ImageView
                            android:layout_width="@dimen/_20sdp"
                            android:layout_height="@dimen/_20sdp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:padding="@dimen/_4sdp"
                            android:src="@drawable/ic_app_palette"
                            app:tint="@color/on_primary"
                            android:background="@drawable/bg_ef4da8_r7sdp"
                            android:clipToOutline="true" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_9sdp"
                        android:ellipsize="end"
                        android:fontFamily="@font/nt_400"
                        android:maxLines="1"
                        android:text="@string/theme"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/_9sdp" />

                    <TextView
                        android:id="@+id/tvTheme"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:ellipsize="end"
                        android:fontFamily="@font/nt_500"
                        android:maxLines="1"
                        android:textSize="@dimen/_10sdp"
                        app:drawableTint="@color/color_icon_muted"
                        tools:text="English"
                        android:textColor="@color/text_primary"
                        app:drawableEndCompat="@drawable/ic_app_chev_11sdp" />
                </LinearLayout>

            </LinearLayout>

            <TextView
                style="@style/TextSectionCaps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/_15sdp"
                android:paddingTop="@dimen/_13sdp"
                android:paddingBottom="@dimen/_7sdp"
                android:text="@string/support" />

            <LinearLayout
                style="@style/CardAppStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_13sdp"
                android:orientation="vertical"
                android:padding="@dimen/_13sdp"
                android:background="@drawable/bg_surface_card_r15sdp"
                android:foreground="@drawable/stroke_r15sdp_st1sdp_stroke"
                android:clipToOutline="true">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nt_600"
                    android:text="@string/enjoying_the_app"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/_12sdp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:fontFamily="@font/nt_400"
                    android:text="@string/tap_a_star_to_rate"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/_10sdp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_9sdp"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/btnStar1"
                        android:layout_width="@dimen/_33sdp"
                        android:layout_height="@dimen/_33sdp"
                        android:contentDescription="@string/rate_us"
                        android:padding="@dimen/_8sdp"
                        android:src="@drawable/ic_app_star"
                        app:tint="@color/color_e4a11b"
                        android:background="@drawable/bg_fff6da_r11sdp"
                        android:clipToOutline="true" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/btnStar2"
                        android:layout_width="@dimen/_33sdp"
                        android:layout_height="@dimen/_33sdp"
                        android:contentDescription="@string/rate_us"
                        android:padding="@dimen/_8sdp"
                        android:src="@drawable/ic_app_star"
                        app:tint="@color/color_e4a11b"
                        android:background="@drawable/bg_fff6da_r11sdp"
                        android:clipToOutline="true" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/btnStar3"
                        android:layout_width="@dimen/_33sdp"
                        android:layout_height="@dimen/_33sdp"
                        android:contentDescription="@string/rate_us"
                        android:padding="@dimen/_8sdp"
                        android:src="@drawable/ic_app_star"
                        app:tint="@color/color_e4a11b"
                        android:background="@drawable/bg_fff6da_r11sdp"
                        android:clipToOutline="true" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/btnStar4"
                        android:layout_width="@dimen/_33sdp"
                        android:layout_height="@dimen/_33sdp"
                        android:contentDescription="@string/rate_us"
                        android:padding="@dimen/_8sdp"
                        android:src="@drawable/ic_app_star"
                        app:tint="@color/color_e4a11b"
                        android:background="@drawable/bg_fff6da_r11sdp"
                        android:clipToOutline="true" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/btnStar5"
                        android:layout_width="@dimen/_33sdp"
                        android:layout_height="@dimen/_33sdp"
                        android:contentDescription="@string/rate_us"
                        android:padding="@dimen/_8sdp"
                        android:src="@drawable/ic_app_star"
                        app:tint="@color/color_e4a11b"
                        android:background="@drawable/bg_fff6da_r11sdp"
                        android:clipToOutline="true" />

                </LinearLayout>
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="@dimen/_8sdp" />

            <LinearLayout
                style="@style/CardAppStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_13sdp"
                android:orientation="vertical"
                android:background="@drawable/bg_surface_card_r15sdp"
                android:foreground="@drawable/stroke_r15sdp_st1sdp_stroke"
                android:clipToOutline="true">

                <LinearLayout
                    android:id="@+id/rowShare"
                    style="@style/SettingRowStyle">

                    <ImageView
                        style="@style/SettingRowIconStyle"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_app_share"
                        app:tint="@color/color_3984ff"
                        android:background="@drawable/bg_eaf2ff_r9sdp"
                        android:clipToOutline="true" />

                    <TextView
                        style="@style/RowLabelStyle"
                        android:text="@string/share_the_app" />

                    <ImageView
                        style="@style/RowChevronStyle"
                        android:contentDescription="@null" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowFeedback"
                    style="@style/SettingRowStyle">

                    <ImageView
                        style="@style/SettingRowIconStyle"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_app_chat"
                        app:tint="@color/color_14b8a6"
                        android:background="@drawable/bg_e0f8f3_r9sdp"
                        android:clipToOutline="true" />

                    <TextView
                        style="@style/RowLabelStyle"
                        android:text="@string/send_feedback" />

                    <ImageView
                        style="@style/RowChevronStyle"
                        android:contentDescription="@null" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvPremiumSection"
                style="@style/TextSectionCaps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/_15sdp"
                android:paddingTop="@dimen/_13sdp"
                android:paddingBottom="@dimen/_7sdp"
                android:text="@string/premium" />

            <LinearLayout
                android:id="@+id/cardPremiumRows"
                style="@style/CardAppStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_13sdp"
                android:orientation="vertical"
                android:background="@drawable/bg_surface_card_r15sdp"
                android:foreground="@drawable/stroke_r15sdp_st1sdp_stroke"
                android:clipToOutline="true">

                <LinearLayout
                    android:id="@+id/rowRestore"
                    style="@style/SettingRowStyle">

                    <ImageView
                        style="@style/SettingRowIconStyle"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_app_restore"
                        app:tint="@color/color_35ac71"
                        android:background="@drawable/bg_e7f7ed_r9sdp"
                        android:clipToOutline="true" />

                    <TextView
                        style="@style/RowLabelStyle"
                        android:text="@string/restore_purchases" />

                    <ImageView
                        style="@style/RowChevronStyle"
                        android:contentDescription="@null" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowSubscription"
                    style="@style/SettingRowStyle">

                    <ImageView
                        style="@style/SettingRowIconStyle"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_app_crown"
                        app:tint="@color/text_on_selected"
                        android:background="@drawable/bg_bg_selected_r9sdp"
                        android:clipToOutline="true" />

                    <TextView
                        style="@style/RowLabelStyle"
                        android:text="@string/manage_subscription" />

                    <ImageView
                        style="@style/RowChevronStyle"
                        android:contentDescription="@null" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/TextSectionCaps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/_15sdp"
                android:paddingTop="@dimen/_13sdp"
                android:paddingBottom="@dimen/_7sdp"
                android:text="@string/about" />

            <LinearLayout
                style="@style/CardAppStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_13sdp"
                android:orientation="vertical"
                android:background="@drawable/bg_surface_card_r15sdp"
                android:foreground="@drawable/stroke_r15sdp_st1sdp_stroke"
                android:clipToOutline="true">

                <LinearLayout
                    android:id="@+id/rowPrivacy"
                    style="@style/SettingRowStyle">

                    <ImageView
                        style="@style/SettingRowIconStyle"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_app_shield"
                        app:tint="@color/text_secondary"
                        android:background="@drawable/bg_surface_variant_r9sdp"
                        android:clipToOutline="true" />

                    <TextView
                        style="@style/RowLabelStyle"
                        android:text="@string/privacy_policy" />

                    <ImageView
                        style="@style/RowChevronStyle"
                        android:contentDescription="@null" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowTerms"
                    style="@style/SettingRowStyle">

                    <ImageView
                        style="@style/SettingRowIconStyle"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_app_file"
                        app:tint="@color/text_secondary"
                        android:background="@drawable/bg_surface_variant_r9sdp"
                        android:clipToOutline="true" />

                    <TextView
                        style="@style/RowLabelStyle"
                        android:text="@string/term_of_service" />

                    <ImageView
                        style="@style/RowChevronStyle"
                        android:contentDescription="@null" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_13sdp"
                android:fontFamily="@font/nt_400"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_9sdp"
                tools:text="PDF Reader &amp; Editor · Version 1.0.0" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
