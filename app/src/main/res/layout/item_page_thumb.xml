<?xml version="1.0" encoding="utf-8"?>
<!-- A page as a thumbnail with its number under it; ringed in blue while picked. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/_5sdp">

    <FrameLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_101sdp"
        android:background="@drawable/bg_page_thumb"
        android:duplicateParentState="true"
        android:padding="@dimen/_3sdp">

        <ImageView
            android:id="@+id/ivPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_page_sheet"
            android:clipToOutline="true"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvNumber"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_18sdp"
        android:layout_marginTop="@dimen/_4sdp"
        android:background="@drawable/bg_page_number_pill"
        android:duplicateParentState="true"
        android:fontFamily="@font/nunito_700"
        android:gravity="center"
        android:minWidth="@dimen/_18sdp"
        android:paddingHorizontal="@dimen/_6sdp"
        android:textColor="@color/text_page_number"
        android:textSize="@dimen/_10sdp"
        tools:text="12" />
</LinearLayout>
