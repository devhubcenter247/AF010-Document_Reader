<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/_3sdp">

    <FrameLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_80sdp"
        android:background="@drawable/bg_surface_card_r8sdp"
        android:foreground="@drawable/stroke_r8sdp_st1sdp_stroke"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/ivPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/_2sdp"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tvNumber"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_15sdp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="@dimen/_3sdp"
            android:fontFamily="@font/nt_400"
            android:gravity="center"
            android:minWidth="@dimen/_15sdp"
            android:paddingHorizontal="@dimen/_4sdp"
            android:textSize="@dimen/_9sdp"
            tools:text="1"
            android:background="@drawable/bg_ink_r8sdp"
            android:textColor="@color/on_primary" />
    </FrameLayout>

</FrameLayout>
