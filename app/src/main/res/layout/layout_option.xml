<?xml version="1.0" encoding="utf-8"?>
<!-- One choice of a tool: radio, title, a line under it, and an optional badge at the end.
     Picked = selected state (bg_option_card, bg_radio). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_option_card"
    android:elevation="@dimen/_3sdp"
    android:gravity="center_vertical"
    android:minHeight="@dimen/_52sdp"
    android:orientation="horizontal"
    android:outlineAmbientShadowColor="@color/color_shadow"
    android:outlineSpotShadowColor="@color/color_shadow"
    android:paddingHorizontal="@dimen/_12sdp"
    android:paddingVertical="@dimen/_9sdp">

    <View
        android:layout_width="@dimen/_17sdp"
        android:layout_height="@dimen/_17sdp"
        android:background="@drawable/bg_radio"
        android:duplicateParentState="true" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_11sdp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_700"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/_12sdp"
            tools:text="Custom ranges" />

        <TextView
            android:id="@+id/tvDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_1sdp"
            android:fontFamily="@font/nunito_500"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_10sdp"
            tools:text="Choose the pages for each file" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvBadge"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_23sdp"
        android:background="@drawable/bg_badge"
        android:backgroundTint="@color/color_file_excel_bg"
        android:fontFamily="@font/nunito_700"
        android:gravity="center"
        android:paddingHorizontal="@dimen/_8sdp"
        android:textColor="@color/color_file_excel"
        android:textSize="@dimen/_10sdp"
        android:visibility="gone"
        tools:text="−55%"
        tools:visibility="visible" />
</LinearLayout>
