<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app"
    android:orientation="vertical"
    tools:context=".ui.main.tools.result.SuccessActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_31sdp"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/_9sdp">

        <com.ui.baselib.widget.view.UiImageView
            android:id="@+id/btnClose"
            style="@style/IconButtonStyle"
            android:contentDescription="@string/scanner_close"
            android:src="@drawable/ic_app_close" />
    </LinearLayout>

    <com.ui.baselib.widget.view.UiImageView
        android:layout_width="@dimen/_74sdp"
        android:layout_height="@dimen/_74sdp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/_6sdp"
        android:contentDescription="@null"
        android:padding="@dimen/_13sdp"
        android:src="@drawable/ic_check_success"
        app:uiBackgroundColor="@color/color_success_bg"
        app:uiCornerRadius="@dimen/_37sdp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_11sdp"
        android:fontFamily="@font/nt_600"
        android:gravity="center"
        android:text="@string/saved_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/_15sdp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_3sdp"
        android:fontFamily="@font/nt_400"
        android:gravity="center"
        android:text="@string/saved_subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/_10sdp" />

    <com.ui.baselib.widget.layout.UiLinearLayout
        style="@style/CardAppStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_15sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_11sdp"
        android:paddingVertical="@dimen/_9sdp"
        app:uiCornerRadius="@dimen/_10sdp">

        <ImageView
            android:id="@+id/ivType"
            android:layout_width="@dimen/_25sdp"
            android:layout_height="@dimen/_25sdp"
            android:contentDescription="@null"
            tools:src="@drawable/ic_file_pdf" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_9sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:fontFamily="@font/nt_500"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_11sdp"
                tools:text="Annual-report-compressed.pdf" />

            <TextView
                android:id="@+id/tvMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                android:fontFamily="@font/nt_400"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_9sdp"
                tools:text="2.4 MB · 65% smaller" />
        </LinearLayout>

        <com.ui.baselib.widget.view.UiTextView
            android:id="@+id/tvSaving"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_20sdp"
            android:fontFamily="@font/nt_600"
            android:gravity="center"
            android:paddingHorizontal="@dimen/_8sdp"
            android:textSize="@dimen/_9sdp"
            android:visibility="gone"
            app:uiBackgroundColor="@color/color_success_bg"
            app:uiCornerRadius="@dimen/_10sdp"
            app:uiTextColor="@color/color_success"
            tools:text="−65%"
            tools:visibility="visible" />
    </com.ui.baselib.widget.layout.UiLinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <com.ui.baselib.widget.view.UiTextView
            android:id="@+id/btnOpen"
            android:layout_marginStart="@dimen/_12sdp"
            style="@style/ButtonAppStyle"
            android:layout_width="0dp"
            android:layout_marginEnd="@dimen/_4sdp"
            android:layout_weight="1"
            android:drawablePadding="@dimen/_6sdp"
            android:text="@string/open"
            android:layout_marginVertical="@dimen/_8sdp"
            app:drawableStartCompat="@drawable/ic_app_eye"
            app:drawableTint="@color/on_primary"
            app:uiDrawableAlign="text"
            app:uiDrawableSize="@dimen/_15sdp"
            app:uiShadowClipParent="force"
            app:uiShadowColor="@color/primary_30" />

        <com.ui.baselib.widget.view.UiTextView
            android:id="@+id/btnShare"
            style="@style/ButtonOutlineStyle"
            android:layout_width="0dp"
            android:layout_marginStart="@dimen/_4sdp"
            android:layout_marginEnd="@dimen/_12sdp"
            android:layout_weight="1"
            android:drawablePadding="@dimen/_6sdp"
            android:text="@string/file_action_share"
            app:drawableStartCompat="@drawable/ic_app_share"
            app:drawableTint="@color/text_primary"
            app:uiDrawableAlign="text"
            app:uiDrawableSize="@dimen/_15sdp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutNextTools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/TextSectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/_15sdp"
            android:paddingTop="@dimen/_13sdp"
            android:paddingBottom="@dimen/_7sdp"
            android:text="@string/keep_working" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcvNextTools"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_9sdp"
            android:overScrollMode="never"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="4"
            tools:itemCount="4"
            tools:listitem="@layout/item_next_tool" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
