<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app"
    android:orientation="vertical"
    tools:context=".ui.main.tools.result.SuccessActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_31sdp"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/_9sdp">

        <ImageView
            android:id="@+id/btnClose"
            style="@style/IconButtonStyle"
            android:contentDescription="@string/scanner_close"
            android:src="@drawable/ic_app_close"
            android:background="@drawable/bg_surface_variant_r17sdp"
            android:clipToOutline="true" />
    </LinearLayout>

    <ImageView
        android:layout_width="@dimen/_74sdp"
        android:layout_height="@dimen/_74sdp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/_6sdp"
        android:contentDescription="@null"
        android:padding="@dimen/_13sdp"
        android:src="@drawable/ic_check_success"
        android:background="@drawable/bg_success_bg_r37sdp"
        android:clipToOutline="true" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_11sdp"
        android:fontFamily="@font/nunito_800"
        android:gravity="center"
        android:text="@string/saved_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/_15sdp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_3sdp"
        android:fontFamily="@font/nunito_600"
        android:gravity="center"
        android:text="@string/saved_subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/_10sdp" />

    <LinearLayout
        style="@style/CardAppStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_15sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_11sdp"
        android:paddingVertical="@dimen/_9sdp"
        android:background="@drawable/bg_surface_card_r10sdp"
        android:foreground="@drawable/stroke_r10sdp_st1sdp_stroke"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/ivType"
            android:layout_width="@dimen/_25sdp"
            android:layout_height="@dimen/_25sdp"
            android:contentDescription="@null"
            tools:src="@drawable/ic_file_pdf" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_9sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:fontFamily="@font/nunito_700"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_11sdp"
                tools:text="Annual-report-compressed.pdf" />

            <TextView
                android:id="@+id/tvMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                android:fontFamily="@font/nunito_600"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_9sdp"
                tools:text="2.4 MB · 65% smaller" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSaving"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_20sdp"
            android:fontFamily="@font/nunito_800"
            android:gravity="center"
            android:paddingHorizontal="@dimen/_8sdp"
            android:textSize="@dimen/_9sdp"
            android:visibility="gone"
            tools:text="−65%"
            tools:visibility="visible"
            android:background="@drawable/bg_success_bg_r10sdp"
            android:textColor="@color/color_success" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpen"
            android:layout_marginStart="@dimen/_12sdp"
            style="@style/ButtonAppStyle"
            android:layout_width="0dp"
            android:layout_marginEnd="@dimen/_4sdp"
            android:layout_weight="1"
            android:text="@string/open"
            android:layout_marginVertical="@dimen/_8sdp"
            android:background="@drawable/bg_button_primary"
            android:elevation="@dimen/_5sdp"
            android:outlineSpotShadowColor="@color/primary_30"
            android:outlineAmbientShadowColor="@color/primary_20"
            android:textColor="@color/white"
            app:icon="@drawable/ic_app_eye"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/_6sdp"
            app:iconSize="@dimen/_15sdp"
            app:iconTint="@color/on_primary"
            app:backgroundTint="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:textAllCaps="false"
            android:letterSpacing="0"
            android:stateListAnimator="@null"
            android:paddingHorizontal="0dp"
            android:paddingVertical="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShare"
            style="@style/ButtonOutlineStyle"
            android:layout_width="0dp"
            android:layout_marginStart="@dimen/_4sdp"
            android:layout_marginEnd="@dimen/_12sdp"
            android:layout_weight="1"
            android:text="@string/file_action_share"
            android:background="@drawable/bg_surface_card_r10sdp_st1sdp_stroke"
            android:textColor="@color/text_primary"
            app:icon="@drawable/ic_app_share"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/_6sdp"
            app:iconSize="@dimen/_15sdp"
            app:iconTint="@color/text_primary"
            app:backgroundTint="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:textAllCaps="false"
            android:letterSpacing="0"
            android:stateListAnimator="@null"
            android:paddingHorizontal="0dp"
            android:paddingVertical="0dp"
            android:elevation="0dp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutNextTools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/TextSectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/_15sdp"
            android:paddingTop="@dimen/_13sdp"
            android:paddingBottom="@dimen/_7sdp"
            android:text="@string/keep_working" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcvNextTools"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_9sdp"
            android:overScrollMode="never"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="4"
            tools:itemCount="4"
            tools:listitem="@layout/item_next_tool" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
