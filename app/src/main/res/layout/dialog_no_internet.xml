<?xml version="1.0" encoding="utf-8"?>
<!-- Offline: the mascot on its blob with a Wi-Fi badge; local files still work. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:clipToPadding="false"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/_17sdp"
    android:paddingTop="@dimen/_18sdp"
    android:paddingBottom="@dimen/_15sdp"
    tools:context=".ui.dialog.DialogNoInternet">

    <FrameLayout
        android:layout_width="@dimen/_92sdp"
        android:layout_height="@dimen/_92sdp"
        android:importantForAccessibility="noHideDescendants">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_blob"
            app:tint="@color/color_bg_selected" />

        <ImageView
            android:layout_width="@dimen/_46sdp"
            android:layout_height="@dimen/_57sdp"
            android:layout_gravity="center"
            android:src="@drawable/ic_mascot_smile" />

        <ImageView
            style="@style/FloatingCard"
            android:layout_width="@dimen/_31sdp"
            android:layout_height="@dimen/_31sdp"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_circle_variant"
            android:backgroundTint="@color/color_surface_card"
            android:padding="@dimen/_8sdp"
            android:src="@drawable/ic_fo_wifi"
            app:tint="@color/primary" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8sdp"
        android:fontFamily="@font/nunito_600"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/_15sdp"
        android:text="@string/fo_offline_title" />

    <TextView
        android:id="@+id/tvOfflineMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_5sdp"
        android:fontFamily="@font/nunito_400"
        android:gravity="center"
        android:lineSpacingMultiplier="1.15"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/_10sdp"
        android:text="@string/fo_offline_message" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTryAgain"
        style="@style/PrimaryPillButton"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/_14sdp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:letterSpacing="0"
        android:minHeight="0dp"
        android:stateListAnimator="@null"
        android:text="@string/fo_try_again"
        android:textAllCaps="false"
        app:backgroundTint="@null"
        app:icon="@drawable/ic_fo_rotate"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/_6sdp"
        app:iconSize="@dimen/_15sdp"
        app:iconTint="@color/on_primary" />

    <TextView
        android:id="@+id/btnWifi"
        style="@style/DialogGhostButton"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/_2sdp"
        android:text="@string/fo_open_wifi" />
</LinearLayout>
