<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app"
    tools:context=".ui.main.MainActivity">

    <!-- Tabs scroll under the bar; each leaves room for it at the bottom. -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/navHostFragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:defaultNavHost="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navGraph="@navigation/main_nav_graph" />

    <View
        android:layout_width="0dp"
        android:layout_height="@dimen/_100sdp"
        android:background="@drawable/bg_bottom_fade"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/navBar"
        android:layout_width="0dp"
        android:layout_height="@dimen/_48sdp"
        android:layout_marginStart="@dimen/_12sdp"
        android:layout_marginEnd="@dimen/_8sdp"
        android:layout_marginBottom="@dimen/_17sdp"
        android:background="@drawable/bg_nav_bar"
        android:elevation="@dimen/_12sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:outlineAmbientShadowColor="@color/color_nav_shadow"
        android:outlineSpotShadowColor="@color/color_nav_shadow"
        android:paddingHorizontal="@dimen/_5sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnCreate"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/tabFiles"
            style="@style/NavTab">

            <ImageView
                style="@style/NavTabIcon"
                android:src="@drawable/ic_fo_folder" />

            <TextView
                style="@style/NavTabLabel"
                android:text="@string/files" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabTools"
            style="@style/NavTab">

            <ImageView
                style="@style/NavTabIcon"
                android:src="@drawable/ic_fo_tools" />

            <TextView
                style="@style/NavTabLabel"
                android:text="@string/tools" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabSettings"
            style="@style/NavTab">

            <ImageView
                style="@style/NavTabIcon"
                android:src="@drawable/ic_fo_settings" />

            <TextView
                style="@style/NavTabLabel"
                android:text="@string/settings" />
        </LinearLayout>
    </LinearLayout>

    <!-- The ring that pulses out of the "+" (MainActivity.createPulse); just under the button. -->
    <View
        android:id="@+id/viewCreatePulse"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0"
        android:background="@drawable/bg_circle_primary"
        android:elevation="@dimen/_7sdp"
        android:importantForAccessibility="no"
        android:outlineProvider="none"
        app:layout_constraintBottom_toBottomOf="@id/btnCreate"
        app:layout_constraintEnd_toEndOf="@id/btnCreate"
        app:layout_constraintStart_toStartOf="@id/btnCreate"
        app:layout_constraintTop_toTopOf="@id/btnCreate" />

    <ImageView
        android:id="@+id/btnCreate"
        android:layout_width="@dimen/_48sdp"
        android:layout_height="@dimen/_48sdp"
        android:layout_marginEnd="@dimen/_12sdp"
        android:background="@drawable/bg_create_button"
        android:contentDescription="@string/create_new"
        android:elevation="@dimen/_8sdp"
        android:outlineAmbientShadowColor="@color/primary"
        android:outlineSpotShadowColor="@color/primary"
        android:padding="@dimen/_13sdp"
        android:src="@drawable/ic_fo_plus"
        app:layout_constraintBottom_toBottomOf="@id/navBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/navBar"
        app:tint="@color/on_primary" />

</androidx.constraintlayout.widget.ConstraintLayout>
