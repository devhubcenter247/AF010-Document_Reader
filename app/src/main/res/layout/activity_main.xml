<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app"
    tools:context=".ui.main.MainActivity">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/navHostFragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:defaultNavHost="true"
        app:layout_constraintBottom_toTopOf="@id/navBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navGraph="@navigation/main_nav_graph" />

    <com.ui.baselib.widget.navigation.UiNavigationBar
        android:id="@+id/navBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_58sdp"
        android:paddingHorizontal="@dimen/_5sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:uiBackgroundColor="@color/color_surface_card"
        app:uiNavGraph="@navigation/main_nav_graph"
        app:uiNavIconSize="@dimen/_20sdp"
        app:uiNavIconTintSelected="@color/primary"
        app:uiNavIconTintUnselected="@color/text_secondary"
        app:uiNavIndicatorColor="@color/color_bg_app"
        app:uiNavIndicatorStyle="pill"
        app:uiNavItemAnimation="fade"
        app:uiShadowColor="@color/primary_40"
        app:uiShadowClipParent="force"
        app:uiShadowRadius="@dimen/_3sdp"
        app:uiNavRippleEnabled="true"
        app:uiNavTextColorSelected="@color/primary"
        app:uiNavTextColorUnselected="@color/text_secondary"
        app:uiNavTextSingleLine="true"
        app:uiNavTextSize="@dimen/_9sdp"
        app:uiStrokeColor="@color/color_stroke">

        <com.ui.baselib.widget.navigation.NavItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:uiNavDestination="@id/filesFragment"
            app:uiNavIcon="@drawable/ic_app_folder"
            app:uiNavTitle="@string/files" />

        <com.ui.baselib.widget.navigation.NavItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:uiNavDestination="@id/toolsFragment"
            app:uiNavIcon="@drawable/ic_app_grid"
            app:uiNavTitle="@string/tools" />

        <com.ui.baselib.widget.navigation.NavItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:uiNavDestination="@id/settingsFragment"
            app:uiNavIcon="@drawable/ic_app_gear"
            app:uiNavTitle="@string/settings" />
    </com.ui.baselib.widget.navigation.UiNavigationBar>

</androidx.constraintlayout.widget.ConstraintLayout>
