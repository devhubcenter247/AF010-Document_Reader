<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/SettingRowStyle">

    <ImageView
        style="@style/SettingRowIconStyle"
        android:contentDescription="@null"
        android:src="@drawable/ic_app_folder"
        app:tint="@color/text_on_selected"
        android:background="@drawable/bg_bg_selected_r9sdp"
        android:clipToOutline="true" />

    <TextView
        android:id="@+id/tvName"
        style="@style/RowLabelStyle"
        android:ellipsize="end"
        android:maxLines="1"
        tools:text="Download" />

    <TextView
        android:id="@+id/tvCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_8sdp"
        android:fontFamily="@font/nt_400"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/_10sdp"
        tools:text="84" />

    <ImageView
        style="@style/RowChevronStyle"
        android:contentDescription="@null" />

</LinearLayout>
