<?xml version="1.0" encoding="utf-8"?>
<!-- The bottom of a tool screen: an optional note and the big action. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/color_bg_app"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/_15sdp"
    android:paddingTop="@dimen/_9sdp"
    android:paddingBottom="@dimen/_17sdp">

    <TextView
        android:id="@+id/tvNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_8sdp"
        android:fontFamily="@font/nunito_600"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/_10sdp"
        android:visibility="gone"
        tools:text="The Vietnamese pack downloads once, then works offline."
        tools:visibility="visible" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAction"
        style="@style/PrimaryPillButton"
        android:layout_width="match_parent"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:letterSpacing="0"
        android:maxLines="1"
        android:ellipsize="end"
        android:minHeight="0dp"
        android:stateListAnimator="@null"
        android:textAllCaps="false"
        app:backgroundTint="@null"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/_6sdp"
        app:iconSize="@dimen/_15sdp"
        app:iconTint="@color/on_primary"
        tools:icon="@drawable/ic_fo_compress"
        tools:text="Make it smaller" />
</LinearLayout>
