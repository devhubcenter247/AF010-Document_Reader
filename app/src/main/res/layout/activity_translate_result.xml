<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app"
    android:orientation="vertical"
    tools:context=".ui.main.tools.translate.TranslateResultActivity">

    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar" />

    <include
        android:id="@+id/segmentMode"
        layout="@layout/layout_segment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_13sdp"
        android:layout_marginTop="@dimen/_9sdp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcvPages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="@dimen/_13sdp"
        android:paddingTop="@dimen/_6sdp"
        android:paddingBottom="@dimen/_11sdp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_translated_page" />

    <!-- Pages left untranslated in the free version -->
    <LinearLayout
        android:id="@+id/cardUnlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_13sdp"
        android:layout_marginBottom="@dimen/_13sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/_13sdp"
        android:visibility="gone"
        tools:visibility="visible"
        android:background="@drawable/bg_grad_gradient_start_gradient_end_315_r15sdp"
        android:clipToOutline="true">

        <ImageView
            android:layout_width="@dimen/_33sdp"
            android:layout_height="@dimen/_33sdp"
            android:contentDescription="@null"
            android:padding="@dimen/_8sdp"
            android:src="@drawable/ic_app_lock"
            app:tint="@color/on_primary"
            android:background="@drawable/bg_white_16_r11sdp"
            android:clipToOutline="true" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_9sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvUnlockTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nt_600"
                android:textColor="@color/on_primary"
                android:textSize="@dimen/_11sdp"
                tools:text="Translate the other 15 pages" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nt_400"
                android:text="@string/translate_unlock_desc"
                android:textColor="@color/color_on_gradient_secondary"
                android:textSize="@dimen/_9sdp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnUnlock"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_23sdp"
            android:fontFamily="@font/nt_500"
            android:gravity="center"
            android:paddingHorizontal="@dimen/_11sdp"
            android:text="@string/unlock"
            android:textSize="@dimen/_10sdp"
            android:background="@drawable/bg_on_primary_r12sdp"
            android:textColor="@color/primary_dark" />
    </LinearLayout>

</LinearLayout>
