<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app"
    android:orientation="vertical"
    tools:context=".ui.main.tools.redact.RedactActivity">

    <include
        android:id="@+id/topBar"
        layout="@layout/layout_screen_bar" />

    <!-- The page to mark, on a grey board -->
    <FrameLayout
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_3sdp"
        android:layout_weight="1"
        android:background="@drawable/bg_rounded_panel"
        android:backgroundTint="@color/color_surface_variant"
        android:padding="@dimen/_12sdp">

        <com.af010.creator.docreader.ui.main.tools.redact.RedactPageView
            android:id="@+id/pageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/btnPrevious"
            style="@style/PageArrow"
            android:layout_gravity="center_vertical|start"
            android:contentDescription="@string/fo_previous_page"
            android:src="@drawable/ic_fo_back" />

        <ImageView
            android:id="@+id/btnNext"
            style="@style/PageArrow"
            android:layout_gravity="center_vertical|end"
            android:contentDescription="@string/fo_next_page"
            android:rotation="180"
            android:src="@drawable/ic_fo_back" />

        <TextView
            android:id="@+id/tvHint"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_28sdp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="@dimen/_8sdp"
            android:background="@drawable/bg_ink_pill"
            android:drawablePadding="@dimen/_5sdp"
            android:elevation="@dimen/_4sdp"
            android:fontFamily="@font/nunito_700"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/_11sdp"
            android:text="@string/fo_drag_to_hide"
            android:textColor="@color/white"
            android:textSize="@dimen/_10sdp"
            app:drawableStartCompat="@drawable/ic_fo_hand_14sdp"
            app:drawableTint="@color/white" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_15sdp"
        android:paddingTop="@dimen/_10sdp">

        <ImageView
            android:layout_width="@dimen/_17sdp"
            android:layout_height="@dimen/_17sdp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_fo_shield"
            app:tint="@color/color_file_excel" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_weight="1"
            android:fontFamily="@font/nunito_500"
            android:lineSpacingMultiplier="1.15"
            android:text="@string/fo_redact_note"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/_10sdp" />
    </LinearLayout>

    <include
        android:id="@+id/action"
        layout="@layout/layout_tool_action" />
</LinearLayout>
