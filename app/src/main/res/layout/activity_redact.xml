<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app"
    android:orientation="vertical"
    tools:context=".ui.main.tools.redact.RedactActivity">

    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawablePadding="@dimen/_8sdp"
        android:fontFamily="@font/nt_400"
        android:paddingHorizontal="@dimen/_13sdp"
        android:paddingVertical="@dimen/_8sdp"
        android:text="@string/redact_warning"
        android:textSize="@dimen/_10sdp"
        app:drawableTint="@color/color_warning"
        android:background="@drawable/bg_warning_bg"
        android:textColor="@color/color_on_warning"
        app:drawableStartCompat="@drawable/ic_app_alert_13sdp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/color_surface_track">

        <com.af010.creator.docreader.ui.main.tools.redact.RedactPageView
            android:id="@+id/pageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/_13sdp" />

        <ImageView
            android:id="@+id/btnPrevious"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="@dimen/_8sdp"
            android:contentDescription="@string/scanner_back"
            android:padding="@dimen/_7sdp"
            android:src="@drawable/ic_app_chevl"
            android:background="@drawable/bg_surface_card_r14sdp"
            android:clipToOutline="true" />

        <ImageView
            android:id="@+id/btnNext"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="@dimen/_8sdp"
            android:contentDescription="@string/next"
            android:padding="@dimen/_7sdp"
            android:src="@drawable/ic_app_chev"
            android:background="@drawable/bg_surface_card_r14sdp"
            android:clipToOutline="true" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_13sdp"
        android:paddingTop="@dimen/_9sdp"
        android:paddingBottom="@dimen/_10sdp"
        android:background="@drawable/bg_surface_card_line_top_1sdp_stroke">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_27sdp"
            android:drawablePadding="@dimen/_4sdp"
            android:fontFamily="@font/nt_500"
            android:gravity="center"
            android:paddingHorizontal="@dimen/_11sdp"
            android:text="@string/redact_drag"
            android:textSize="@dimen/_10sdp"
            app:drawableTint="@color/text_on_selected"
            android:background="@drawable/bg_bg_selected_r13sdp_st1sdp_primary"
            android:textColor="@color/text_on_selected"
            app:drawableStartCompat="@drawable/ic_app_hand_12sdp" />

        <TextView
            android:id="@+id/btnFindText"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_27sdp"
            android:layout_marginStart="@dimen/_8sdp"
            android:drawablePadding="@dimen/_4sdp"
            android:fontFamily="@font/nt_500"
            android:gravity="center"
            android:paddingHorizontal="@dimen/_11sdp"
            android:text="@string/redact_find_text"
            android:textSize="@dimen/_10sdp"
            android:background="@drawable/bg_surface_card_r13sdp_st1sdp_stroke"
            android:textColor="@color/text_primary"
            app:drawableStartCompat="@drawable/ic_app_search_12sdp" />
    </LinearLayout>

</LinearLayout>
