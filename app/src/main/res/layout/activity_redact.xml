<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app"
    android:orientation="vertical"
    tools:context=".ui.main.tools.redact.RedactActivity">

    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar" />

    <com.ui.baselib.widget.view.UiTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawablePadding="@dimen/_8sdp"
        android:fontFamily="@font/nt_400"
        android:paddingHorizontal="@dimen/_13sdp"
        android:paddingVertical="@dimen/_8sdp"
        android:text="@string/redact_warning"
        android:textSize="@dimen/_10sdp"
        app:drawableStartCompat="@drawable/ic_app_alert"
        app:drawableTint="@color/color_warning"
        app:uiBackgroundColor="@color/color_warning_bg"
        app:uiDrawableSize="@dimen/_13sdp"
        app:uiTextColor="@color/color_on_warning" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/color_surface_track">

        <com.af010.creator.docreader.ui.main.tools.redact.RedactPageView
            android:id="@+id/pageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/_13sdp" />

        <com.ui.baselib.widget.view.UiImageView
            android:id="@+id/btnPrevious"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="@dimen/_8sdp"
            android:contentDescription="@string/scanner_back"
            android:padding="@dimen/_7sdp"
            android:src="@drawable/ic_app_chevl"
            app:uiBackgroundColor="@color/color_surface_card"
            app:uiCornerRadius="@dimen/_14sdp" />

        <com.ui.baselib.widget.view.UiImageView
            android:id="@+id/btnNext"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="@dimen/_8sdp"
            android:contentDescription="@string/next"
            android:padding="@dimen/_7sdp"
            android:src="@drawable/ic_app_chev"
            app:uiBackgroundColor="@color/color_surface_card"
            app:uiCornerRadius="@dimen/_14sdp" />
    </FrameLayout>

    <com.ui.baselib.widget.layout.UiLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_13sdp"
        android:paddingTop="@dimen/_9sdp"
        android:paddingBottom="@dimen/_10sdp"
        app:uiBackgroundColor="@color/color_surface_card"
        app:uiStrokeColor="@color/color_stroke"
        app:uiStrokeSides="top"
        app:uiStrokeWidth="@dimen/_1sdp">

        <com.ui.baselib.widget.view.UiTextView
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_27sdp"
            android:drawablePadding="@dimen/_4sdp"
            android:fontFamily="@font/nt_500"
            android:gravity="center"
            android:paddingHorizontal="@dimen/_11sdp"
            android:text="@string/redact_drag"
            android:textSize="@dimen/_10sdp"
            app:drawableStartCompat="@drawable/ic_app_hand"
            app:drawableTint="@color/text_on_selected"
            app:uiBackgroundColor="@color/color_bg_selected"
            app:uiCornerRadius="@dimen/_13sdp"
            app:uiDrawableSize="@dimen/_12sdp"
            app:uiStrokeColor="@color/primary"
            app:uiStrokeWidth="@dimen/_1sdp"
            app:uiTextColor="@color/text_on_selected" />

        <com.ui.baselib.widget.view.UiTextView
            android:id="@+id/btnFindText"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_27sdp"
            android:layout_marginStart="@dimen/_8sdp"
            android:drawablePadding="@dimen/_4sdp"
            android:fontFamily="@font/nt_500"
            android:gravity="center"
            android:paddingHorizontal="@dimen/_11sdp"
            android:text="@string/redact_find_text"
            android:textSize="@dimen/_10sdp"
            app:drawableStartCompat="@drawable/ic_app_search"
            app:uiBackgroundColor="@color/color_surface_card"
            app:uiCornerRadius="@dimen/_13sdp"
            app:uiDrawableSize="@dimen/_12sdp"
            app:uiStrokeColor="@color/color_stroke"
            app:uiStrokeWidth="@dimen/_1sdp"
            app:uiTextColor="@color/text_primary" />
    </com.ui.baselib.widget.layout.UiLinearLayout>

</LinearLayout>
