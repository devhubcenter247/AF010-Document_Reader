<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_scan_bg"
    android:orientation="vertical"
    tools:context=".ui.main.scan.fragment.ScanCropFragment">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/_46sdp"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_9sdp">

        <ImageView
            android:id="@+id/btnBack"
            style="@style/IconButtonStyle"
            android:contentDescription="@string/scanner_back"
            android:src="@drawable/ic_app_back"
            app:tint="@color/on_primary"
            android:background="@drawable/bg_white_12_r17sdp"
            android:clipToOutline="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_6sdp"
            android:layout_weight="1"
            android:fontFamily="@font/nt_500"
            android:text="@string/adjust_corners"
            android:textColor="@color/on_primary"
            android:textSize="@dimen/_12sdp" />

        <TextView
            android:id="@+id/btnNext"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_23sdp"
            android:fontFamily="@font/nt_600"
            android:gravity="center"
            android:paddingHorizontal="@dimen/_10sdp"
            android:text="@string/next"
            android:textSize="@dimen/_10sdp"
            android:background="@drawable/bg_accent_r12sdp"
            android:textColor="@color/on_accent" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.af010.creator.docreader.ui.main.scan.view.CornerAdjustView
            android:id="@+id/cornerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/_15sdp" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/accent"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_54sdp"
        android:orientation="horizontal"
        android:paddingBottom="@dimen/_7sdp">

        <TextView
            android:id="@+id/btnRotate"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:drawablePadding="@dimen/_3sdp"
            android:fontFamily="@font/nt_500"
            android:gravity="center"
            android:paddingTop="@dimen/_11sdp"
            android:text="@string/scanner_rotate"
            android:textSize="@dimen/_9sdp"
            app:drawableTint="@color/on_primary"
            android:textColor="@color/on_primary"
            app:drawableTopCompat="@drawable/ic_app_rotate_17sdp" />

        <TextView
            android:id="@+id/btnAutoDetect"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:drawablePadding="@dimen/_3sdp"
            android:fontFamily="@font/nt_500"
            android:gravity="center"
            android:paddingTop="@dimen/_11sdp"
            android:text="@string/scan_auto_detect"
            android:textSize="@dimen/_9sdp"
            app:drawableTint="@color/on_primary"
            android:textColor="@color/on_primary"
            app:drawableTopCompat="@drawable/ic_app_sparkle_17sdp" />

        <TextView
            android:id="@+id/btnFullPage"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:drawablePadding="@dimen/_3sdp"
            android:fontFamily="@font/nt_500"
            android:gravity="center"
            android:paddingTop="@dimen/_11sdp"
            android:text="@string/scan_full_page"
            android:textSize="@dimen/_9sdp"
            app:drawableTint="@color/on_primary"
            android:textColor="@color/on_primary"
            app:drawableTopCompat="@drawable/ic_app_crop_17sdp" />

    </LinearLayout>

</LinearLayout>
