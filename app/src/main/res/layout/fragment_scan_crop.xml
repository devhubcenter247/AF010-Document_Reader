<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app"
    android:orientation="vertical"
    tools:context=".ui.main.scan.fragment.ScanCropFragment">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/_46sdp"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_12sdp"
        android:paddingBottom="@dimen/_8sdp">

        <ImageView
            android:id="@+id/btnBack"
            style="@style/RoundIconButton"
            android:layout_width="@dimen/_32sdp"
            android:layout_height="@dimen/_32sdp"
            android:contentDescription="@string/scanner_back"
            android:src="@drawable/ic_fo_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_9sdp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/nunito_700"
            android:maxLines="1"
            android:text="@string/fo_adjust_corners"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/_14sdp" />

        <TextView
            android:id="@+id/tvPage"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_25sdp"
            android:background="@drawable/bg_badge"
            android:backgroundTint="@color/color_surface_card"
            android:fontFamily="@font/nunito_700"
            android:gravity="center"
            android:paddingHorizontal="@dimen/_9sdp"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/_10sdp"
            tools:text="Page 2 of 2" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/nunito_500"
        android:paddingHorizontal="@dimen/_18sdp"
        android:paddingBottom="@dimen/_6sdp"
        android:text="@string/fo_drag_the_dots"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/_11sdp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_5sdp"
        android:layout_weight="1"
        android:background="@drawable/bg_rounded_panel"
        android:backgroundTint="@color/scan_board"
        android:clipToOutline="true">

        <com.af010.creator.docreader.ui.main.scan.view.CornerAdjustView
            android:id="@+id/cornerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="@dimen/_34sdp"
            android:layout_height="@dimen/_34sdp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/white"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_12sdp"
        android:paddingVertical="@dimen/_11sdp">

        <TextView
            android:id="@+id/btnRotate"
            style="@style/PillAction"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_32sdp"
            android:paddingHorizontal="@dimen/_11sdp"
            app:drawableTint="@color/text_primary"
            android:text="@string/scanner_rotate"
            app:drawableStartCompat="@drawable/ic_fo_rotate_15sdp" />

        <TextView
            android:id="@+id/btnAutoDetect"
            style="@style/PillAction"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_32sdp"
            android:paddingHorizontal="@dimen/_11sdp"
            app:drawableTint="@color/text_primary"
            android:layout_marginStart="@dimen/_6sdp"
            android:text="@string/scan_auto_detect"
            app:drawableStartCompat="@drawable/ic_fo_sparkles_15sdp" />

        <TextView
            android:id="@+id/btnFullPage"
            style="@style/PillAction"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_32sdp"
            android:paddingHorizontal="@dimen/_11sdp"
            app:drawableTint="@color/text_primary"
            android:layout_marginStart="@dimen/_6sdp"
            android:text="@string/scan_full_page"
            app:drawableStartCompat="@drawable/ic_fo_scan_15sdp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_15sdp"
        android:paddingBottom="@dimen/_17sdp"
        android:clipToPadding="false">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetake"
            style="@style/SoftPillButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/_43sdp"
            android:layout_weight="1"
            android:backgroundTint="@color/color_surface_card"
            android:text="@string/fo_retake"
            app:strokeColor="@color/color_stroke"
            app:strokeWidth="@dimen/_1sdp" />

        <TextView
            android:id="@+id/btnNext"
            style="@style/PrimaryPillButton"
            android:layout_width="0dp"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_weight="1.4"
            android:text="@string/fo_looks_good" />
    </LinearLayout>
</LinearLayout>
