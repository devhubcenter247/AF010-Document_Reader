<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app"
    android:orientation="vertical"
    tools:context=".ui.main.newdocument.NewDocumentActivity">

    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="@dimen/_15sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/cardWord"
            style="@style/CardAppStyle"
            android:layout_width="0dp"
            android:layout_height="@dimen/_77sdp"
            android:layout_marginEnd="@dimen/_4sdp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_surface_card_r13sdp"
            android:foreground="@drawable/stroke_r13sdp_st1sdp_stroke"
            android:clipToOutline="true">

            <ImageView
                android:layout_width="@dimen/_25sdp"
                android:layout_height="@dimen/_31sdp"
                android:contentDescription="@null"
                android:src="@drawable/ic_file_word" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:ellipsize="end"
                android:fontFamily="@font/nt_500"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/tab_word"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_10sdp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardExcel"
            style="@style/CardAppStyle"
            android:layout_width="0dp"
            android:layout_height="@dimen/_77sdp"
            android:layout_marginStart="@dimen/_4sdp"
            android:layout_marginEnd="@dimen/_4sdp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_surface_card_r13sdp"
            android:foreground="@drawable/stroke_r13sdp_st1sdp_stroke"
            android:clipToOutline="true">

            <ImageView
                android:layout_width="@dimen/_25sdp"
                android:layout_height="@dimen/_31sdp"
                android:contentDescription="@null"
                android:src="@drawable/ic_file_excel" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:ellipsize="end"
                android:fontFamily="@font/nt_500"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/tab_excel"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_10sdp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardPpt"
            style="@style/CardAppStyle"
            android:layout_width="0dp"
            android:layout_height="@dimen/_77sdp"
            android:layout_marginStart="@dimen/_4sdp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_surface_card_r13sdp"
            android:foreground="@drawable/stroke_r13sdp_st1sdp_stroke"
            android:clipToOutline="true">

            <ImageView
                android:layout_width="@dimen/_25sdp"
                android:layout_height="@dimen/_31sdp"
                android:contentDescription="@null"
                android:src="@drawable/ic_file_powerpoint" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:ellipsize="end"
                android:fontFamily="@font/nt_500"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/powerpoint"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_10sdp" />
        </LinearLayout>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_17sdp"
            android:fontFamily="@font/nt_500"
            android:text="@string/new_document_file_name"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_10sdp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_37sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_11sdp"
            android:background="@drawable/bg_surface_card_r11sdp"
            android:foreground="@drawable/stroke_r11sdp_st1sdp_primary"
            android:clipToOutline="true">

            <EditText
                android:id="@+id/edtName"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="@font/nt_400"
                android:hint="@string/new_document_file_name"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="@dimen/_12sdp" />

            <TextView
                android:id="@+id/tvExtension"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_6sdp"
                android:fontFamily="@font/nt_400"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_12sdp"
                tools:text=".docx" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_17sdp"
            android:fontFamily="@font/nt_500"
            android:text="@string/save_to"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_10sdp" />

        <TextView
            android:id="@+id/tvSaveTo"
            style="@style/CardAppStyle"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_37sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:drawablePadding="@dimen/_8sdp"
            android:ellipsize="middle"
            android:fontFamily="@font/nt_400"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingHorizontal="@dimen/_11sdp"
            android:textSize="@dimen/_12sdp"
            app:drawableTint="@color/text_on_selected"
            tools:text="Download / Pdf Reader"
            android:background="@drawable/bg_surface_card_r11sdp_st1sdp_stroke"
            android:textColor="@color/text_primary"
            app:drawableStartCompat="@drawable/ic_app_folder_15sdp" />

        <LinearLayout
            style="@style/CardAppStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_17sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/_13sdp"
            android:background="@drawable/bg_surface_card_r15sdp"
            android:foreground="@drawable/stroke_r15sdp_st1sdp_stroke"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/ivPreview"
                android:layout_width="@dimen/_37sdp"
                android:layout_height="@dimen/_46sdp"
                android:contentDescription="@null"
                tools:src="@drawable/ic_file_word" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_13sdp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPreviewTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nt_600"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/_11sdp"
                    tools:text="Blank A4 page" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:fontFamily="@font/nt_400"
                    android:text="@string/blank_document_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/_9sdp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_surface_card_line_top_1sdp_stroke">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCreate"
            style="@style/ButtonAppStyle"
            android:layout_marginTop="@dimen/_9sdp"
            android:layout_width="match_parent"
            android:layout_marginHorizontal="@dimen/_15sdp"
            android:text="@string/create_and_start_editing"
            android:layout_marginBottom="@dimen/_10sdp"
            android:background="@drawable/bg_grad_gradient_start_gradient_end_270_r10sdp"
            android:elevation="@dimen/_5sdp"
            android:outlineSpotShadowColor="@color/primary_30"
            android:outlineAmbientShadowColor="@color/primary_20"
            android:textColor="@color/white"
            app:icon="@drawable/ic_app_pen"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/_6sdp"
            app:iconSize="@dimen/_15sdp"
            app:iconTint="@color/on_primary"
            app:backgroundTint="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:textAllCaps="false"
            android:letterSpacing="0"
            android:stateListAnimator="@null"
            android:paddingHorizontal="0dp"
            android:paddingVertical="0dp" />
    </FrameLayout>

</LinearLayout>
