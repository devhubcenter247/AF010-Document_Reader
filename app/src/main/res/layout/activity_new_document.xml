<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app"
    android:orientation="vertical"
    tools:context=".ui.main.newdocument.NewDocumentActivity">

    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="@dimen/_15sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

        <com.ui.baselib.widget.layout.UiLinearLayout
            android:id="@+id/cardWord"
            style="@style/CardAppStyle"
            android:layout_width="0dp"
            android:layout_height="@dimen/_77sdp"
            android:layout_marginEnd="@dimen/_4sdp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            app:uiCornerRadius="@dimen/_13sdp">

            <ImageView
                android:layout_width="@dimen/_25sdp"
                android:layout_height="@dimen/_31sdp"
                android:contentDescription="@null"
                android:src="@drawable/ic_file_word" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:ellipsize="end"
                android:fontFamily="@font/nt_500"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/tab_word"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_10sdp" />
        </com.ui.baselib.widget.layout.UiLinearLayout>

        <com.ui.baselib.widget.layout.UiLinearLayout
            android:id="@+id/cardExcel"
            style="@style/CardAppStyle"
            android:layout_width="0dp"
            android:layout_height="@dimen/_77sdp"
            android:layout_marginStart="@dimen/_4sdp"
            android:layout_marginEnd="@dimen/_4sdp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            app:uiCornerRadius="@dimen/_13sdp">

            <ImageView
                android:layout_width="@dimen/_25sdp"
                android:layout_height="@dimen/_31sdp"
                android:contentDescription="@null"
                android:src="@drawable/ic_file_excel" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:ellipsize="end"
                android:fontFamily="@font/nt_500"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/tab_excel"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_10sdp" />
        </com.ui.baselib.widget.layout.UiLinearLayout>

        <com.ui.baselib.widget.layout.UiLinearLayout
            android:id="@+id/cardPpt"
            style="@style/CardAppStyle"
            android:layout_width="0dp"
            android:layout_height="@dimen/_77sdp"
            android:layout_marginStart="@dimen/_4sdp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            app:uiCornerRadius="@dimen/_13sdp">

            <ImageView
                android:layout_width="@dimen/_25sdp"
                android:layout_height="@dimen/_31sdp"
                android:contentDescription="@null"
                android:src="@drawable/ic_file_powerpoint" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:ellipsize="end"
                android:fontFamily="@font/nt_500"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/powerpoint"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_10sdp" />
        </com.ui.baselib.widget.layout.UiLinearLayout>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_17sdp"
            android:fontFamily="@font/nt_500"
            android:text="@string/new_document_file_name"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_10sdp" />

        <com.ui.baselib.widget.layout.UiLinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_37sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_11sdp"
            app:uiBackgroundColor="@color/color_surface_card"
            app:uiCornerRadius="@dimen/_11sdp"
            app:uiStrokeColor="@color/primary"
            app:uiStrokeWidth="@dimen/_1sdp">

            <EditText
                android:id="@+id/edtName"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="@font/nt_400"
                android:hint="@string/new_document_file_name"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="@dimen/_12sdp" />

            <TextView
                android:id="@+id/tvExtension"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_6sdp"
                android:fontFamily="@font/nt_400"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_12sdp"
                tools:text=".docx" />
        </com.ui.baselib.widget.layout.UiLinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_17sdp"
            android:fontFamily="@font/nt_500"
            android:text="@string/save_to"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_10sdp" />

        <com.ui.baselib.widget.view.UiTextView
            android:id="@+id/tvSaveTo"
            style="@style/CardAppStyle"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_37sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:drawablePadding="@dimen/_8sdp"
            android:ellipsize="middle"
            android:fontFamily="@font/nt_400"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingHorizontal="@dimen/_11sdp"
            android:textSize="@dimen/_12sdp"
            app:drawableStartCompat="@drawable/ic_app_folder"
            app:drawableTint="@color/text_on_selected"
            app:uiCornerRadius="@dimen/_11sdp"
            app:uiDrawableSize="@dimen/_15sdp"
            app:uiTextColor="@color/text_primary"
            tools:text="Download / Pdf Reader" />

        <com.ui.baselib.widget.layout.UiLinearLayout
            style="@style/CardAppStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_17sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/_13sdp">

            <ImageView
                android:id="@+id/ivPreview"
                android:layout_width="@dimen/_37sdp"
                android:layout_height="@dimen/_46sdp"
                android:contentDescription="@null"
                tools:src="@drawable/ic_file_word" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_13sdp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPreviewTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nt_600"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/_11sdp"
                    tools:text="Blank A4 page" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:fontFamily="@font/nt_400"
                    android:text="@string/blank_document_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/_9sdp" />
            </LinearLayout>
        </com.ui.baselib.widget.layout.UiLinearLayout>
    </LinearLayout>

    <com.ui.baselib.widget.layout.UiFrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        app:uiBackgroundColor="@color/color_surface_card"
        app:uiStrokeColor="@color/color_stroke"
        app:uiStrokeSides="top"
        app:uiStrokeWidth="@dimen/_1sdp">

        <com.ui.baselib.widget.view.UiTextView
            android:id="@+id/btnCreate"
            style="@style/ButtonAppStyle"
            android:layout_marginTop="@dimen/_9sdp"
            android:layout_width="match_parent"
            android:drawablePadding="@dimen/_6sdp"
            android:layout_marginHorizontal="@dimen/_15sdp"
            android:text="@string/create_and_start_editing"
            app:drawableStartCompat="@drawable/ic_app_pen"
            app:drawableTint="@color/on_primary"
            app:uiDrawableAlign="text"
            android:layout_marginBottom="@dimen/_10sdp"
            app:uiDrawableSize="@dimen/_15sdp"
            app:uiShadowClipParent="force"
            app:uiShadowColor="@color/primary_30" />
    </com.ui.baselib.widget.layout.UiFrameLayout>

</LinearLayout>
