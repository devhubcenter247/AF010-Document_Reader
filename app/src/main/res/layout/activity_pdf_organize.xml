<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app"
    tools:context=".ui.main.reader.pdf.organize.PdfOrganizeActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/_46sdp"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_12sdp">

            <ImageView
                android:id="@+id/btnBack"
                style="@style/RoundIconButton"
                android:layout_width="@dimen/_32sdp"
                android:layout_height="@dimen/_32sdp"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_fo_back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_9sdp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/nunito_700"
                    android:maxLines="1"
                    android:text="@string/organize_pages"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/_14sdp" />

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/nunito_500"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/_10sdp"
                    tools:text="38 pages · 2 picked" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnSave"
                style="@style/ReaderSave"
                android:text="@string/file_action_save" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcvPages"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingHorizontal="@dimen/_11sdp"
                android:paddingTop="@dimen/_4sdp"
                android:paddingBottom="@dimen/_90sdp"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="3"
                tools:listitem="@layout/item_organize_page" />

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_28sdp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/primary" />
        </FrameLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/_100sdp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_fade" />

    <LinearLayout
        android:id="@+id/layoutActions"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_55sdp"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="@dimen/_12sdp"
        android:layout_marginBottom="@dimen/_17sdp"
        android:background="@drawable/bg_ink_bar"
        android:elevation="@dimen/_10sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:outlineAmbientShadowColor="@color/color_shadow"
        android:outlineSpotShadowColor="@color/color_shadow"
        android:paddingHorizontal="@dimen/_6sdp">

        <TextView
            android:id="@+id/btnRotate"
            style="@style/InkBarAction"
            android:text="@string/scanner_rotate"
            app:drawableTopCompat="@drawable/ic_fo_rotate_17sdp" />

        <TextView
            android:id="@+id/btnDuplicate"
            style="@style/InkBarAction"
            android:text="@string/duplicate"
            app:drawableTopCompat="@drawable/ic_fo_copy_17sdp" />

        <TextView
            android:id="@+id/btnAddPage"
            style="@style/InkBarAction"
            android:text="@string/add_page"
            app:drawableTopCompat="@drawable/ic_fo_plus_17sdp" />

        <TextView
            android:id="@+id/btnToImages"
            style="@style/InkBarAction"
            android:text="@string/fo_to_images"
            app:drawableTopCompat="@drawable/ic_fo_pdf_images_17sdp" />

        <TextView
            android:id="@+id/btnDelete"
            style="@style/InkBarAction"
            android:text="@string/file_action_delete"
            android:textColor="@color/ink_bar_danger"
            app:drawableTint="@color/ink_bar_danger"
            app:drawableTopCompat="@drawable/ic_fo_trash_17sdp" />
    </LinearLayout>
</FrameLayout>
