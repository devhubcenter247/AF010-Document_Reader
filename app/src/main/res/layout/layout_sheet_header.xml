<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <com.ui.baselib.widget.layout.UiView
        android:layout_width="@dimen/_31sdp"
        android:layout_height="@dimen/_4sdp"
        android:layout_marginTop="@dimen/_8sdp"
        app:uiBackgroundColor="@color/color_handle"
        app:uiCornerRadius="@dimen/_3sdp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/_15sdp"
        android:paddingEnd="@dimen/_13sdp"
        android:paddingBottom="@dimen/_3sdp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/nt_600"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/_12sdp"
            tools:text="Create new" />

        <com.ui.baselib.widget.view.UiImageView
            android:id="@+id/btnClose"
            style="@style/IconButtonStyle"
            android:layout_width="@dimen/_23sdp"
            android:layout_height="@dimen/_23sdp"
            android:contentDescription="@string/scanner_close"
            android:src="@drawable/ic_app_close" />
    </LinearLayout>

</LinearLayout>
