<?xml version="1.0" encoding="utf-8"?>
<!-- A file type on the Files tab (a page in its colour with its letter), its name and how many of it are on
     the phone. Picked (isSelected), it narrows the list below to that type (FilesFragment). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/HomeCard"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="@drawable/bg_type_card"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/_9sdp"
    android:paddingTop="@dimen/_9sdp"
    android:paddingBottom="@dimen/_10sdp">

    <TextView
        android:id="@+id/tvBadge"
        android:layout_width="@dimen/_27sdp"
        android:layout_height="@dimen/_32sdp"
        android:layout_marginStart="@dimen/_2sdp"
        android:background="@drawable/ic_file_page"
        android:fontFamily="@font/nunito_800"
        android:gravity="center"
        android:maxLines="1"
        android:paddingTop="@dimen/_4sdp"
        android:textColor="@color/on_primary"
        android:textSize="@dimen/_10sdp"
        tools:backgroundTint="@color/color_file_word"
        tools:text="W" />

    <TextView
        android:id="@+id/tvName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_7sdp"
        android:fontFamily="@font/nunito_700"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/_12sdp"
        tools:text="Word" />

    <TextView
        android:id="@+id/tvCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/nunito_500"
        android:maxLines="1"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/_10sdp"
        tools:text="12 files" />
</LinearLayout>
