<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app"
    tools:context=".ui.welcome.PermissionActivity">

    <!-- Top Banner Illustration -->
    <ImageView
        android:id="@+id/ivHeader"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_134sdp"
        android:layout_marginTop="@dimen/_13sdp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:scaleY="2"
        android:scaleX="2"
        android:src="@drawable/img_permission_access"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        style="@style/TextHeadLine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:fontFamily="@font/nt_600"
        android:text="@string/allow_file_access"
        android:textSize="@dimen/_13sdp"
        app:layout_constraintTop_toBottomOf="@+id/ivHeader" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tvSubtitle"
        style="@style/TextSubContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_3sdp"
        android:fontFamily="@font/nt_400"
        android:text="@string/allow_file_access_desc"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle" />

    <!-- Item 1: See all your documents -->
    <LinearLayout
        android:id="@+id/item1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_13sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@+id/tvSubtitle">

        <ImageView
            android:layout_width="@dimen/_27sdp"
            android:layout_height="@dimen/_27sdp"
            android:contentDescription="@null"
            android:padding="@dimen/_5sdp"
            android:src="@drawable/ic_app_folder"
            app:tint="@color/primary"
            android:background="@drawable/bg_xf0ebff_r8sdp"
            android:clipToOutline="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nt_500"
                android:text="@string/see_all_your_documents"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_10sdp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:fontFamily="@font/nt_400"
                android:text="@string/see_all_your_documents_desc"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_9sdp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Item 2: Files stay on your device -->
    <LinearLayout
        android:id="@+id/item2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@+id/item1">

        <ImageView
            android:layout_width="@dimen/_27sdp"
            android:layout_height="@dimen/_27sdp"
            android:contentDescription="@null"
            android:padding="@dimen/_5sdp"
            android:src="@drawable/ic_app_shield"
            app:tint="@color/primary"
            android:background="@drawable/bg_xf0ebff_r8sdp"
            android:clipToOutline="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nt_500"
                android:text="@string/files_stay_on_your_device"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_10sdp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:fontFamily="@font/nt_400"
                android:text="@string/files_stay_on_your_device_desc"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_9sdp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Item 3: Turn off anytime -->
    <LinearLayout
        android:id="@+id/item3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@+id/item2">

        <ImageView
            android:layout_width="@dimen/_27sdp"
            android:layout_height="@dimen/_27sdp"
            android:contentDescription="@null"
            android:padding="@dimen/_5sdp"
            android:src="@drawable/ic_app_gear"
            app:tint="@color/primary"
            android:background="@drawable/bg_xf0ebff_r8sdp"
            android:clipToOutline="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nt_500"
                android:text="@string/turn_off_anytime"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_10sdp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:fontFamily="@font/nt_400"
                android:text="@string/turn_off_anytime_desc"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_9sdp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Action Container -->
    <LinearLayout
        android:id="@+id/layoutBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginBottom="@dimen/_5sdp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Allow Access Button -->
        <TextView
            android:id="@+id/btnAllowAccess"
            android:layout_marginTop="@dimen/_10sdp"
            style="@style/ButtonAppStyle"
            android:layout_marginHorizontal="@dimen/_13sdp"
            android:layout_width="match_parent"
            android:text="@string/allow_access"
            android:background="@drawable/bg_grad_gradient_start_gradient_end_270_r10sdp"
            android:elevation="@dimen/_5sdp"
            android:outlineSpotShadowColor="@color/primary_30"
            android:outlineAmbientShadowColor="@color/primary_20"
            android:textColor="@color/white" />

        <!-- Not Now Button -->
        <TextView
            android:id="@+id/btnNotNow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_marginHorizontal="@dimen/_13sdp"
            android:fontFamily="@font/nt_500"
            android:padding="@dimen/_5sdp"
            android:text="@string/not_now"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_10sdp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
