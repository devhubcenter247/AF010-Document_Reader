<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app"
    android:orientation="vertical"
    tools:context=".ui.welcome.PermissionActivity">

    <include
        android:id="@+id/steps"
        layout="@layout/layout_step_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_18sdp"
        android:layout_marginTop="@dimen/_14sdp" />

    <!-- A folder with two documents peeking out, the mascot beside it (300 × 193 design frame) -->
    <FrameLayout
        android:layout_width="@dimen/_300sdp"
        android:layout_height="@dimen/_193sdp"
        android:layout_gravity="center_horizontal"
        android:clipChildren="false">

        <ImageView
            android:layout_width="@dimen/_193sdp"
            android:layout_height="@dimen/_193sdp"
            android:layout_marginStart="@dimen/_54sdp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_blob"
            app:tint="@color/color_blob_peach" />

        <View
            android:layout_width="@dimen/_69sdp"
            android:layout_height="@dimen/_31sdp"
            android:layout_marginStart="@dimen/_69sdp"
            android:layout_marginTop="@dimen/_62sdp"
            android:background="@drawable/bg_folder_tab" />

        <include
            android:id="@+id/cardPdf"
            layout="@layout/layout_doc_card"
            android:layout_width="@dimen/_66sdp"
            android:layout_height="@dimen/_85sdp"
            android:layout_marginStart="@dimen/_86sdp"
            android:layout_marginTop="@dimen/_12sdp" />

        <include
            android:id="@+id/cardDocx"
            layout="@layout/layout_doc_card"
            android:layout_width="@dimen/_66sdp"
            android:layout_height="@dimen/_85sdp"
            android:layout_marginStart="@dimen/_149sdp"
            android:layout_marginTop="@dimen/_18sdp" />

        <FrameLayout
            android:layout_width="@dimen/_162sdp"
            android:layout_height="@dimen/_97sdp"
            android:layout_marginStart="@dimen/_69sdp"
            android:layout_marginTop="@dimen/_80sdp"
            android:background="@drawable/bg_folder_front"
            android:elevation="@dimen/_9sdp"
            android:outlineProvider="none">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_23sdp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="@dimen/_14sdp"
                android:background="@drawable/bg_folder_label"
                android:fontFamily="@font/nunito_700"
                android:gravity="center"
                android:paddingHorizontal="@dimen/_11sdp"
                android:text="@string/fo_phone_storage"
                android:textColor="@color/color_warning"
                android:textSize="@dimen/_9sdp" />
        </FrameLayout>

        <ImageView
            android:layout_width="@dimen/_54sdp"
            android:layout_height="@dimen/_67sdp"
            android:layout_marginStart="@dimen/_213sdp"
            android:layout_marginTop="@dimen/_91sdp"
            android:elevation="@dimen/_10sdp"
            android:importantForAccessibility="no"
            android:outlineProvider="none"
            android:src="@drawable/ic_mascot_smile" />
    </FrameLayout>

    <TextView
        style="@style/DisplayTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_18sdp"
        android:text="@string/fo_access_title"
        android:textSize="@dimen/_18sdp" />

    <androidx.core.widget.NestedScrollView
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/_11sdp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/_15sdp"
        android:paddingBottom="@dimen/_6sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include
                android:id="@+id/pointList"
                layout="@layout/layout_point_card" />

            <include
                android:id="@+id/pointPrivate"
                layout="@layout/layout_point_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp" />

            <include
                android:id="@+id/pointInPlace"
                layout="@layout/layout_point_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <TextView
        android:id="@+id/btnAllowAccess"
        style="@style/PrimaryPillButton"
        android:layout_width="match_parent"
        android:layout_marginHorizontal="@dimen/_18sdp"
        android:layout_marginTop="@dimen/_9sdp"
        android:text="@string/allow_file_access" />

    <TextView
        android:id="@+id/btnNotNow"
        style="@style/GhostButton"
        android:layout_width="match_parent"
        android:layout_marginHorizontal="@dimen/_18sdp"
        android:layout_marginTop="@dimen/_6sdp"
        android:layout_marginBottom="@dimen/_14sdp"
        android:text="@string/fo_maybe_later" />
</LinearLayout>
