<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app"
    android:orientation="vertical"
    tools:context=".ui.main.premium.PaywallActivity">

    <FrameLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/_43sdp"
        android:paddingHorizontal="@dimen/_12sdp">

        <ImageView
            android:id="@+id/btnClose"
            style="@style/RoundIconButton"
            android:layout_width="@dimen/_32sdp"
            android:layout_height="@dimen/_32sdp"
            android:layout_gravity="start|center_vertical"
            android:backgroundTint="@color/color_surface_variant"
            android:contentDescription="@string/scanner_close"
            android:elevation="0dp"
            android:src="@drawable/ic_fo_close" />

        <TextView
            android:id="@+id/tvProTool"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_26sdp"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/bg_pro_pill"
            android:drawablePadding="@dimen/_5sdp"
            android:fontFamily="@font/nunito_700"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/_8sdp"
            android:paddingEnd="@dimen/_11sdp"
            android:text="@string/fo_pro_tool"
            android:textColor="@color/color_warning"
            android:textSize="@dimen/_11sdp"
            app:drawableStartCompat="@drawable/ic_fo_crown_13sdp"
            app:drawableTint="@color/color_premium_gold" />
    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/_8sdp">

            <!-- A page as a picture next to the same page with text you can pick -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_182sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:background="@drawable/bg_rounded_panel"
                android:backgroundTint="@color/color_pro_bg"
                android:clipChildren="false"
                android:importantForAccessibility="noHideDescendants">

                <ImageView
                    android:layout_width="@dimen/_14sdp"
                    android:layout_height="@dimen/_14sdp"
                    android:layout_marginStart="@dimen/_14sdp"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:src="@drawable/ic_sparkle"
                    app:tint="@color/color_pro" />

                <FrameLayout
                    android:layout_width="@dimen/_108sdp"
                    android:layout_height="@dimen/_131sdp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="@dimen/_23sdp"
                    android:background="@drawable/bg_rounded_panel"
                    android:backgroundTint="@color/ocr_picture_bg"
                    android:rotation="-6">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:padding="@dimen/_12sdp"
                        android:src="@drawable/ic_ocr_lines"
                        app:tint="@color/ocr_picture_line" />
                </FrameLayout>

                <FrameLayout
                    style="@style/FloatingCard"
                    android:layout_width="@dimen/_115sdp"
                    android:layout_height="@dimen/_135sdp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="@dimen/_20sdp"
                    android:background="@drawable/bg_rounded_panel"
                    android:backgroundTint="@color/color_surface_card"
                    android:rotation="4">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:padding="@dimen/_11sdp"
                        android:src="@drawable/ic_ocr_text" />
                </FrameLayout>

                <ImageView
                    android:id="@+id/ivFeature"
                    android:layout_width="@dimen/_38sdp"
                    android:layout_height="@dimen/_38sdp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_ocr_badge"
                    android:backgroundTint="@color/primary"
                    android:elevation="@dimen/_6sdp"
                    android:padding="@dimen/_10sdp"
                    android:src="@drawable/ic_fo_sparkles"
                    app:tint="@color/on_primary" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15sdp"
                android:fontFamily="@font/nunito_700"
                android:letterSpacing="-0.015"
                android:lineSpacingMultiplier="1.05"
                android:paddingHorizontal="@dimen/_18sdp"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_20sdp"
                tools:text="Turn scans into words you can search and copy" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:fontFamily="@font/nunito_500"
                android:lineSpacingMultiplier="1.15"
                android:paddingHorizontal="@dimen/_18sdp"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_11sdp"
                tools:text="OCR comes with Folio Pro, along with protect, redact, full translation and no ads." />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_14sdp"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/_15sdp">

                <include
                    android:id="@+id/planYearly"
                    layout="@layout/layout_plan_card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/planMonthly"
                    layout="@layout/layout_plan_card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:layout_weight="1" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvLegal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:fontFamily="@font/nunito_500"
                android:paddingHorizontal="@dimen/_18sdp"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_9sdp"
                tools:text="$29.99 a year after a 3-day free trial…" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_15sdp"
        android:paddingTop="@dimen/_9sdp"
        android:paddingBottom="@dimen/_15sdp">

        <TextView
            android:id="@+id/btnPurchase"
            style="@style/PrimaryPillButton"
            android:layout_width="match_parent"
            tools:text="Try 3 days free" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnRestore"
                style="@style/PaywallLink"
                android:text="@string/fo_restore" />

            <TextView
                android:id="@+id/btnLifetime"
                style="@style/PaywallLink"
                tools:text="Lifetime $49.99" />

            <TextView
                android:id="@+id/btnTerms"
                style="@style/PaywallLink"
                android:text="@string/fo_terms" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
