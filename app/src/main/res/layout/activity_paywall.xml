<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".ui.main.premium.PaywallActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/layoutHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/_10sdp"
            android:paddingHorizontal="@dimen/_17sdp"
            android:background="@drawable/bg_grad_gradient_start_gradient_end_315_r0_0_24sdp_24sdp"
            android:clipToOutline="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_22sdp"
                    android:drawablePadding="@dimen/_5sdp"
                    android:fontFamily="@font/nt_600"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:paddingHorizontal="@dimen/_9sdp"
                    android:text="@string/premium"
                    android:textAllCaps="true"
                    android:textSize="@dimen/_9sdp"
                    app:drawableTint="@color/on_primary"
                    android:background="@drawable/bg_white_16_r11sdp"
                    android:textColor="@color/on_primary"
                    app:drawableStartCompat="@drawable/ic_app_crown_11sdp" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/btnClose"
                    android:layout_width="@dimen/_27sdp"
                    android:layout_height="@dimen/_27sdp"
                    android:contentDescription="@string/scanner_close"
                    android:padding="@dimen/_5sdp"
                    android:src="@drawable/ic_app_close"
                    app:tint="@color/on_primary"
                    android:background="@drawable/bg_white_16_r13sdp"
                    android:clipToOutline="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_13sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivFeature"
                    android:layout_width="@dimen/_44sdp"
                    android:layout_height="@dimen/_44sdp"
                    android:contentDescription="@null"
                    android:padding="@dimen/_11sdp"
                    app:tint="@color/on_primary"
                    tools:src="@drawable/ic_app_ocr"
                    android:background="@drawable/bg_white_16_r14sdp"
                    android:clipToOutline="true" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_11sdp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nt_600"
                        android:lineSpacingMultiplier="0.95"
                        android:textColor="@color/on_primary"
                        android:textSize="@dimen/_15sdp"
                        tools:text="OCR is a Premium feature" />

                    <TextView
                        android:id="@+id/tvSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_3sdp"
                        android:fontFamily="@font/nt_400"
                        android:textColor="@color/color_on_brand_secondary"
                        android:textSize="@dimen/_10sdp"
                        tools:text="Turn scanned pages into text you can search and copy." />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutBenefits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/_22sdp"
            android:paddingHorizontal="@dimen/_15sdp"
            android:paddingTop="@dimen/_17sdp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_3sdp"
                android:fontFamily="@font/nt_600"
                android:text="@string/choose_plan"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_12sdp" />

            <include
                android:id="@+id/planYearly"
                layout="@layout/layout_plan" />

            <include
                android:id="@+id/planMonthly"
                layout="@layout/layout_plan" />

            <include
                android:id="@+id/planLifetime"
                layout="@layout/layout_plan" />

            <LinearLayout
                android:id="@+id/cardTrial"
                style="@style/CardAppStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_11sdp"
                android:orientation="vertical"
                android:padding="@dimen/_13sdp"
                android:background="@drawable/bg_surface_card_r15sdp"
                android:foreground="@drawable/stroke_r15sdp_st1sdp_stroke"
                android:clipToOutline="true">

                <TextView
                    style="@style/TextSectionCaps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_11sdp"
                    android:text="@string/trial_how_it_works" />

                <include
                    android:id="@+id/stepToday"
                    layout="@layout/layout_trial_step" />

                <include
                    android:id="@+id/stepEnd"
                    layout="@layout/layout_trial_step" />

                <include
                    android:id="@+id/stepRenew"
                    layout="@layout/layout_trial_step" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnPurchase"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_40sdp"
                android:layout_marginTop="@dimen/_13sdp"
                android:fontFamily="@font/nt_600"
                android:gravity="center"
                android:textSize="@dimen/_12sdp"
                tools:text="Start 3-day free trial"
                android:background="@drawable/bg_grad_gradient_start_gradient_end_315_r13sdp"
                android:elevation="@dimen/_3sdp"
                android:outlineSpotShadowColor="#523238F4"
                android:outlineAmbientShadowColor="#523238F4"
                android:textColor="@color/on_primary" />

            <TextView
                android:id="@+id/tvPriceNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:fontFamily="@font/nt_400"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_9sdp"
                tools:text="$0.00 today, then $29.99 / year from Oct 3, 2026" />

            <TextView
                android:id="@+id/tvLegal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:fontFamily="@font/nt_400"
                android:lineSpacingMultiplier="1.2"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_9sdp"
                tools:text="Your Google Play account will be charged…" />

            <com.ui.baselib.widget.flexbox.FlexboxLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                app:uiFlexWrap="wrap"
                app:uiJustifyContent="center">

                <TextView
                    android:id="@+id/btnRestore"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_25sdp"
                    android:background="?attr/selectableItemBackground"
                    android:fontFamily="@font/nt_500"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/_7sdp"
                    android:text="@string/restore_purchases"
                    android:textColor="@color/text_on_selected"
                    android:textSize="@dimen/_9sdp" />

                <TextView
                    android:id="@+id/btnManage"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_25sdp"
                    android:background="?attr/selectableItemBackground"
                    android:fontFamily="@font/nt_500"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/_7sdp"
                    android:text="@string/manage_subscription"
                    android:textColor="@color/text_on_selected"
                    android:textSize="@dimen/_9sdp" />

                <TextView
                    android:id="@+id/btnTerms"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_25sdp"
                    android:background="?attr/selectableItemBackground"
                    android:fontFamily="@font/nt_500"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/_7sdp"
                    android:text="@string/terms_of_use"
                    android:textColor="@color/text_on_selected"
                    android:textSize="@dimen/_9sdp" />

                <TextView
                    android:id="@+id/btnPrivacy"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_25sdp"
                    android:background="?attr/selectableItemBackground"
                    android:fontFamily="@font/nt_500"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/_7sdp"
                    android:text="@string/privacy_policy"
                    android:textColor="@color/text_on_selected"
                    android:textSize="@dimen/_9sdp" />
            </com.ui.baselib.widget.flexbox.FlexboxLayout>
        </LinearLayout>
    </LinearLayout>

</ScrollView>
