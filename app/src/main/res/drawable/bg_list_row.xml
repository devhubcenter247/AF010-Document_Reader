<?xml version="1.0" encoding="utf-8"?>
<!-- A row of a list drawn as one card: nothing of its own, a soft blue pill inside the card while picked
     (activated in multi-select, selected in the file picker). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <inset
            android:insetLeft="@dimen/_4sdp"
            android:insetTop="@dimen/_3sdp"
            android:insetRight="@dimen/_4sdp"
            android:insetBottom="@dimen/_3sdp">
            <shape android:shape="rectangle">
                <solid android:color="@color/color_row_picked" />
                <corners android:radius="@dimen/_13sdp" />
            </shape>
        </inset>
    </item>
    <item android:state_selected="true">
        <inset
            android:insetLeft="@dimen/_4sdp"
            android:insetTop="@dimen/_3sdp"
            android:insetRight="@dimen/_4sdp"
            android:insetBottom="@dimen/_3sdp">
            <shape android:shape="rectangle">
                <solid android:color="@color/color_row_picked" />
                <corners android:radius="@dimen/_13sdp" />
            </shape>
        </inset>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
