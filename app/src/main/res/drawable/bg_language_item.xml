<?xml version="1.0" encoding="utf-8"?>
<!-- The selected language gets a gradient border: the gradient card shows 1sdp around the plain one. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="0"
                        android:endColor="@color/gradient_end"
                        android:startColor="@color/gradient_start" />
                    <corners android:radius="@dimen/_10sdp" />
                </shape>
            </item>
            <item
                android:bottom="@dimen/_1sdp"
                android:left="@dimen/_1sdp"
                android:right="@dimen/_1sdp"
                android:top="@dimen/_1sdp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/color_surface_card" />
                    <corners android:radius="@dimen/_9sdp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:drawable="@drawable/bg_surface_card_r10sdp" />
</selector>
