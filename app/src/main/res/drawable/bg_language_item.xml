<?xml version="1.0" encoding="utf-8"?>
<!-- A language row: plain card, ringed in blue when picked. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/color_surface_card" />
            <corners android:radius="@dimen/_17sdp" />
            <stroke android:width="@dimen/_2sdp" android:color="@color/primary" />
        </shape>
    </item>
    <item android:drawable="@drawable/bg_card" />
</selector>
