<?xml version="1.0" encoding="utf-8"?>
<!-- A tool option: white card, or soft blue ringed in blue once picked (selected state). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/color_bg_selected" />
            <corners android:radius="@dimen/_10sdp" />
            <stroke android:width="@dimen/_2sdp" android:color="@color/primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/color_surface_card" />
            <corners android:radius="@dimen/_10sdp" />
        </shape>
    </item>
</selector>
