<?xml version="1.0" encoding="utf-8"?>
<!-- The shutter: a white ring around a light blue disc. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <stroke android:width="@dimen/_4sdp" android:color="@android:color/white" />
        </shape>
    </item>
    <item
        android:bottom="@dimen/_8sdp"
        android:left="@dimen/_8sdp"
        android:right="@dimen/_8sdp"
        android:top="@dimen/_8sdp">
        <shape android:shape="oval">
            <solid android:color="@color/ink_accent" />
        </shape>
    </item>
</layer-list>
