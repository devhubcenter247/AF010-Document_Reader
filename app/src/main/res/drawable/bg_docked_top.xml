<?xml version="1.0" encoding="utf-8"?>
<!-- A bar docked to the top of an edit screen: the card colour with a hairline on its bottom edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/color_stroke" />
        </shape>
    </item>
    <item android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/color_surface_card" />
        </shape>
    </item>
</layer-list>
