<?xml version="1.0" encoding="utf-8"?>
<!-- A text field's box; the ring turns blue while the field inside has focus
     (the box sets addStatesFromChildren). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/color_surface_card" />
            <corners android:radius="@dimen/_14sdp" />
            <stroke android:width="@dimen/_1sdp" android:color="@color/primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/color_surface_card" />
            <corners android:radius="@dimen/_14sdp" />
            <stroke android:width="@dimen/_1sdp" android:color="@color/color_stroke" />
        </shape>
    </item>
</selector>
