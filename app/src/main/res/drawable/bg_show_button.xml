<?xml version="1.0" encoding="utf-8"?>
<!-- A slideshow button: see-through dark (it sits over light and dark slides alike), light blue while its tool is on (selected state). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="oval">
            <solid android:color="@color/ink_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/show_glass" />
        </shape>
    </item>
</selector>
