<?xml version="1.0" encoding="utf-8"?>
<!-- A plan to pick: thin grey ring, blue fill and thick blue ring once picked. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/color_bg_selected" />
            <corners android:radius="@dimen/_17sdp" />
            <stroke android:width="@dimen/_2sdp" android:color="@color/primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/color_surface_card" />
            <corners android:radius="@dimen/_17sdp" />
            <stroke android:width="@dimen/_1sdp" android:color="@color/color_stroke" />
        </shape>
    </item>
</selector>
