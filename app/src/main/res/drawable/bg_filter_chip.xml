<?xml version="1.0" encoding="utf-8"?>
<!-- Filter chips: white with a hairline, solid ink when picked. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/color_ink" />
            <corners android:radius="@dimen/_15sdp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/color_surface_card" />
            <corners android:radius="@dimen/_15sdp" />
            <stroke android:width="@dimen/_1sdp" android:color="@color/color_stroke" />
        </shape>
    </item>
</selector>
