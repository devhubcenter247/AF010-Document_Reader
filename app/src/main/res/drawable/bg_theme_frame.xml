<?xml version="1.0" encoding="utf-8"?>
<!-- Ring around a theme preview in Settings: blue once picked, hairline otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/color_bg_selected" />
            <corners android:radius="@dimen/_13sdp" />
            <stroke android:width="@dimen/_2sdp" android:color="@color/primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/color_surface_variant" />
            <corners android:radius="@dimen/_13sdp" />
            <stroke android:width="@dimen/_1sdp" android:color="@color/color_stroke" />
        </shape>
    </item>
</selector>
