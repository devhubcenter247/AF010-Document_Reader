<?xml version="1.0" encoding="utf-8"?>
<!-- A dashed rule between rows; give the view a height of about 2sdp. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="line">
    <stroke
        android:width="@dimen/_1sdp"
        android:color="@color/color_stroke"
        android:dashGap="@dimen/_3sdp"
        android:dashWidth="@dimen/_4sdp" />
</shape>
