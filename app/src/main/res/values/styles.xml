<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="DialogAppStyle">
        <item name="android:fontFamily">@font/nunito_600</item>
        <item name="android:padding">@dimen/_7sdp</item>
    </style>

    <style name="ButtonAppStyle">
        <item name="android:layout_height">@dimen/_43sdp</item>
        <item name="android:textSize">@dimen/_12sdp</item>
        <item name="android:fontFamily">@font/nunito_800</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="TextHeadLine">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/_13sdp</item>
        <item name="fontFamily">@font/nunito_800</item>
    </style>

    <style name="TextSubContent">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/_9sdp</item>
        <item name="fontFamily">@font/nunito_600</item>
    </style>
    <!-- Tiêu đề lớn của tab: My files, Tools, Settings -->
    <style name="TextScreenTitle">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/_13sdp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:includeFontPadding">false</item>
        <item name="fontFamily">@font/nunito_800</item>
    </style>

    <style name="TextSectionTitle">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/_12sdp</item>
        <item name="fontFamily">@font/nunito_800</item>
    </style>

    <!-- Nhãn nhóm viết hoa: PREFERENCES, RECENT SEARCHES -->
    <style name="TextSectionCaps">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/_11sdp</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:textAllCaps">false</item>
        <item name="fontFamily">@font/nunito_700</item>
    </style>

    <style name="CardAppStyle">
        <item name="android:elevation">@dimen/_3sdp</item>
        <item name="android:outlineSpotShadowColor">@color/color_shadow</item>
        <item name="android:outlineAmbientShadowColor">@color/color_shadow</item>
    </style>

    <!-- Nút tròn 40 chứa icon: back, close, search -->
    <style name="IconButtonStyle">
        <item name="android:layout_width">@dimen/_27sdp</item>
        <item name="android:layout_height">@dimen/_27sdp</item>
        <item name="android:padding">@dimen/_5sdp</item>
    </style>

    <style name="ButtonOutlineStyle" parent="ButtonAppStyle">
    </style>

    <style name="BottomSheetAppStyle">
    </style>

    <!-- Dòng trong sheet / Settings: icon + nhãn -->
    <style name="RowLabelStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">@dimen/_10sdp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/_10sdp</item>
        <item name="fontFamily">@font/nunito_700</item>
    </style>

    <style name="SettingRowStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/_43sdp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingHorizontal">@dimen/_13sdp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <style name="SettingRowIconStyle">
        <item name="android:layout_width">@dimen/_28sdp</item>
        <item name="android:layout_height">@dimen/_28sdp</item>
        <item name="android:padding">@dimen/_6sdp</item>
    </style>

    <style name="RowChevronStyle">
        <item name="android:layout_width">@dimen/_13sdp</item>
        <item name="android:layout_height">@dimen/_13sdp</item>
        <item name="android:src">@drawable/ic_app_chev</item>
        <item name="tint">@color/color_icon_muted</item>
    </style>

    <!-- Nút PRO gradient ở góc header -->
    <style name="ProBadgeStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/_23sdp</item>
        <item name="android:drawablePadding">@dimen/_5sdp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">@dimen/_11sdp</item>
        <item name="android:text">@string/pro</item>
        <item name="android:textSize">@dimen/_10sdp</item>
        <item name="fontFamily">@font/nunito_800</item>
        <item name="drawableStartCompat">@drawable/ic_app_crown</item>
        <item name="drawableTint">@color/on_primary</item>
    </style>

    <!-- Nút trong thanh nổi tối trên trang PDF -->
    <style name="MarkupActionStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/_26sdp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">@dimen/_8sdp</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:textSize">@dimen/_9sdp</item>
        <item name="fontFamily">@font/nunito_700</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <!-- Nút icon + nhãn trong thanh dưới của trình đọc -->
    <style name="ReaderActionStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:drawablePadding">@dimen/_3sdp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingVertical">@dimen/_11sdp</item>
        <item name="android:textSize">@dimen/_9sdp</item>
        <item name="fontFamily">@font/nunito_700</item>
    </style>

    <!-- Folio: the main action, a 56px blue pill with a soft blue glow -->
    <style name="PrimaryPillButton">
        <item name="android:layout_height">@dimen/_43sdp</item>
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">@dimen/_17sdp</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:textSize">@dimen/_12sdp</item>
        <item name="android:fontFamily">@font/nunito_800</item>
        <item name="android:elevation">@dimen/_6sdp</item>
        <item name="android:outlineSpotShadowColor">@color/primary</item>
        <item name="android:outlineAmbientShadowColor">@color/primary</item>
    </style>

    <!-- Folio: a quiet text-only action under the main one ("Maybe later") -->
    <style name="GhostButton">
        <item name="android:layout_height">@dimen/_37sdp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">@dimen/_17sdp</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textSize">@dimen/_12sdp</item>
        <item name="android:fontFamily">@font/nunito_800</item>
    </style>

    <!-- Folio: big friendly screen titles (32px) -->
    <style name="DisplayTitle">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/_25sdp</item>
        <item name="android:fontFamily">@font/nunito_800</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:lineSpacingMultiplier">0.95</item>
    </style>

    <style name="DisplaySubtitle">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/_12sdp</item>
        <item name="android:fontFamily">@font/nunito_600</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <!-- Folio: the white floating card used for rows and options -->
    <style name="FloatingCard">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:elevation">@dimen/_3sdp</item>
        <item name="android:outlineSpotShadowColor">@color/color_shadow</item>
        <item name="android:outlineAmbientShadowColor">@color/color_shadow</item>
    </style>
</resources>
