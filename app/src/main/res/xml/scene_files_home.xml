<?xml version="1.0" encoding="utf-8"?>
<!-- Files tab (fragment_files.xml), split in two regions under a header that never moves: the top
     region (edit card to "Your documents") and the files opened lately (layoutRecent).
     Dragging up (HomeMotionLayout, no OnSwipe) hides the top region, pushes the list up under the
     header and brings in the Read and Create pills; dragging down at the top of the list brings it
     back. On release the motion finishes in the direction of a fling, or to the nearer state. -->
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <Transition
        android:id="@+id/collapse"
        app:constraintSetEnd="@id/collapsed"
        app:constraintSetStart="@id/expanded"
        app:duration="250">
        <KeyFrameSet>
            <!-- The pills come in over the last 40%, once the top region is mostly gone -->
            <KeyAttribute
                android:alpha="0"
                app:framePosition="60"
                app:motionTarget="@id/layoutPills" />
            <!-- The top region is faded out by the time it reaches the header -->
            <KeyAttribute
                android:alpha="0"
                app:framePosition="80"
                app:motionTarget="@id/layoutTop" />
        </KeyFrameSet>
    </Transition>

    <ConstraintSet android:id="@+id/expanded">
        <Constraint
            android:id="@id/headerHome"
            android:layout_width="0dp"
            android:layout_height="@dimen/_49sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Constraint
            android:id="@id/layoutTop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerHome">
            <PropertySet android:alpha="1" />
        </Constraint>

        <Constraint
            android:id="@id/layoutRecent"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutPills" />

        <Constraint
            android:id="@id/layoutPills"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerHome">
            <PropertySet android:alpha="0" />
            <Transform android:translationY="@dimen/_minus10sdp" />
        </Constraint>
    </ConstraintSet>

    <ConstraintSet
        android:id="@+id/collapsed"
        app:deriveConstraintsFrom="@id/expanded">
        <!-- Both regions keep their size and place in both states, so nothing is measured again while
             the motion runs: FilesFragment.placeRegions moves them by translation with the progress
             (the top region up behind the header, drawn above it; the list up under the pills).
             HomeMotionLayout moves the progress with the finger. -->
        <Constraint
            android:id="@id/layoutTop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerHome">
            <!-- Invisible at the end, so it takes no taps from behind the header -->
            <PropertySet
                android:alpha="0"
                android:visibility="invisible" />
        </Constraint>

        <Constraint
            android:id="@id/layoutRecent"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutPills" />

        <Constraint
            android:id="@id/layoutPills"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerHome">
            <PropertySet android:alpha="1" />
            <Transform android:translationY="0dp" />
        </Constraint>
    </ConstraintSet>
</MotionScene>
