<?xml version="1.0" encoding="utf-8"?>
<!-- Files tab (fragment_files.xml): the header never moves and the content scrolls under it. As
     the Read and Create cards scroll away, two pills slide in under the header. FilesFragment
     drives the progress from the scroll position (no OnSwipe: it fought the scroll on flings). -->
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <Transition
        android:id="@+id/collapse"
        app:constraintSetEnd="@id/collapsed"
        app:constraintSetStart="@id/expanded" />

    <ConstraintSet android:id="@+id/expanded">
        <Constraint
            android:id="@id/headerHome"
            android:layout_width="0dp"
            android:layout_height="@dimen/_49sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Constraint
            android:id="@id/scroll"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerHome" />

        <Constraint
            android:id="@id/layoutPills"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerHome">
            <PropertySet android:alpha="0" />
            <Transform android:translationY="@dimen/_minus10sdp" />
        </Constraint>
    </ConstraintSet>

    <ConstraintSet
        android:id="@+id/collapsed"
        app:deriveConstraintsFrom="@id/expanded">
        <Constraint
            android:id="@id/layoutPills"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerHome">
            <PropertySet android:alpha="1" />
            <Transform android:translationY="0dp" />
        </Constraint>
    </ConstraintSet>
</MotionScene>
